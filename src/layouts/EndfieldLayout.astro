---
import BootScreen from "@components/common/BootScreen.astro";
import EfHeader from "@components/common/EfHeader.astro";
import "@/styles/endfield-shell.css";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	skipBreadcrumbStructuredData?: boolean;
	/* 文章页会透传这些，新壳只用到其中一部分，其余接收后忽略即可 */
	postCategory?: string;
	headings?: import("astro").MarkdownHeading[];
	encrypted?: boolean;
	heading?: string;
	hasWallpaper?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
	skipBreadcrumbStructuredData,
	hasWallpaper,
} = Astro.props;

const path = Astro.url.pathname;
const on = (p: string) => (p === "/" ? path === "/" : path.startsWith(p));

// 左侧竖排图标栏（官网 operator 页那条）。图标全部是自绘几何线框，不含任何游戏素材。
const rail = [
	{ href: "/", label: "首页", d: "M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" },
	{ href: "/archive/", label: "文章", d: "M4 5h16M4 12h16M4 19h10" },
	{ href: "/categories/", label: "分类", d: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" },
	{ href: "/tags/", label: "标签", d: "M3 12l9-9h8v8l-9 9z M15 8h.01" },
	{ href: "/series/", label: "系列", d: "M12 3l9 5-9 5-9-5zM3 14l9 5 9-5" },
	{ href: "/friends/", label: "友链", d: "M9 15l6-6M8 12l-2 2a3 3 0 0 0 4 4l2-2M16 12l2-2a3 3 0 0 0-4-4l-2 2" },
	{ href: "/about/", label: "关于", d: "M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM5 20a7 7 0 0 1 14 0" },
];
---

<Layout
	title={title}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
	postCoverImage={postCoverImage}
	ogImageWidth={ogImageWidth}
	ogImageHeight={ogImageHeight}
	ogImageAlt={ogImageAlt}
	skipBreadcrumbStructuredData={skipBreadcrumbStructuredData}
	hasWallpaper={hasWallpaper}
>
	<slot slot="head" name="head" />
	<BootScreen />
	<EfHeader />

	<nav class="ef-rail" aria-label="主导航">
		<a class="ef-rail-brand" href="/" aria-label="LegspCpd BLOG"><span>终</span></a>
		<ul class="ef-rail-list">
			{rail.map((item) => (
				<li>
					<a class={"ef-rail-item" + (on(item.href) ? " is-on" : "")} href={item.href} aria-label={item.label} title={item.label}>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter">
							<path d={item.d} />
						</svg>
					</a>
				</li>
			))}
		</ul>
	</nav>

	<main id="ef-main" class="ef-shell-main">
		<div class="ef-wrap">
			<slot />
		</div>
	</main>

	<footer class="ef-shell-foot">
		<div class="ef-wrap ef-shell-foot-inner">
			<p class="ef-shell-mark">LegspCpd<span>// BLOG</span></p>
			<ul class="ef-shell-links">
				<li><a href="/archive/">文章</a></li>
				<li><a href="/categories/">分类</a></li>
				<li><a href="/tags/">标签</a></li>
				<li><a href="/series/">系列</a></li>
				<li><a href="/about/">关于</a></li>
			</ul>
			<p class="ef-shell-meta">&copy; {new Date().getFullYear()} LegspCpd</p>
		</div>
	</footer>
</Layout>
