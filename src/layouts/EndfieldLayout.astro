---

<Layout
	title={title}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
	postCoverImage={postCoverImage}
	ogImageWidth={ogImageWidth}
	ogImageHeight={ogImageHeight}
	ogImageAlt={ogImageAlt}
	skipBreadcrumbStructuredData={skipBreadcrumbStructuredData}
	hasWallpaper={hasWallpaper}
>
	<Fragment slot="head">
		<slot name="head" />
		<!-- 全站只有浅色一种基调：清掉 localStorage 里遗留的 dark（否则 Waline/Giscus/
		     代码高亮这些第三方件会跟着走暗色，和浅色外壳撞在一起）。不写回 localStorage。 -->
		<script is:inline>
			(function () {
				var de = document.documentElement;
				de.style.colorScheme = "light";
				if (!de.classList.contains("dark")) return;
				de.classList.remove("dark");
				var t = window.__ffTheme;
				if (t && t.light) de.setAttribute("data-theme", t.light);
			})();
		</script>
	</Fragment>
	<div class="ef-shell" data-ef-shell>
		<!-- astro.config.mjs 里 swup 声明了四个 containers，其中 banner / TOC 三个属于
		     主题网格布局；本站外壳没有它们，swup 会报 "Container mismatch, aborting"
		     并退回整站重载。留三只空壳对位（在本站永远是空的），换取站内跳转不刷新。 -->
		<div id="banner-overlay-container"></div>
		<div id="banner-dim-container"></div>
		<div id="floating-toc-wrapper"></div>

		<BootScreen />

		<!-- 官网左侧竖排栏：位置/尺寸/配色/交互照 Header_pcHeaderContainer 搬用 -->
		<aside
			class="Header_pcHeaderContainer__Sy_8l"
			data-ef-rail
			aria-label="站点导航"
		>
			<div class="Header_innerContainer__cW_Dv">
				<a class="Header_logo__s3lE_" href="/" aria-label="LegspCpd BLOG 首页">
					<span class="ef-rail-wordmark">LegspCpd</span>
					<span class="ef-rail-wordmark-en">BLOG</span>
				</a>

				<nav class="Header_navList__r2BGN">
					{
						rail.map((item) => (
							<a
								class:list={[
									"Header_navItem__c_fLB",
									{ Header_active__jzCyf: on(item.href) },
								]}
								href={item.href}
								data-key={item.key}
								aria-current={on(item.href) ? "page" : undefined}
							>
								{/* 当前页灰块：照官网 .Header_overlay__33Sha 做成**真实子节点**。
									包含块就是本导航项，所以只会精确贴住当前那一项；它又是本项的第一个
									子节点，图标与文字排在它之后，任何情况下都压不住内容。 */}
								<span class="Header_overlay__33Sha" aria-hidden="true" />
								<svg
									class="Header_icon__3iDIG"
									viewBox={icons[item.key].vb}
									xmlns="http://www.w3.org/2000/svg"
									aria-hidden="true"
								>
									<path fill-rule="evenodd" fill="currentColor" d={icons[item.key].d} />
								</svg>
								<span class="Header_textWrapper__o9aHt">{item.label}</span>
							</a>
						))
					}
				</nav>

				<div class="ef-rail-bottom">
					<!-- 第一组：竖向胶囊（留言 / 订阅 / 邮箱）—— 图标居中、三行紧挨着 -->
					<div class="ef-rail-menu">
						{
							railFoot.map((item) => (
								<a class="ef-rail-menu-row" href={item.href} aria-label={item.label}>
									<svg
										class="ef-rail-menu-icon"
										viewBox={item.vb}
										xmlns="http://www.w3.org/2000/svg"
										aria-hidden="true"
									>
										<path fill-rule="evenodd" fill="currentColor" d={item.d} />
									</svg>
									<span class="ef-rail-menu-label">{item.label}</span>
								</a>
							))
						}
					</div>

					<!-- 第二组：竖向黑方块（4.5u × 9.75u，水平居中）—— 白三角 + 短白线 + 白字 -->
					<a class="ef-rail-cta" href="/archive/" aria-label="全部文章">
						<svg
							class="ef-rail-cta-tri"
							viewBox="0 0 31 28"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path fill-rule="evenodd" fill="currentColor" d={triPath} />
						</svg>
						<span class="ef-rail-cta-line" />
						<span class="ef-rail-cta-text">全部文章</span>
					</a>

					<!-- 第三组：3u × 3u 圆角小方块（官网 .Header_buttonShareBg 的位置）——「前往」图标 -->
					<a
						class="ef-rail-jump"
						href="https://github.com/legspcpd"
						aria-label="GitHub"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg
							class="ef-rail-jump-icon"
							viewBox="0 0 32 20"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path fill-rule="evenodd" fill="currentColor" d={jumpPath} />
						</svg>
					</a>

					<!-- 第四组：极小的品牌标记（官网那里是一枚极小的图形 logo） -->
					<p class="ef-rail-mark">
						<span class="ef-rail-mark-brand">LEGSPCPD</span>
						<span class="ef-rail-mark-ver">// BLOG &copy; {year}</span>
					</p>
				</div>
			</div>
		</aside>

		<!-- swup 容器：必须存在且包住 main，否则站内跳转会整站重载 -->
		<div id="swup-container">
			<main id="ef-main" class="ef-shell-main">
				<slot />

				<footer class="ef-foot">
					<div class="ef-wrap ef-foot-inner">
						<p class="ef-foot-mark">LegspCpd<span>// BLOG</span></p>
						<ul class="ef-foot-links">
							<li><a href="/archive/">文章</a></li>
							<li><a href="/categories/">分类</a></li>
							<li><a href="/tags/">标签</a></li>
							<li><a href="/series/">系列</a></li>
							<li><a href="/friends/">友链</a></li>
							<li><a href="/about/">关于</a></li>
							<li>
								<a href="https://x.com/legspcpd" target="_blank" rel="noopener noreferrer">X</a>
							</li>
						</ul>
						<p class="ef-foot-meta">&copy; {year} LegspCpd</p>
					</div>
				</footer>
			</main>
		</div>
	</div>
</Layout>

<script is:inline>
	// 竖排栏在 swup 容器之外、切页不会重建：手动同步「当前页」高亮。
	(function () {
		function sync() {
			var path = location.pathname.replace(/\/+$/, "") || "/";
			var isHome = path === "/";
			var links = document.querySelectorAll("[data-ef-rail] .Header_navItem__c_fLB");
			for (var i = 0; i < links.length; i++) {
				var href = (links[i].getAttribute("href") || "").replace(/\/+$/, "") || "/";
				var hit = href === "/" ? isHome : path === href || path.indexOf(href + "/") === 0;
				links[i].classList.toggle("Header_active__jzCyf", hit);
				if (hit) links[i].setAttribute("aria-current", "page");
				else links[i].removeAttribute("aria-current");
			}
		}
		sync();
		document.addEventListener("swup:page:view", function () {
			setTimeout(sync, 0);
		});
	})();
</script>
