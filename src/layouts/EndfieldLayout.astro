//   —— fixed 顶天立地、默认收起只见图标、悬停展开出文字（官网同名类名）。
//   图标 SVG 从官网 index.html 里逐个抠出（data-key 同名），不是自绘。
//   内容区：官网版心 + SectionTitle 量级；全站浅色（纸 #f2f2f2 / 墨 #191919），
//   唯一的暗色是加载屏 BootScreen（官网上屏就是 #141414）。
//   站内跳转：main 必须包在 #swup-container 里（astro.config.mjs 的 swup containers
//   依赖它），否则切换页面会整站重载。
import BootScreen from "@components/common/BootScreen.astro";
import "@/styles/endfield-shell.css";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	skipBreadcrumbStructuredData?: boolean;
	/* 文章页会透传这些，新壳只用到其中一部分，其余接收后忽略即可 */
	postCategory?: string;
	headings?: import("astro").MarkdownHeading[];
	encrypted?: boolean;
	heading?: string;
	hasWallpaper?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

