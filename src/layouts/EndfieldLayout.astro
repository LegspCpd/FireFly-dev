	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
	skipBreadcrumbStructuredData,
	hasWallpaper,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = path === "/";
const on = (p: string) => (p === "/" ? isHome : path === p || path.startsWith(p + "/"));

