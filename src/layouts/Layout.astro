---
import GoogleAdsense from "@components/analytics/GoogleAdsense.astro";
import GoogleAnalytics from "@components/analytics/GoogleAnalytics.astro";
import La51Analytics from "@components/analytics/La51Analytics.astro";
import MicrosoftClarity from "@components/analytics/MicrosoftClarity.astro";
import UmamiAnalytics from "@components/analytics/UmamiAnalytics.astro";
import CodeGroupManager from "@components/features/CodeGroupManager.astro";
import FancyboxManager from "@components/features/FancyboxManager.astro";
import FontSetup from "@components/features/FontSetup.astro";
import GithubCardManager from "@components/features/GithubCardManager.astro";
import MusicManager from "@components/features/MusicManager.astro";
import MusicPlayerView from "@components/features/MusicPlayerView.astro";
import SakuraEffect from "@components/features/SakuraEffect.astro";
import WavesEffect from "@components/features/WavesEffect.astro";
import ConfigCarrier from "@components/layout/ConfigCarrier.astro";

import {
	analyticsConfig,
	backgroundWallpaper,
	displaySettingsConfig,
	expressiveCodeConfig,
	musicPlayerConfig,
	navbarMode,
	profileConfig,
	siteConfig,
} from "@/config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_NON_HOME,
	BANNER_HEIGHT_NON_HOME_MIN,
	PAGE_WIDTH,
} from "@/constants/constants";
import { defaultFavicons } from "@/constants/icon";
import { getHreflangTags } from "@/lib/seo/hreflang";
// 本地定制：SEO 结构化数据 / hreflang / 路由索引策略
import { getBreadcrumbStructuredData } from "@/lib/seo/json-ld";
import { resolveRouteMeta } from "@/lib/seo/route-meta";
import type { Favicon } from "@/types/config";
import { isHomePage } from "@/utils/layout-utils";
import { getAuthorAvatarUrl, getSiteLogo } from "@/utils/schema-image";
import { buildSiteGraph, toAbsoluteUrl } from "@/utils/schema-utils";
import { getOgLocale } from "@/utils/site-config-utils";
import { getCanonicalUrl, url } from "@/utils/url-utils";

import "@/styles/main.css";
import "@/styles/immersive-reading.css";
import "@/styles/variables.styl";
import "@rehype-callouts-theme";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	hasWallpaper?: boolean;
	// 页面自身已在 JSON-LD 里输出 BreadcrumbList 时置 true，避免重复注入
	skipBreadcrumbStructuredData?: boolean;
}

let {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth: propsOgImageWidth,
	ogImageHeight: propsOgImageHeight,
	ogImageAlt: propsOgImageAlt,
	hasWallpaper = false,
	skipBreadcrumbStructuredData = false,
} = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePageCheck = isHomePage(Astro.url.pathname);

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;

// 获取导航栏透明模式配置（banner 模式专属）
const navbarTransparentMode =
	backgroundWallpaper.banner?.navbar?.transparentMode || "semi";
// 判断是否应该显示顶部高光效果（只在 semifull 动态透明模式下显示）
const shouldShowTopHighlight = navbarTransparentMode === "semifull";

// 全屏壁纸布局：classic 为文档流旧版，hero 为固定首屏新版
const fullscreenLayout = backgroundWallpaper.fullscreen?.layout ?? "classic";

// 子菜单 / 浮动面板的毛玻璃模糊度：跟随 navbar.blur，但不受壁纸模式影响，
// 且带一个最小值 —— 导航栏可以用 blur: 0 关掉毛玻璃，面板则始终保留毛玻璃。
// 之所以不复用 #navbar 上的 --navbar-glass-blur：
// setting-utils.ts 的 updateNavbarTransparency() 会在切到 overlay / none 模式时
// 把它清成 0px；这里放到 :root 上，同时也能让不在导航栏 DOM 内的
// .float-panel（#translate-panel、#mobile-toc-panel）继承到。
const NAVBAR_PANEL_MIN_BLUR = 2;
const navbarPanelBlur = Math.max(
	backgroundWallpaper.banner?.navbar?.blur ?? 20,
	NAVBAR_PANEL_MIN_BLUR,
);

let pageTitle: string;
if (title) {
	pageTitle = `${title} | ${siteConfig.title}`;
} else {
	// 站点标题与副标题相同时不要重复拼接，否则搜索结果标题会出现「X | X」
	const subtitleText = siteConfig.subtitle?.trim();
	pageTitle =
		subtitleText && subtitleText !== siteConfig.title
			? siteConfig.title + " | " + subtitleText
			: siteConfig.title;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
// apple-touch-icon：iOS 添加到主屏要 180×180。原来取的是「favicon 里第一个 png」，
// 而 siteConfig.favicon 的第一个 png 是 /favicon-32.png（32px），标签因此指向了 32px 图。
// 现在按「名字 → 尺寸 → 任意 png」三级挑，挑不到才退回第一个条目。
const appleTouchIcon =
	favicons.find((f) => f.src.toLowerCase().includes("apple-touch-icon")) ??
	favicons.find((f) => f.src.toLowerCase().endsWith(".png") && f.sizes === "180x180") ??
	favicons.find((f) => f.src.toLowerCase().endsWith(".png")) ??
	favicons[0];

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

// 首页站点级结构化数据用的作者头像 URL（Person.image），经 toAbsoluteImageUrl 三分解析
const avatarUrl = await getAuthorAvatarUrl();
// 作者个人页（/about/）绝对 URL，作为 Person.url
const aboutUrl =
	toAbsoluteUrl("/about/", siteConfig.site_url) ?? siteConfig.site_url;
// 站点 publisher logo（Organization.logo），用于首页 @graph 的 Organization 节点
const siteLogo = await getSiteLogo();

// canonical：对 /archive/ 与 /search/ 剥离查询串，避免筛选视图自我 canonical 到 ?tag= 等
const canonicalUrl = getCanonicalUrl(Astro.url);

// ========== SEO（本地定制）：hreflang / 路由索引策略 / 面包屑结构化数据 ==========
const hreflangTags = getHreflangTags(canonicalUrl);
const routeMeta = resolveRouteMeta(Astro.url.pathname);
const breadcrumbStructuredData = getBreadcrumbStructuredData(
	Astro.url.pathname,
);

// ========== 本地定制：DNS 预取 / 预连接（提升外部资源加载性能） ==========
const toExternalOrigin = (value?: string): string | null => {
	if (!value) return null;
	try {
		return new URL(value).origin;
	} catch {
		return null;
	}
};
const connectionHintOrigins = Array.from(
	new Set(
		[
			...(analyticsConfig?.googleAnalyticsId
				? [
						"https://www.googletagmanager.com",
						"https://www.google-analytics.com",
					]
				: []),
			...(analyticsConfig?.googleAdsenseClientId
				? [
						"https://pagead2.googlesyndication.com",
						"https://googleads.g.doubleclick.net",
					]
				: []),
			...(analyticsConfig?.microsoftClarityId
				? ["https://www.clarity.ms"]
				: []),
			analyticsConfig?.umamiAnalytics?.websiteId
				? toExternalOrigin(analyticsConfig.umamiAnalytics.scriptUrl)
				: null,
			analyticsConfig?.la51Analytics?.Id
				? toExternalOrigin(
						analyticsConfig.la51Analytics.sdkUrl ||
							"https://sdk.51.la/js-sdk-pro.min.js",
					)
				: null,
		].filter((origin): origin is string => Boolean(origin)),
	),
);

// OG 图片：文章走生成图/封面，非文章页回退到站点 logo
let ogImageUrl: string | undefined;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;
const isGeneratedOg = siteConfig.post.generateOgImages && postSlug;
if (isGeneratedOg) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
	ogImageWidth = 1200;
	ogImageHeight = 630;
} else if (postCoverImage) {
	ogImageUrl = postCoverImage; // 已由文章页算成绝对 URL
	ogImageWidth = propsOgImageWidth;
	ogImageHeight = propsOgImageHeight;
} else if (siteConfig.defaultOgImage) {
	// 站点级兜底图优先于导航栏 logo：logo 多为小尺寸图标，
	// 直接当 og:image 会让分享卡片退化成小图
	ogImageUrl = new URL(siteConfig.defaultOgImage, Astro.site).toString();
} else if (siteLogo?.url) {
	ogImageUrl = siteLogo.url;
	ogImageWidth = siteLogo.width;
	ogImageHeight = siteLogo.height;
}
const ogImageAlt = propsOgImageAlt ?? pageTitle;

// 使用固定的banner偏移量，position配置用于图片定位
---

<!doctype html>
{/* 终末地风味（endfield-ui）变体卡 —— 只在这里设置一次：
      变体：standard（yellow / neutral / standard / contours / standard / full）
      主视觉：站点字标 + 文章记录行（替换模板里的 ACME 字标与木箱线稿）
      页面类型：首页展示，其余阅读
      token 映射写在 src/styles/variables.styl 末尾（--primary 映射为墨色，
      强调色 #FFFA00 只做填充 —— skill 规定浅色主题里黄不能当线或字）。 */}
<html lang={siteLang} data-ef-variant="standard" class="bg-(--page-bg) text-[14px] md:text-[16px]" data-wallpaper-mode={backgroundWallpaper.mode} data-fullscreen-layout={fullscreenLayout} data-has-wallpaper={hasWallpaper ? "" : undefined} data-tag-style={siteConfig.tagStyle ?? "pill"} data-category-style={siteConfig.categoryStyle ?? "rectangle"}>
  <head>
    <meta charset="UTF-8" />
    {/* endfield-ui 套件：部件类名与 --ef-* 变量（见 public/endfield-ui/） */}
    <link rel="stylesheet" href="/endfield-ui/endfield.css" />
    <script is:inline src="/endfield-ui/variant.js"></script>
    {/* 套件的 fx.js 是 ES module（整份只有 export，没有副作用），
        以 classic script 加载会在 fx.js:34 抛 SyntaxError（Unexpected token 'export'），
        而且它本来也不会自己跑 —— 必须有人在 module 里 import 后调用。
        所以这一处要做两件事：① 用 type="module" 加载，语法才成立；
        ② 紧接着的引导脚本 import 进来并接线（只加 type 只是「不报错」，不是「有效果」）。
        只接「读数落定」：data-fx-load / data-fx-host 是套件 fx.js 顶注里写明的
        自动接线入口，站点没有这些标记时零副作用。
        wireTheme 不接 —— 主题由本站自己的主题脚本管，接了就是两个 owner；
        wireDialogs 不接 —— 它按 [data-open] 找对话框，而系列页 / SeriesNav
        已经把这个属性当布尔状态用（[data-open="true"]），语义会打架。 */}
    <script is:inline type="module" src="/endfield-ui/fx.js"></script>
    <script is:inline type="module">
      import { wireReadouts } from "/endfield-ui/fx.js";
      function boot() { wireReadouts(document); }
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
      else boot();
      // 站内跳转（swup）后新挂载的内容也要接线；与下面入场动效用同一个事件
      document.addEventListener("swup:page:view", boot);
    </script>
    <!-- 入场动效运行时。动画类一律来自套件预设（不受这里影响）：
           ef-in-power / ef-in-come / ef-in-drive / ef-in-sweep ...
         这里只补套件没有的两件事：
           1) replay —— 把 data-replay 里的类摘掉 -> 强制回流 -> 加回去
              （实现照搬套件 templates/motion.html，套件的 fx.js 并不含它）。
              没有它，入场动画只在首次渲染跑一次，站内跳转（swup）后不会重跑。
           2) 触发 —— 套件只有「开页即播」，长页面下半部分在播完后才被看到，
              等于没有动效。因此改为：进入视口时才挂类。
              对无法在 markup 上标注的内容生成元素（markdown 的 h2/h3 等）走 AUTO 列表。
         套件预设本身包在 prefers-reduced-motion: no-preference 里，尊重系统设置。 -->
    <script is:inline>
      (function () {
        // [选择器, 套件预设类, 是否按序号错开 --i]
        var AUTO = [
          // 注意用后代选择器：markdown 的 h2/h3 外面还有一层无类名的包裹，
          // 实测 .custom-md > h2 匹配 0 个、.custom-md h2 匹配 36 个。
          [".custom-md h2, .custom-md h3", "ef-in-power", true],
          [".custom-md figure, .custom-md img", "ef-in-come", true],
          // 正文里的代码块/表格/引用
          [".custom-md pre, .custom-md table, .custom-md blockquote", "ef-in-come", true],
          // 空状态
          [".ef-empty", "ef-in-power", false],
          // 卡片本体不能挂：.card-base 的切角是 clip-path，套件预设的关键帧也写 clip-path，
          // fill-mode: both 会永久覆盖切角。改用它的子元素（子元素没有裁剪）。
          [".card-base > :not(.ef-tri)", "ef-in-power", false],
          [".ef-ledger > li, .ef-page-list > li", "ef-in-come", true],
          [".archive-year-block", "ef-in-power", true],
          // 目录与翻页
          [".immersive-toc, .floating-toc-wrapper", "ef-in-power", false],
          [".responsive-pagination, .desktop-pagination, .mobile-pagination", "ef-in-come", true],
          // 页脚：用元素选择器，不依赖类名（真正的页脚是 components/layout/Footer.astro，
          // 先前的 "footer .ef-footer" 类名并不存在，等于空转）
          ["footer", "ef-in-power", false]
        ];
        function play(el) {
          var cls = el.getAttribute("data-replay");
          if (!cls) return;
          // 保险一：文档隐藏时不要挂入场类。套件预设用 animation-fill-mode: backwards，
          // 动画开始前元素停在 from（opacity:0）那一帧；后台标签页里动画被暂停，
          // 就会永久停在不可见状态 —— 站主实测首页主视觉整块消失就是这个原因。
          if (document.hidden) return;
          el.classList.remove(cls);
          void el.offsetWidth;
          el.classList.add(cls);
          // 保险二：动画若没有真的跑起来（被节流/暂停），把类摘掉回落到自然状态（完全可见）。
          setTimeout(function () {
            var anims = el.getAnimations ? el.getAnimations() : [];
            var ran = anims.some(function (a) {
              return a.playState === "running" || a.playState === "finished";
            });
            if (!ran) el.classList.remove(cls);
          }, 1400);
        }
        function replay(root) {
          (root || document).querySelectorAll("[data-replay]").forEach(play);
        }
        var io = "IntersectionObserver" in window
          ? new IntersectionObserver(function (entries) {
              entries.forEach(function (en) {
                if (!en.isIntersecting) return;
                io.unobserve(en.target);
                play(en.target);
              });
            }, { rootMargin: "0px 0px -6% 0px", threshold: 0.05 })
          : null;

        var observed = 0;
        function boot(root) {
          replay(root);
          AUTO.forEach(function (spec) {
            (root || document).querySelectorAll(spec[0]).forEach(function (el, i) {
              if (el.hasAttribute("data-replay")) return; // markup 上已标注的由上一行处理
              el.setAttribute("data-replay", spec[1]);
              if (spec[2]) el.style.setProperty("--i", String(i % 8));
              // 首屏内立即播（getBoundingClientRect，不依赖 IntersectionObserver，
              // 因为隐藏文档不投递 IO 回调）；首屏外交给观察器，滚到才播。
              var r = el.getBoundingClientRect();
              var inView = r.top < (window.innerHeight || 0) && r.bottom > 0;
              if (inView || !io) play(el);
              else { io.observe(el); observed++; }
            });
          });
        }
        window.__efReplay = replay;
        window.__efMotion = function () { return { observed: observed, auto: AUTO.length }; };
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", function () { boot(document); });
        else boot(document);
        document.addEventListener("swup:page:view", function () { boot(document); });
        // 从后台切回前台时，把之前跳过的补齐
        document.addEventListener("visibilitychange", function () {
          if (!document.hidden) replay(document);
        });
      })();
    </script>
    <style is:inline>
			@layer properties, theme, base, components, utilities;
		</style>
    {analyticsConfig?.googleAnalyticsId && (
            <GoogleAnalytics analyticsId={analyticsConfig.googleAnalyticsId} />
    )}
    {analyticsConfig?.googleAdsenseClientId && (
            <GoogleAdsense clientId={analyticsConfig.googleAdsenseClientId} />
    )}
    {analyticsConfig?.microsoftClarityId && (
            <MicrosoftClarity clarityId={analyticsConfig.microsoftClarityId} />
    )}
        {analyticsConfig?.umamiAnalytics?.websiteId && (
          <UmamiAnalytics
          websiteId={analyticsConfig.umamiAnalytics.websiteId}
          scriptUrl={analyticsConfig.umamiAnalytics.scriptUrl}
          replaysScriptUrl={analyticsConfig.umamiAnalytics.replaysScriptUrl}
          trackOutboundLinks={analyticsConfig.umamiAnalytics.trackOutboundLinks}
          collectWebVitals={analyticsConfig.umamiAnalytics.collectWebVitals}
          replays={analyticsConfig.umamiAnalytics.replays}
          />
        )}
        {analyticsConfig?.la51Analytics?.Id && (
            <La51Analytics
            analyticsId={analyticsConfig.la51Analytics.Id}
            sdkUrl={analyticsConfig.la51Analytics?.sdkUrl}
            ck={analyticsConfig.la51Analytics?.ck}
            autoTrack={analyticsConfig.la51Analytics?.autoTrack}
            hashMode={analyticsConfig.la51Analytics?.hashMode}
            screenRecord={analyticsConfig.la51Analytics?.screenRecord}
            />
    )}

    <!-- ========== 本地定制：DNS 预取与预连接 ========== -->
    {connectionHintOrigins.map((origin) => (
      <>
        <link rel="dns-prefetch" href={origin} />
        <link rel="preconnect" href={origin} crossorigin="anonymous" />
      </>
    ))}
    <link rel="dns-prefetch" href={new URL(siteConfig.site_url).origin} />
    <link rel="preconnect" href={new URL(siteConfig.site_url).origin} />

    <title>{pageTitle}</title>
    <meta
      name="description"
      content={description || siteConfig.description || pageTitle}
    />
    {
      siteConfig.keywords && siteConfig.keywords.length > 0 && (
        <meta name="keywords" content={siteConfig.keywords.join(", ")} />
      )
    }
    <meta name="author" content={profileConfig.name} />

    {
      siteConfig.webmasterVerification?.bing && (
        <meta name="msvalidate.01" content={siteConfig.webmasterVerification.bing} />
      )
    }
    {
      siteConfig.webmasterVerification?.google && (
        <meta name="google-site-verification" content={siteConfig.webmasterVerification.google} />
      )
    }
    {
      siteConfig.webmasterVerification?.baidu && (
        <meta name="baidu-site-verification" content={siteConfig.webmasterVerification.baidu} />
      )
    }
    {
      siteConfig.webmasterVerification?.yandex && (
        <meta name="yandex-verification" content={siteConfig.webmasterVerification.yandex} />
      )
    }

    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content={getOgLocale(lang)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description || siteConfig.description || pageTitle}
    />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageUrl && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {
      setOGTypeArticle ? (
        <meta property="og:type" content="article" />
      ) : (
        <meta property="og:type" content="website" />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={description || siteConfig.description || pageTitle}
    />

    {
      isHomePageCheck && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(
            buildSiteGraph({
              site: siteConfig.site_url,
              siteConfig,
              profileConfig,
              lang: siteLang,
              authorUrl: aboutUrl,
              avatarUrl,
              logo: siteLogo,
            }),
          )}
        />
      )
    }

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={`hsl(${siteConfig.themeColor.hue} 90% 60%)`} />
    {
      favicons.map((favicon) => (
        <link
          rel="icon"
          href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
          sizes={favicon.sizes}
          media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
        />
      ))
    }
    {appleTouchIcon && (
      <link
        rel="apple-touch-icon"
        href={appleTouchIcon.src.startsWith("/") ? url(appleTouchIcon.src) : appleTouchIcon.src}
        type="image/png"
        sizes={appleTouchIcon.sizes}
      />
    )}

    <!-- 为特定域名的图片添加 referrerpolicy 以解决 403 问题 -->
    <!-- 注：静态图片（ImageWrapper 组件、Markdown 正文图）已在构建期加好 referrerpolicy；
         此脚本仅作为运行时兜底，处理动态注入的图片（解密内容、第三方评论/统计部件等）。 -->
    {siteConfig.imageOptimization?.noReferrerDomains &&
     siteConfig.imageOptimization.noReferrerDomains.length > 0 && (
      <script
        is:inline
        define:vars={{
          noReferrerDomains: JSON.stringify(
            siteConfig.imageOptimization.noReferrerDomains
          ),
        }}
      >
        (function() {
          const domains = JSON.parse(noReferrerDomains);

          // 域名匹配函数，支持通配符
          function matchesDomain(urlStr, patterns) {
            try {
              const urlObj = new URL(urlStr);
              const hostname = urlObj.hostname;

              return patterns.some(function(pattern) {
                const regexPattern = pattern.replace(/\./g, '\\.').replace(/\*/g, '.*');
                const regex = new RegExp('^' + regexPattern + '$');
                return regex.test(hostname);
              });
            } catch (e) {
              return false;
            }
          }

          // 处理单个图片元素
          function processImage(img) {
            if (!img.src || img.hasAttribute('referrerpolicy')) return;

            if (matchesDomain(img.src, domains)) {
              img.setAttribute('referrerpolicy', 'no-referrer');
            }
          }

          // 兜底扫描一次当前页面（构建期已处理的图片会因已有属性而快速跳过）
          document.querySelectorAll('img').forEach(processImage);

          // 使用 MutationObserver 监听动态加载/注入的图片
          const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
              mutation.addedNodes.forEach(function(node) {
                if (node.nodeName === 'IMG') {
                  processImage(node);
                }
                if (node.querySelectorAll) {
                  node.querySelectorAll('img').forEach(processImage);
                }
              });
            });
          });

          observer.observe(document.documentElement, {
            childList: true,
            subtree: true
          });
        })();
      </script>
    )}

    <!-- Set the theme before the page is rendered to avoid a flash -->
    <script
      is:inline
      define:vars={{
        PAGE_WIDTH,
        configHue,
        defaultMode: siteConfig.themeColor.defaultMode ?? "light",
        defaultWallpaperMode: backgroundWallpaper.mode,
        isWallpaperSwitchable:
          displaySettingsConfig.wallpaperModeSwitchable,
        isFullscreenLayoutSwitchable:
          displaySettingsConfig.fullscreenLayoutSwitchable,
        darkTheme: expressiveCodeConfig.darkTheme,
        lightTheme: expressiveCodeConfig.lightTheme,
        baseUrl: import.meta.env.BASE_URL,
        cardTransparentOpacity: backgroundWallpaper.overlay?.cardOpacity ?? 0.6,
        fullscreenLayout,
      }}
    >
      // 主题初始化 - 与setting-utils.ts保持一致
      const LIGHT_MODE = "light";
      const DARK_MODE = "dark";
      const SYSTEM_MODE = "system";

      // 获取存储的主题，如果没有则使用默认值
      const theme = localStorage.getItem("theme") || defaultMode;

      // 获取系统主题
      function getSystemTheme() {
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? DARK_MODE
          : LIGHT_MODE;
      }

      // 解析主题（如果是system模式，则获取系统主题）
      function resolveTheme(themeValue) {
        if (themeValue === SYSTEM_MODE) {
          return getSystemTheme();
        }
        return themeValue;
      }

      const resolvedTheme = resolveTheme(theme);
      const isDark = resolvedTheme === DARK_MODE;

      // 应用主题
      if (isDark) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      // Set the theme for Expressive Code
      document.documentElement.setAttribute(
        "data-theme",
        isDark ? darkTheme : lightTheme
      );

      // 暴露两组代码主题名，供自建页头切换时复用同一机制（class + data-theme + colorScheme）
      try { window.__ffTheme = { dark: darkTheme, light: lightTheme }; } catch (e) {}

      // Load the hue from local storage
      const hue = localStorage.getItem("hue") || configHue;
      document.documentElement.style.setProperty("--hue", hue);

      // 设置卡片透明度（全屏透明模式下使用），优先使用用户自定义值
      const storedCardOpacity = localStorage.getItem("overlayCardOpacity");
      const parsedCardOpacity = storedCardOpacity === null ? NaN : Number.parseFloat(storedCardOpacity);
      const resolvedCardOpacity = Number.isFinite(parsedCardOpacity)
        ? Math.min(1, Math.max(0, parsedCardOpacity))
        : cardTransparentOpacity;
      document.documentElement.style.setProperty("--card-transparent-opacity", String(resolvedCardOpacity));

      // 仅在允许切换时使用设置面板保存的运行时选择；否则配置值始终生效
      const storedFullscreenLayout = isFullscreenLayoutSwitchable
        ? localStorage.getItem("fullscreenLayout")
        : null;
      if (!isFullscreenLayoutSwitchable) {
        localStorage.removeItem("fullscreenLayout");
      }
      const resolvedFullscreenLayout =
        storedFullscreenLayout === "hero" || storedFullscreenLayout === "classic"
          ? storedFullscreenLayout
          : fullscreenLayout;
      document.documentElement.setAttribute(
        "data-fullscreen-layout",
        resolvedFullscreenLayout,
      );

      // 内容定位已由 --content-top 纯 CSS 决定（layout-base.css），无需 --banner-height-extend 变量/计算

      // 初始化壁纸模式 - 在页面渲染前同步应用（其余布局由 CSS 属性选择器接管）
      const wallpaperMode = isWallpaperSwitchable
        ? localStorage.getItem("wallpaperMode") || defaultWallpaperMode
        : defaultWallpaperMode;

      // 设置data-wallpaper-mode属性
      document.documentElement.setAttribute(
        "data-wallpaper-mode",
        wallpaperMode
      );

      // 初始化期间禁用 content-panel/wrapper 过渡，避免加载时布局/变量变化产生内容移动动画；
      // load 后移除（仅首次设置，swup 切页重跑脚本时不再重复）。布局已由 CSS 接管，无需 rAF 校正
      if (!window.__fireflyLayoutTransitionGuard) {
        window.__fireflyLayoutTransitionGuard = true;
        document.documentElement.setAttribute("data-layout-init", "");
        const removeLayoutInit = () =>
          document.documentElement.removeAttribute("data-layout-init");
        if (document.readyState === "complete") {
          requestAnimationFrame(removeLayoutInit);
        } else {
          window.addEventListener("load", removeLayoutInit, { once: true });
        }
      }

      // 初始化水波纹动画状态 - 在 html 元素上设置属性，CSS 会立即生效
      (function applyWavesEnabled() {
        const wavesEnabled = localStorage.getItem("wavesEnabled");
        if (wavesEnabled !== null) {
          document.documentElement.setAttribute("data-waves-enabled", wavesEnabled);
        }
      })();

      // 初始化渐变过渡状态 - 在 html 元素上设置属性，CSS 会立即生效
      (function applyGradientEnabled() {
        const gradientEnabled = localStorage.getItem("gradientEnabled");
        if (gradientEnabled !== null) {
          document.documentElement.setAttribute("data-gradient-enabled", gradientEnabled);
        }
      })();

      // 初始化横幅标题显示状态 - 在 html 元素上设置属性，CSS 会立即生效
      (function applyBannerTitleEnabled() {
        const bannerTitleEnabled = localStorage.getItem("bannerTitleEnabled");
        if (bannerTitleEnabled !== null) {
          document.documentElement.setAttribute("data-banner-title-enabled", bannerTitleEnabled);
        }
      })();
    </script>
    <style
      define:vars={{
        configHue,
        "page-width": `${siteConfig.pageWidth ?? PAGE_WIDTH}rem`,
        "navbar-panel-blur": `${navbarPanelBlur}px`,
        "banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
        "banner-height-non-home": `max(${BANNER_HEIGHT_NON_HOME}vh, ${BANNER_HEIGHT_NON_HOME_MIN}px)`,
        "banner-height": `${BANNER_HEIGHT}vh`,
      }}
    ></style>
    <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->

    <!-- ========== 本地定制：hreflang 多语言定位 ========== -->
    {hreflangTags.map((tag) => <link rel={tag.rel} hreflang={tag.hreflang} href={tag.href} />)}

    <!-- ========== 本地定制：按路由元数据设置索引策略 ========== -->
    {/* 可索引页显式声明抓取与摘要策略；max-image-preview:large 是 Google Discover / 大图缩略图的必要条件 */}
    {routeMeta.indexable === false ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}

    <!-- ========== 本地定制：BreadcrumbList 结构化数据 ========== -->
    {!skipBreadcrumbStructuredData && (
      <script is:inline type="application/ld+json" set:html={breadcrumbStructuredData} />
    )}

    <slot name="head" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={profileConfig.name}
      href={`${Astro.site}rss.xml`}
    />

    <link
      rel="alternate"
      type="application/atom+xml"
      title={profileConfig.name}
      href={`${Astro.site}atom.xml`}
    />

    <!-- Font Setup (Astro Font API) -->
    <FontSetup />
  </head>
  <body
    class="min-h-screen ef ef-contours"
    class:list={[
      {
        "is-home": isHomePageCheck,
        "sticky-navbar": navbarMode === "fixed",
        "dynamic-navbar": navbarMode === "dynamic",
      },
    ]}
  >
    <!-- 首帧前按运行时壁纸模式翻转卡片透明类（布局已由 data-wallpaper-mode 属性规则接管） -->
    <script is:inline>
      (function () {
        const wm = document.documentElement.getAttribute("data-wallpaper-mode");
        if (!wm) return;
        document.body.classList.toggle(
          "wallpaper-transparent",
          wm === "overlay" ||
            (wm === "fullscreen" &&
              document.documentElement.getAttribute("data-fullscreen-layout") === "hero"),
        );
      })();
    </script>

    <div id="progress-bar"></div>

    {/* 卡片样式：根据 localStorage 覆盖默认配置 */}
    <script is:inline define:vars={{
      defaultBorder: siteConfig.card?.border ?? false,
      defaultFollowTheme: siteConfig.card?.followTheme ?? false,
    }}>
      (function() {
        var stored = localStorage.getItem("cardBorderEnabled");
        var border = stored !== null ? stored === "true" : defaultBorder;
        if (border) document.documentElement.classList.add("enable-card-border");
        else document.documentElement.classList.remove("enable-card-border");

        stored = localStorage.getItem("cardFollowThemeEnabled");
        var follow = stored !== null ? stored === "true" : defaultFollowTheme;
        if (follow) document.body.classList.add("card-follow-theme-hue");
        else document.body.classList.remove("card-follow-theme-hue");
      })();
    </script>

    <!-- 页面顶部渐变高光效果 - 只在full和semifull模式下显示 -->
    {shouldShowTopHighlight && <div class="top-gradient-highlight" />}
    <ConfigCarrier />
    <MusicManager />
    <slot />

    <!-- 播放器视图脚本：必须在 <slot /> 之后（解析到它时所有 widget 的 DOM 要已存在），
         且在 MusicManager 之后（swup 重跑按文档顺序，window.__fireflyMusic 得先就位） -->
    {(musicPlayerConfig.showInNavbar || musicPlayerConfig.showInSidebar !== false) && (
      <MusicPlayerView />
    )}


    <!-- Sakura Effect -->
    <SakuraEffect />

    <!-- Water Waves Effect -->
    <WavesEffect />

    <!-- Fancybox Manager -->
    <FancyboxManager />

    <!-- Tab 代码块交互 -->
    <CodeGroupManager />

    <!-- GitHub 卡片客户端实时补全（forks/stars） -->
    <GithubCardManager />
  </body>
