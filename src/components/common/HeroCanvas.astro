---
import { getSortedPosts, getTagList } from "@/utils/content-utils";

// 首屏统计：构建期算真值（此前用 data-ef-count 占位但没有任何脚本去填，线上一直显示破折号）
const [allPosts, allTags] = await Promise.all([getSortedPosts(), getTagList()]);
const postTotal = allPosts.length;
const tagTotal = allTags.length;
// 首页第 01 屏 —— 按《终末地》官网第 01 章节的真实骨架重做：
//   bg 背景层（WebGL 几何）+ 横向/纵向遮罩 + 标题舞台（实心大字 + 空心大字）
//   + 内容容器（说明 + 字段行 + CTA 面板）；章节编号 // 01 HOME 用 skill 的眉标写法。
//   纯几何/文字构成，不用美术图；背景与文字随主题。
---

<section id="ef-chapter-01" data-ef-hero class="ef-chapter">
  <!-- 官网第 01 屏的整张实景主视觉（官方素材 media/01.aae95e75.png，站主同意少量使用） -->
  <div class="ef-ch-kv-bg" aria-hidden="true"></div>
  <!-- 内容容器 -->
  <div class="ef-ch-inner">
    <p class="ef-eyebrow ef-ch-eyebrow" data-replay="ef-in-power" style="--i: 0"><i aria-hidden="true"></i>// 01 HOME</p>

    <!-- 标题舞台：实心 + 空心 -->
    <div class="ef-ch-stage">
      <h1 class="ef-ch-title" data-replay="ef-in-power" style="--i: 1">LC BLOG</h1>
      <p class="ef-ch-hollow" data-replay="ef-in-drive" style="animation-delay: 140ms" aria-hidden="true">LEGSPCPD BLOG</p>
    </div>

    <p class="ef-ch-lede" data-replay="ef-in-power" style="--i: 2">Cloudflare / EdgeOne / 自建服务 —— 记录配置、踩坑与取舍。</p>

    <ul class="ef-facts ef-field ef-ch-facts" data-replay="ef-in-power" style="--i: 3">
      <li><b class="ef-num" data-fx-load aria-label={String(postTotal)}>{postTotal}</b> 篇文章</li>
      <li><b class="ef-num" data-fx-load aria-label={String(tagTotal)}>{tagTotal}</b> 个标签</li>
      <li>持续更新中</li>
    </ul>

    <!-- 入口面板：对应官网第 01 屏的 downloader 面板（标题 + 值行 + 行动） -->
    <div class="ef-ch-panel" data-replay="ef-in-power" style="--i: 4">
      <div class="ef-ch-panel-head">
        <span class="ef-field">入口</span>
        <span class="ef-tag">3</span>
      </div>
      <ul class="ef-ch-kv">
        <li><span class="ef-field">文章</span><a href="/archive/">全部文章</a></li>
        <li><span class="ef-field">关系</span><a href="/friends/">友链</a></li>
        <li><span class="ef-field">站点</span><a href="/about/">关于</a></li>
      </ul>
    </div>
  </div>

  <!-- 大号空心章节编号（官网那种空心数字） -->
  <p class="ef-ch-no" aria-hidden="true">01</p>
  <!-- 右侧竖向章节指示条 -->
  <p class="ef-ch-scroll ef-field" aria-hidden="true">Scroll ↓</p>
</section>

<style>
  .ef-chapter {
    position: relative;
    background: transparent;
    min-height: clamp(40rem, 94vh, 66rem);
    display: flex; align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--ef-rule);
  }
  .ef-ch-bg { position: absolute; inset: 0; }
  .ef-ch-bg canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* 两层遮罩：横向压暗两端、纵向压暗底部，让标题区始终干净 */
  .ef-ch-mask-h { position: absolute; inset: 0; background: linear-gradient(90deg, var(--ef-paper) 0%, color-mix(in srgb, var(--ef-paper) 86%, transparent) 26%, transparent 52%, transparent 70%, color-mix(in srgb, var(--ef-paper) 80%, transparent) 100%); }
  .ef-ch-mask-v { position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--ef-paper) 70%, transparent) 0%, transparent 26%, transparent 52%, var(--ef-paper) 100%); }
  .ef-ch-inner {
    position: relative; z-index: 1;
    /* 文字底色：让标题区始终可读（站主反馈文字与背景重合看不清） */
    max-width: min(92rem, 94vw);
    margin-left: auto;
    margin-right: auto;
    padding: clamp(2.2rem, 4.2vw, 4rem) clamp(2rem, 4.4vw, 4.2rem);
    /* 站主反复反馈「主视觉经常整块看不见」。实测：DOM 里每个子元素都是
       opacity:1 / visibility:visible / 无动画 / clipPath:none、文字也在，但截图是空框 ——
       即渲染层问题，不是样式问题。这里的 backdrop-filter 与下面的 clip-path 同时存在，
       是 Chromium 已知的合成缺陷组合，表现恰好就是「时有时无」。
       保留切角（终末地特征），去掉 backdrop 模糊，改用足够不透明的底色。 */
    background: color-mix(in srgb, var(--ef-panel) 96%, transparent);
    border: 1px solid var(--ef-rule);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
  }
  .ef-ch-stage { position: relative; margin: 0.35rem 0 0.5rem; }
  .ef-ch-title {
    position: relative; z-index: 1;
    margin: 0;
    font-size: clamp(3.2rem, 9vw, 7.4rem);
    font-weight: 800; font-stretch: 120%; line-height: 1.1; letter-spacing: -0.015em;
    color: var(--ef-ink);
  }
  /* 空心大字：描边不填充，压在实心标题下方（skill：字标「实心加空心」） */
  .ef-ch-hollow {
    margin: 0.1rem 0 0;
    font-size: clamp(1.5rem, 3.2vw, 2.6rem);
    font-weight: 800; font-stretch: 125%; letter-spacing: 0.1em; line-height: 1;
    opacity: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--ef-ink) 55%, transparent);
    text-stroke: 1.5px color-mix(in srgb, var(--ef-ink) 55%, transparent);
    user-select: none;
  }
  .ef-ch-lede { margin: 1.15rem 0 1.2rem; font-size: clamp(1.25rem, 2.1vw, 1.75rem); line-height: 1.8; color: color-mix(in srgb, var(--ef-ink) 88%, transparent); max-width: 60rem; }
  .ef-ch-facts { gap: 0 1.3rem; margin-top: 0.2rem; font-size: 1.2rem; }
  .ef-ch-facts li + li::before { content: "│"; margin-right: 0.75rem; color: var(--ef-ink-2); }
  .ef-ch-cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
  /* 四角切角标记：官网面板的标志性细节 */
  .ef-chapter::before,
  .ef-chapter::after {
    content: ""; position: absolute; width: 18px; height: 18px; pointer-events: none;
    border-color: var(--ef-signal); border-style: solid; border-width: 0; z-index: 2;
  }
  .ef-chapter::before { top: 14px; left: 14px; border-top-width: 2px; border-left-width: 2px; }
  .ef-chapter::after { bottom: 18px; right: 14px; border-bottom-width: 2px; border-right-width: 2px; }
  /* 眉标前的黄色小标记 */
  .ef-ch-eyebrow { display: flex; align-items: center; gap: 0.5rem; }
  .ef-ch-eyebrow > i { display: inline-block; width: 10px; height: 10px; background: var(--ef-signal); }
  /* 大号空心章节编号 */
  .ef-ch-no {
    position: absolute; right: clamp(1rem, 5vw, 4rem); top: 50%; transform: translateY(-52%);
    margin: 0; z-index: 1;
    font-size: clamp(6rem, 19vw, 15rem); font-weight: 800; font-stretch: 125%; line-height: 0.86;
    color: transparent; -webkit-text-stroke: 2px color-mix(in srgb, var(--ef-ink) 26%, transparent);
    user-select: none; pointer-events: none;
  }
  /* 入口面板 */
  .ef-ch-panel { margin-top: 2.1rem; max-width: 48rem; border: 1px solid var(--ef-rule); background: color-mix(in srgb, var(--ef-panel) 70%, transparent); }
  .ef-ch-panel-head { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.8rem; border-bottom: 1px solid var(--ef-rule); }
  .ef-ch-kv { margin: 0; padding: 0.25rem 0; list-style: none; }
  .ef-ch-kv li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 0.75rem; align-items: baseline; padding: 0.4rem 0.8rem; border-bottom: 1px solid color-mix(in srgb, var(--ef-rule) 60%, transparent); }
  .ef-ch-kv li:last-child { border-bottom: 0; }
  .ef-ch-kv a { color: var(--ef-ink); text-decoration: none; font-weight: 600; }
  .ef-ch-kv a:hover { color: var(--ef-signal); }
  .ef-ch-scroll { position: absolute; right: clamp(1rem, 4vw, 3rem); bottom: 1.1rem; margin: 0; }
  /* 窄屏：空心大号编号会压到正文面板上（实测 500px 宽时完全重叠）→ 直接不显示 */
  @media (max-width: 860px) {
    .ef-ch-no { display: none; }
    .ef-ch-inner { margin-left: 0; }
    .ef-ch-chapter, .ef-chapter { min-height: clamp(30rem, 76vh, 44rem); }
  }
  #ef-chapter-01.no-webgl .ef-ch-bg::before {
    content: ""; position: absolute; inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--ef-ink) 7%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--ef-ink) 7%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  /* ---- 官网式满屏主视觉 ----
     官方 .ef 章节是把实景图铺满整屏，再压一层深色渐变保证文字可读；
     此前这里是深色底 + 一个居中面板，所以整体显得小而空。 */
  .ef-ch-kv-bg {
    position: absolute; inset: 0; z-index: 0;
    background-image: url("/endfield-ui/official/no-01.png");
    background-size: cover; background-position: 50% 42%; background-repeat: no-repeat;
  }
  .ef-ch-kv-bg::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--ef-paper) 96%, transparent) 0%,
      color-mix(in srgb, var(--ef-paper) 88%, transparent) 34%,
      color-mix(in srgb, var(--ef-paper) 46%, transparent) 66%,
      color-mix(in srgb, var(--ef-paper) 70%, transparent) 100%);
  }
  .ef-chapter { position: relative; }
  .ef-ch-inner {
    background: color-mix(in srgb, var(--ef-panel) 82%, transparent);
  }
</style>

