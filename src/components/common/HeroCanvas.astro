---
import { EF_ICONS } from "@/constants/efIcons";
import { getSortedPosts, getTagList } from "@/utils/content-utils";

// 首页第 01 屏 —— 照官网首屏的骨相重做：左侧版心巨字 + 数值行 + 官网同款按钮；
// 右侧竖排标记。纯几何与文字，不含任何图片（站主要求先去图）。
// 站主 2026-10：大标题定稿 LEGSPCPD BLOG，标题下的空心英文与中文简介两行整段删除。
const [allPosts, allTags] = await Promise.all([getSortedPosts(), getTagList()]);
/* 跑带用的 //ENDFIELD 字标：官网 viewBox="0 0 1902 253" 那枚 path，从 efIcons 取。 */
const efWord = EF_ICONS.endfieldWord;
const postTotal = allPosts.length;
const tagTotal = allTags.length;
const catTotal = new Set(allPosts.map((p) => p.data.category).filter(Boolean)).size;
const latest = allPosts[0]?.data.published ? new Date(allPosts[0].data.published) : null;
const latestLabel = latest
	? "+" + latest.getFullYear() + "." + String(latest.getMonth() + 1).padStart(2, "0")
	: "持续更新";
---

<section class="ef-hero">
	<div class="ef-hero-inner" data-ef-parallax="-0.035">
		<p class="ef-hero-eyebrow" data-ef-reveal="flash"><i aria-hidden="true"></i>// 01 HOME</p>

		<h1 class="ef-hero-title" data-ef-reveal="up" style="--ef-d: 60ms">LEGSPCPD BLOG</h1>

		<ul class="ef-hero-facts" data-ef-reveal="up" style="--ef-d: 200ms">
			<li><b>{postTotal}</b><span>篇文章</span></li>
			<li><b>{tagTotal}</b><span>个标签</span></li>
			<li><b>{catTotal}</b><span>个分类</span></li>
			<li><b>{latestLabel}</b><span>最近更新</span></li>
		</ul>

		<div class="ef-hero-actions" data-ef-reveal="up" style="--ef-d: 240ms">
			<a class="ef-hero-btn" href="/archive/">
				<span>浏览全部文章</span><i aria-hidden="true">→</i>
			</a>
			<a class="ef-hero-btn ef-hero-btn--ghost" href="/about/">关于本站</a>
		</div>
	</div>

	<div class="ef-hero-side" aria-hidden="true" data-ef-reveal="fade" data-ef-parallax="0.09">
		<p class="ef-hero-side-mark">LEGSPCPD</p>
		<p class="ef-hero-side-scroll">SCROLL<span>↓</span></p>
	</div>

</section>

<!-- // ENDFIELD 跑带 —— 官网 .__05-Gameplay_endfieldPre（线上 chunk 226 的 aM 组件）。
     官网原文（逐字）：
       let e = useRef(window.document.documentElement);
       const {scrollYProgress: t} = useScroll({container: e});
       const a = useTransform(t, p => `${-(300*p)%120}%`);
       const n = useTransform(t, p => `${120-300*p%120}%`);
       return <div className={styles.endfieldPre}>
                <div className={styles.icon} style={{translateX: a}}><Ef/></div>
                <div className={styles.icon} style={{translateX: n}}><Ef/></div>
              </div>;
     官网那三条几何逐值照抄（1rem ≡ var(--efu)，规则在 endfield-shell.css §7.6）：
       容器 height 15.625rem / width 100% / overflow:hidden
       图标 height 100% / width auto（= 官网 .icon 与 .ef 两条）
     官网把它放在 Gameplay 区块内 top:8.125rem；本站按站主「放在首页 hero 之后」放在
     首屏这一节的正下方，成为一条整幅贯通的独立跑带。
     文案固定为 //ENDFIELD（站主明说不要 LC BLOG / LEGSPCPD），用官网那枚
     viewBox="0 0 1902 253" 的字标 path（EF_ICONS.endfieldWord），逐字照抄。
     位移由 ef-scroll-motion.ts 写 --ef-bx（1px 量化，宽度只在 init/resize 量一次）：
     往下滚 p 变大 → 两条都向左；往上滚 p 变小 → 同一条式子给出反向位移，没有额外分支。 -->
<div class="ef-endfield-band" aria-hidden="true">
	<i class="ef-band-copy" data-ef-band="a">
		<svg class="ef-endfield-word" viewBox={efWord.viewBox} xmlns="http://www.w3.org/2000/svg">
			<path fill-rule="evenodd" fill="currentColor" d={efWord.paths[0]} />
		</svg>
	</i>
	<i class="ef-band-copy" data-ef-band="b">
		<svg class="ef-endfield-word" viewBox={efWord.viewBox} xmlns="http://www.w3.org/2000/svg">
			<path fill-rule="evenodd" fill="currentColor" d={efWord.paths[0]} />
		</svg>
	</i>
</div>

<style>
	/* 首屏基调跟内页一致：纸 #f2f2f2 + 墨 #191919，黄只做点缀（眉标方块 / 按钮 hover）。
	   站主 2026-10：暗色全部换成官网那种白色，首页不再是暗底。 */
	.ef-hero {
		position: relative;
		min-height: calc(100dvh - 2px);
		display: flex;
		align-items: center;
		overflow: hidden;
		background: #f2f2f2;
		color: #191919;
		border-bottom: 1px solid #e5e5e5;
	}

	.ef-hero-inner {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: calc(96 * var(--efu));
		margin-inline: auto;
		padding: calc(8 * var(--efu)) calc(4 * var(--efu)) calc(6 * var(--efu));
	}

	/* 眉标：官网英文标签一律大写 + 字距 .14em，前面一枚黄方块 */
	.ef-hero-eyebrow {
		display: flex;
		align-items: center;
		gap: calc(0.75 * var(--efu));
		margin: 0 0 calc(1.5 * var(--efu));
		font-family: SansMedium, sans-serif;
		font-size: calc(1.15 * var(--efu));
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #666;
	}
	.ef-hero-eyebrow > i {
		display: inline-block;
		width: calc(0.7 * var(--efu));
		height: calc(0.7 * var(--efu));
		background: #fffa00;
	}

	/* 巨字：官网首屏是超大字重的中文标题，左对齐、极紧行高 */
	.ef-hero-title {
		margin: 0;
		font-family: SansBold, Novecentosanswide-Bold, system-ui, sans-serif;
		font-size: clamp(3rem, calc(11 * var(--efu)), 11rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
		color: #191919;
	}

	/* 空心斜纹小字：照官网 HallowText_hollowText 的写法（斜纹渐变 + 文字裁剪）。
	   官网把 tile 设成 .5rem、条纹只有 ~0.5px —— 在 187px 的大字上才看得出纹理；
	   这里字号 20~45px，照抄等于看不见，所以换成显式 2px 斜纹（同一个做法，条带可见）。
	   浅底上用 #b3b3b3，深底上原本是 #f2f2f2 —— 现在全站浅色，只留这一版。 */
	.ef-hero-hollow {
		/* 巨字行高压到 .92，字脚会越过行盒，这条要让开一点 */
		margin: calc(2.9 * var(--efu)) 0 0;
		font-family: Novecentosanswide-Bold, SansBold, sans-serif;
		font-size: clamp(1rem, calc(2.6 * var(--efu)), 2.8rem);
		line-height: 1;
		letter-spacing: 0.02em;
		white-space: nowrap;
		background-image: repeating-linear-gradient(
			-45deg,
			#b3b3b3 0 2px,
			transparent 2px 4px
		);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		user-select: none;
	}

	.ef-hero-lede {
		margin: calc(2 * var(--efu)) 0 0;
		max-width: calc(46 * var(--efu));
		font-size: clamp(0.95rem, calc(1.6 * var(--efu)), 1.5rem);
		line-height: 1.8;
		color: #666;
	}

	/* 数值行：官网的字段行做法 —— 细线分隔、等宽数字 */
	.ef-hero-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0 calc(2.5 * var(--efu));
		margin: calc(2.5 * var(--efu)) 0 0;
		padding: 0;
		list-style: none;
	}
	.ef-hero-facts li {
		display: flex;
		align-items: baseline;
		gap: calc(0.6 * var(--efu));
		padding-block: calc(0.75 * var(--efu));
		border-top: 1px solid #e5e5e5;
	}
	.ef-hero-facts b {
		font-family: Novecentosanswide-Bold, SansBold, sans-serif;
		font-size: calc(2.1 * var(--efu));
		line-height: 1;
		color: #191919;
		font-variant-numeric: tabular-nums;
	}
	.ef-hero-facts span {
		font-size: calc(1.1 * var(--efu));
		color: #666;
		letter-spacing: 0.04em;
	}

	/* 按钮：官网按钮是 4px 圆角、深墨面 + 纸色字，hover 擦黄（浅底上仍是最强对比） */
	.ef-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: calc(0.875 * var(--efu));
		margin-top: calc(2.5 * var(--efu));
	}
	.ef-hero-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: calc(0.75 * var(--efu));
		min-width: calc(18 * var(--efu));
		height: calc(4.5 * var(--efu));
		padding: 0 calc(2 * var(--efu));
		border: 0;
		border-radius: calc(0.25 * var(--efu));
		background-color: #191919;
		color: #f2f2f2;
		font-family: SansMedium, system-ui, sans-serif;
		font-size: calc(1.5 * var(--efu));
		line-height: 1;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.ef-hero-btn i {
		font-style: normal;
		transition: transform 0.25s;
	}
	.ef-hero-btn:hover {
		background-color: #fffa00;
		color: #191919;
	}
	.ef-hero-btn:hover i {
		transform: translate3d(calc(0.4 * var(--efu)), 0, 0);
	}
	.ef-hero-btn--ghost {
		background-color: transparent;
		color: #191919;
		box-shadow: inset 0 0 0 1px #d9d9d9;
	}
	.ef-hero-btn--ghost:hover {
		background-color: #e5e5e5;
		color: #191919;
		box-shadow: inset 0 0 0 1px #e5e5e5;
	}

	/* 右侧竖排标记（官网首屏右上角的章节/滚动提示） */
	.ef-hero-side {
		position: absolute;
		right: calc(3 * var(--efu));
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(2 * var(--efu));
		z-index: 2;
	}
	.ef-hero-side-mark {
		margin: 0;
		writing-mode: vertical-rl;
		font-family: Novecentosanswide-Bold, sans-serif;
		font-size: calc(1.1 * var(--efu));
		letter-spacing: 0.5em;
		color: #d9d9d9;
		text-transform: uppercase;
	}
	.ef-hero-side-scroll {
		margin: 0;
		writing-mode: vertical-rl;
		font-family: SansMedium, sans-serif;
		font-size: calc(0.95 * var(--efu));
		letter-spacing: 0.28em;
		color: #999;
	}
	.ef-hero-side-scroll span {
		display: block;
		margin-top: calc(0.4 * var(--efu));
		color: #191919;
	}

	@media (max-width: 1100px) {
		.ef-hero-side {
			display: none;
		}
	}
	/* 窄屏 H5：字级 / 间距照官网 H5（root font-size:min(1.481481vw,.833333vh)，
	   390×844 实测 1u = 5.7778px；角色档位与 --ef-fs-* 的 H5 版本在
	   endfield-shell.css §8 统一定义，这里只调首屏自己的几何）。 */
	@media (max-width: 860px) {
		.ef-hero {
			/* 官网 H5 首屏不是满屏：内容有多高就多高，别把正文顶到下一屏 */
			min-height: auto;
		}
		.ef-hero-inner {
			max-width: 100%;
			padding: calc(8 * var(--efu)) calc(3.5 * var(--efu)) calc(6 * var(--efu));
		}
		.ef-hero-eyebrow {
			margin-bottom: calc(2 * var(--efu));
			font-size: max(calc(1.15 * var(--efu)), 10px);
		}
		/* 7u ≈ 40px @390：六个汉字 = 242px < 版心 295px，一行放得下；
		   26px 下限保证 320px 的老机型也不会折成三行。 */
		.ef-hero-title {
			font-size: clamp(26px, calc(7 * var(--efu)), 11rem);
			line-height: 1.04;
			letter-spacing: 0;
		}
		/* 空心斜纹小字：窄屏允许折行，并且必须能在版心里断开
		   （原来 nowrap + overflow:hidden 会把右端 TRADEOFF 裁掉半截）。 */
		.ef-hero-hollow {
			margin-top: calc(2 * var(--efu));
			font-size: max(calc(2.4 * var(--efu)), 12px);
			white-space: normal;
			overflow-wrap: anywhere;
		}
		.ef-hero-lede {
			margin-top: calc(2 * var(--efu));
			max-width: 100%;
			font-size: var(--ef-fs-6);
			line-height: 1.75;
		}
		/* 数值行：四列在 390 上挤成一行 10px 小字，改成 2×2 更清楚 */
		.ef-hero-facts {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 calc(2 * var(--efu));
			margin-top: calc(3 * var(--efu));
		}
		.ef-hero-facts b {
			font-size: var(--ef-fs-9);
		}
		.ef-hero-facts li {
			padding-block: calc(1 * var(--efu));
		}
		.ef-hero-facts span {
			font-size: max(calc(1.1 * var(--efu)), 10px);
		}
		/* 按钮：竖排、整行宽，触控高度不低于 42px */
		.ef-hero-actions {
			flex-direction: column;
			gap: calc(1.2 * var(--efu));
			margin-top: calc(3 * var(--efu));
		}
		.ef-hero-btn {
			width: 100%;
			min-width: 0;
			flex: 0 0 auto;
			height: max(calc(5 * var(--efu)), 42px);
			padding-inline: calc(2 * var(--efu));
			font-size: var(--ef-fs-5);
		}
	}
</style>

<script>
	/* 滚动进场 + 轻量视差（参数见 endfield-shell.css §7.5，实现见这个模块）。
	   Astro 会把它打成模块脚本，只在首页加载；模块本身对 swup 切页做了重新初始化，
	   所以进站后从首页跳到长页也继续生效。 */
	import "@/utils/ef-scroll-motion";
</script>
