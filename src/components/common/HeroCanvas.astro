---
import { getSortedPosts, getTagList } from "@/utils/content-utils";

// 首页第 01 屏 —— 照官网首屏的骨相重做：左侧版心巨字 + 空心斜纹小字 + 一句说明 +
// 数值行 + 官网同款按钮；右侧竖排标记。纯几何与文字，不含任何图片（站主要求先去图）。
const [allPosts, allTags] = await Promise.all([getSortedPosts(), getTagList()]);
const postTotal = allPosts.length;
const tagTotal = allTags.length;
const catTotal = new Set(allPosts.map((p) => p.data.category).filter(Boolean)).size;
const latest = allPosts[0]?.data.published ? new Date(allPosts[0].data.published) : null;
const latestLabel = latest
	? "+" + latest.getFullYear() + "." + String(latest.getMonth() + 1).padStart(2, "0")
	: "持续更新";
---

<section class="ef-hero">
	<div class="ef-hero-inner">
		<p class="ef-hero-eyebrow"><i aria-hidden="true"></i>// 01 HOME</p>

		<h1 class="ef-hero-title">自建服务记录</h1>
		<p class="ef-hero-hollow" aria-hidden="true">CONFIG · PITFALL · TRADEOFF</p>

		<p class="ef-hero-lede">
			Cloudflare / EdgeOne / 自建服务 —— 记录配置、踩坑与取舍。
		</p>

		<ul class="ef-hero-facts">
			<li><b>{postTotal}</b><span>篇文章</span></li>
			<li><b>{tagTotal}</b><span>个标签</span></li>
			<li><b>{catTotal}</b><span>个分类</span></li>
			<li><b>{latestLabel}</b><span>最近更新</span></li>
		</ul>

		<div class="ef-hero-actions">
			<a class="ef-hero-btn" href="/archive/">
				<span>浏览全部文章</span><i aria-hidden="true">→</i>
			</a>
			<a class="ef-hero-btn ef-hero-btn--ghost" href="/about/">关于本站</a>
		</div>
	</div>

	<div class="ef-hero-side" aria-hidden="true">
		<p class="ef-hero-side-mark">LEGSPCPD</p>
		<p class="ef-hero-side-scroll">SCROLL<span>↓</span></p>
	</div>
</section>

<style>
	.ef-hero {
		position: relative;
		min-height: calc(100dvh - 2px);
		display: flex;
		align-items: center;
		overflow: hidden;
		background: #191919;
		color: #f2f2f2;
		border-bottom: 1px solid #35373c;
	}

	.ef-hero-inner {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: calc(96 * var(--efu));
		margin-inline: auto;
		padding: calc(8 * var(--efu)) calc(4 * var(--efu)) calc(6 * var(--efu));
	}

	/* 眉标：官网英文标签一律大写 + 字距 .14em，前面一枚黄方块 */
	.ef-hero-eyebrow {
		display: flex;
		align-items: center;
		gap: calc(0.75 * var(--efu));
		margin: 0 0 calc(1.5 * var(--efu));
		font-family: SansMedium, sans-serif;
		font-size: calc(1.15 * var(--efu));
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #999;
	}
	.ef-hero-eyebrow > i {
		display: inline-block;
		width: calc(0.7 * var(--efu));
		height: calc(0.7 * var(--efu));
		background: #fffa00;
	}

	/* 巨字：官网首屏是超大字重的中文标题，左对齐、极紧行高 */
	.ef-hero-title {
		margin: 0;
		font-family: SansBold, Novecentosanswide-Bold, system-ui, sans-serif;
		font-size: clamp(3rem, calc(11 * var(--efu)), 11rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
		color: #f2f2f2;
	}

	/* 空心斜纹小字：照官网 HallowText_hollowText 的写法（斜纹渐变 + 文字裁剪） */
	.ef-hero-hollow {
		margin: calc(0.9 * var(--efu)) 0 0;
		font-family: Novecentosanswide-Bold, SansBold, sans-serif;
		font-size: clamp(1rem, calc(2.6 * var(--efu)), 2.8rem);
		line-height: 1;
		letter-spacing: 0.02em;
		white-space: nowrap;
		background-image: linear-gradient(
			-45deg,
			transparent,
			transparent 20.5805%,
			#f2f2f2 0,
			#f2f2f2 29.4195%,
			transparent 0,
			transparent 70.5805%,
			#f2f2f2 0,
			#f2f2f2 79.4195%,
			transparent 0,
			transparent
		);
		background-size: calc(0.5 * var(--efu)) calc(0.5 * var(--efu));
		background-repeat: repeat;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		opacity: 0.55;
		user-select: none;
	}

	.ef-hero-lede {
		margin: calc(2 * var(--efu)) 0 0;
		max-width: calc(46 * var(--efu));
		font-size: clamp(0.95rem, calc(1.6 * var(--efu)), 1.5rem);
		line-height: 1.8;
		color: #d9d9d9;
	}

	/* 数值行：官网的字段行做法 —— 细线分隔、等宽数字 */
	.ef-hero-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0 calc(2.5 * var(--efu));
		margin: calc(2.5 * var(--efu)) 0 0;
		padding: 0;
		list-style: none;
	}
	.ef-hero-facts li {
		display: flex;
		align-items: baseline;
		gap: calc(0.6 * var(--efu));
		padding-block: calc(0.75 * var(--efu));
		border-top: 1px solid #35373c;
	}
	.ef-hero-facts b {
		font-family: Novecentosanswide-Bold, SansBold, sans-serif;
		font-size: calc(2.1 * var(--efu));
		line-height: 1;
		color: #f2f2f2;
		font-variant-numeric: tabular-nums;
	}
	.ef-hero-facts span {
		font-size: calc(1.1 * var(--efu));
		color: #999;
		letter-spacing: 0.04em;
	}

	/* 按钮：官网按钮是 4px 圆角、深灰面 + #eee 字，hover 擦黄 */
	.ef-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: calc(0.875 * var(--efu));
		margin-top: calc(2.5 * var(--efu));
	}
	.ef-hero-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: calc(0.75 * var(--efu));
		min-width: calc(18 * var(--efu));
		height: calc(4.5 * var(--efu));
		padding: 0 calc(2 * var(--efu));
		border: 0;
		border-radius: calc(0.25 * var(--efu));
		background-color: #383838;
		color: #eee;
		font-family: SansMedium, system-ui, sans-serif;
		font-size: calc(1.5 * var(--efu));
		line-height: 1;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.ef-hero-btn i {
		font-style: normal;
		transition: transform 0.25s;
	}
	.ef-hero-btn:hover {
		background-color: #fffa00;
		color: #191919;
	}
	.ef-hero-btn:hover i {
		transform: translate3d(calc(0.4 * var(--efu)), 0, 0);
	}
	.ef-hero-btn--ghost {
		background-color: transparent;
		color: #d9d9d9;
		box-shadow: inset 0 0 0 1px #35373c;
	}
	.ef-hero-btn--ghost:hover {
		background-color: #f2f2f2;
		color: #191919;
		box-shadow: inset 0 0 0 1px #f2f2f2;
	}

	/* 右侧竖排标记（官网首屏右上角的章节/滚动提示） */
	.ef-hero-side {
		position: absolute;
		right: calc(3 * var(--efu));
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(2 * var(--efu));
		z-index: 2;
	}
	.ef-hero-side-mark {
		margin: 0;
		writing-mode: vertical-rl;
		font-family: Novecentosanswide-Bold, sans-serif;
		font-size: calc(1.1 * var(--efu));
		letter-spacing: 0.5em;
		color: #35373c;
		text-transform: uppercase;
	}
	.ef-hero-side-scroll {
		margin: 0;
		writing-mode: vertical-rl;
		font-family: SansMedium, sans-serif;
		font-size: calc(0.95 * var(--efu));
		letter-spacing: 0.28em;
		color: #999;
	}
	.ef-hero-side-scroll span {
		display: block;
		margin-top: calc(0.4 * var(--efu));
		color: #fffa00;
	}

	@media (max-width: 1100px) {
		.ef-hero-side {
			display: none;
		}
	}
	@media (max-width: 860px) {
		.ef-hero {
			min-height: auto;
		}
		.ef-hero-inner {
			padding-block: calc(5 * var(--efu)) calc(4 * var(--efu));
		}
		.ef-hero-hollow {
			white-space: normal;
		}
		.ef-hero-facts {
			gap: 0 calc(1.5 * var(--efu));
		}
		.ef-hero-btn {
			min-width: 0;
			flex: 1 1 auto;
		}
	}
</style>
