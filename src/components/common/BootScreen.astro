---
// 登入式加载动画 —— 按《终末地》官网的真实 CSS 数值实现（已从官网 CSS 里核对）
//   容器：#141414 深色底 + 白字（官网就是恒定深色，不随主题）
//   宽屏：横向轨道 left:0 / bottom:17.75rem / width:82.407% / height:2.5rem，
//         填充 #fffa00 用 scaleX 从左往右灌（对应官网 @keyframes …fadeIn）
//   窄屏：竖向轨道贴左边缘、从上往下灌（官网的移动端变体 width:0;height:100%）
//   百分比 4.375rem（70px，官网 Loading_value 的字号）
//   字标绝对定位在 left:64.453% / top:27.625rem（官网 Loading_logo 的位置）
//   口号 1.5rem（官网 Loading_slogan 的字号）
//
// 硬规定：不使用游戏官方素材与文案；只在首页；每会话一次；可跳过；减少动态效果时不渲染。
import { backgroundWallpaper } from "@/config";

const slogans = ((backgroundWallpaper as any)?.common?.homeText?.subtitle ?? []) as string[];
const slogan = Array.isArray(slogans) && slogans.length > 0 ? String(slogans[0]) : "In Reddened Chrysalis, I Once Rest";
---

<div id="ef-boot" data-ef-boot>
  <div class="ef-boot-brand">
    <span class="ef-boot-brand-cn">LegspCpd</span>
    <span class="ef-boot-brand-en">BLOG</span>
  </div>
  <div class="ef-boot-progress">
    <div class="ef-boot-track"><span class="ef-boot-fill"></span></div>
    <div class="ef-boot-meter">
      <span class="ef-boot-pct" id="ef-boot-pct">0%</span>
      <span class="ef-boot-loading">Loading</span>
    </div>
  </div>
  <div class="ef-boot-foot">
    <p class="ef-boot-status"><span class="ef-boot-mark">▲</span> 站点资源正在加载，请稍候</p>
    {slogan && <p class="ef-boot-slogan">{slogan}</p>}
  </div>
</div>

<style>
  #ef-boot {
    position: fixed; inset: 0; z-index: 2000;
    background: #141414; color: #fff;
    transition: opacity 240ms var(--ef-ease-mech, ease-out);
  }
  #ef-boot.is-out { opacity: 0; pointer-events: none; }
  .ef-boot-brand { position: absolute; left: 64.453%; top: 27.625rem; }
  .ef-boot-brand-cn { display: block; font-size: 2rem; font-weight: 800; font-stretch: 125%; letter-spacing: 0.01em; }
  .ef-boot-brand-en { display: block; margin-top: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.24em; color: rgba(255,255,255,.72); }
  .ef-boot-progress { position: absolute; left: 0; bottom: 17.75rem; width: 82.4074074074%; height: 2.5rem; }
  .ef-boot-track { position: relative; width: 100%; height: 100%; background: rgba(255,255,255,.14); }
  .ef-boot-fill {
    position: absolute; inset: 0; transform-origin: left center; transform: scaleX(0);
    background: #fffa00; animation: ef-boot-fill 1400ms var(--ef-ease-snap, ease-out) forwards;
  }
  @keyframes ef-boot-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .ef-boot-meter { position: absolute; left: 0; top: calc(2.5rem + 14px); display: flex; align-items: baseline; gap: 16px; }
  .ef-boot-pct {
    font-size: 4.375rem; font-weight: 500; line-height: 1; font-stretch: 112%;
    font-variant-numeric: tabular-nums; letter-spacing: 0.01em;
  }
  .ef-boot-loading { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,.72); }
  .ef-boot-foot { position: absolute; left: 0; right: 0; bottom: 52px; text-align: center; }
  .ef-boot-status { margin: 0 0 10px; font-size: 12px; color: rgba(255,255,255,.66); }
  .ef-boot-mark { color: #fffa00; }
  .ef-boot-slogan { margin: 0; font-size: 1.5rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  /* 窄屏：官网的竖向变体 —— 贴左边缘、从上往下灌 */
  @media (max-width: 1024px) {
    .ef-boot-progress { left: 0; top: 0; bottom: auto; width: 3px; height: 100%; }
    .ef-boot-track { display: none; }
    .ef-boot-fill {
      position: absolute; left: 0; top: 0; width: 100%; height: 0; transform: none;
      animation: ef-boot-fill-v 1400ms var(--ef-ease-snap, ease-out) forwards;
    }
    .ef-boot-meter { left: 20px; top: 46%; gap: 10px; }
    .ef-boot-pct { font-size: 2.6rem; }
    .ef-boot-brand { left: auto; right: 24px; top: 28px; }
    .ef-boot-slogan { font-size: 1rem; }
  }
  @keyframes ef-boot-fill-v { from { height: 0; } to { height: 100%; } }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById("ef-boot");
    if (!el) return;
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var seen = false;
    try { seen = sessionStorage.getItem("ef-boot") === "1"; } catch (e) {}
    if (reduce || seen) { el.remove(); return; }
    try { sessionStorage.setItem("ef-boot", "1"); } catch (e) {}
    document.documentElement.style.overflow = "hidden";
    var pct = document.getElementById("ef-boot-pct");
    var t0 = Date.now();
    var timer = setInterval(function () {
      var p = Math.min(100, Math.round(((Date.now() - t0) / 1400) * 100));
      if (pct) pct.textContent = p + "%";
      if (p >= 100) clearInterval(timer);
    }, 60);
    var done = false;
    function leave() {
      if (done) return;
      done = true;
      clearInterval(timer);
      el.classList.add("is-out");
      document.documentElement.style.overflow = "";
      setTimeout(function () { el.remove(); }, 300);
    }
    setTimeout(leave, 1900);
    el.addEventListener("click", leave);
    window.addEventListener("keydown", leave, { once: true });
  })();
</script>