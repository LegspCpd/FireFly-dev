---
// 登入式加载动画（对齐《终末地》官网首屏布局）：
//   左侧一条竖向进度条（从上往下灌）+ 百分比 + Loading
//   右上角字标（对应官网右上角的 logo）
//   底部：状态小字 + 口号（口号用站点自己的副标题）
//
// 硬规定：不使用游戏官方素材与文案；只在首页；每会话一次；可跳过；减少动态效果时不渲染。
import { backgroundWallpaper } from "@/config";

const slogans = ((backgroundWallpaper as any)?.common?.homeText?.subtitle ?? []) as string[];
const slogan = Array.isArray(slogans) && slogans.length > 0 ? String(slogans[0]) : "In Reddened Chrysalis, I Once Rest";
---

<div id="ef-boot" data-ef-boot>
  <div class="ef-boot-rail" aria-hidden="true"><span></span></div>
  <div class="ef-boot-meter">
    <p class="ef-boot-pct" id="ef-boot-pct">0%</p>
    <p class="ef-boot-loading">Loading</p>
  </div>
  <div class="ef-boot-brand">
    <p class="ef-boot-brand-cn">LegspCpd</p>
    <p class="ef-boot-brand-en">BLOG</p>
  </div>
  <div class="ef-boot-foot">
    <p class="ef-boot-status"><span class="ef-boot-mark">▲</span> 站点资源正在加载，请稍候</p>
    {slogan && <p class="ef-boot-slogan">{slogan}</p>}
  </div>
</div>

<style>
  #ef-boot {
    position: fixed; inset: 0; z-index: 2000;
    background: var(--ef-paper); color: var(--ef-ink);
    transition: opacity 240ms var(--ef-ease-mech, ease-out);
  }
  #ef-boot.is-out { opacity: 0; pointer-events: none; }
  .ef-boot-rail {
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--ef-chip);
  }
  .ef-boot-rail > span {
    display: block; width: 100%; height: 0;
    background: var(--ef-signal);
    animation: ef-boot-rail 1400ms var(--ef-ease-snap, ease-out) forwards;
  }
  @keyframes ef-boot-rail { from { height: 0; } to { height: 100%; } }
  .ef-boot-meter {
    position: absolute; left: 22px; top: 46%;
    display: flex; align-items: baseline; gap: 10px;
  }
  .ef-boot-pct {
    margin: 0; font-size: clamp(1.6rem, 3.2vw, 2.4rem); font-weight: 800;
    font-stretch: 125%; font-variant-numeric: tabular-nums; letter-spacing: 0.01em;
  }
  .ef-boot-loading { margin: 0; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ef-ink-2); }
  .ef-boot-brand { position: absolute; right: 40px; top: 40px; text-align: right; }
  .ef-boot-brand-cn { margin: 0; font-size: clamp(1.1rem, 2.2vw, 1.6rem); font-weight: 800; font-stretch: 125%; }
  .ef-boot-brand-en {
    margin: 2px 0 0; font-size: 11px; font-weight: 700; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--ef-ink-2);
  }
  .ef-boot-foot { position: absolute; left: 0; right: 0; bottom: 52px; text-align: center; }
  .ef-boot-status { margin: 0 0 10px; font-size: 12px; color: var(--ef-ink-2); }
  .ef-boot-mark { color: var(--ef-ink); }
  .ef-boot-slogan { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  @media (max-width: 640px) {
    .ef-boot-brand { right: 20px; top: 24px; }
    .ef-boot-meter { left: 16px; }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById("ef-boot");
    if (!el) return;
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var seen = false;
    try { seen = sessionStorage.getItem("ef-boot") === "1"; } catch (e) {}
    if (reduce || seen) { el.remove(); return; }
    try { sessionStorage.setItem("ef-boot", "1"); } catch (e) {}
    document.documentElement.style.overflow = "hidden";
    var pct = document.getElementById("ef-boot-pct");
    var t0 = Date.now();
    var timer = setInterval(function () {
      var p = Math.min(100, Math.round(((Date.now() - t0) / 1400) * 100));
      if (pct) pct.textContent = p + "%";
      if (p >= 100) clearInterval(timer);
    }, 60);
    var done = false;
    function leave() {
      if (done) return;
      done = true;
      clearInterval(timer);
      el.classList.add("is-out");
      document.documentElement.style.overflow = "";
      setTimeout(function () { el.remove(); }, 300);
    }
    setTimeout(leave, 1900);
    el.addEventListener("click", leave);
    window.addEventListener("keydown", leave, { once: true });
  })();
</script>