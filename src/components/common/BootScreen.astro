---
/**
 * 官网加载屏 —— 逐字复用版。
 *
 * 来源（三处合起来才是完整的「官网那一版」）：
 *   结构  F:/web/endfield-official/index.html 里 SSR 出来的
 *         <div class="__00-Loading_container__aBijT"> 整块（.ef-work/loading-block.html）
 *   样式  F:/web/endfield-official/css/46158da72caa0121.css 里全部 16 个 .__00-Loading_* 类，
 *         原样落在 src/styles/endfield-shell.css §10（只把 rem 换成 calc(N * var(--efu))）
 *   行为  .ef-work/offjs/plain/8858-7e71d425d9268eb0.js 里那个 React 组件（线上 chunk）：
 *           · 任务数组 C 每完成一项 M+1，进度 = M / C.length
 *           · progressBar / progressText 用 framer-motion tween 500ms 跟到目标
 *           · progressText 的 onUpdate 把 parseInt(动画中的位置) 写进数字 —— 所以
 *             「百分比」不是单独算的，它就是黄条当前的位置读数（这里照此实现）
 *           · bg 的 blur 从 8px 线性收到 0
 *           · M >= C.length 时：加 .__00-Loading_leaving__IKIPd → 1500ms 后标记 loaded
 *             → 2400ms 后卸载整块
 *
 * 照抄下来的文案（一个字没改）：
 *   底图中下：OVER THE FRONTIER / INTO THE FRONT
 *   进度文字旁：Updating...
 *   百分比带 % 号，数字是 SansMedium 4.375rem，% 是 SansRegular 3.25rem
 *
 * 唯一换掉的：正中那枚「终末地」标志 → 站主的 LC 字标（public/lc-logo-horizontal.svg，
 * 官网 .Loading_logo 槽位原本就是品牌标志位）。
 */
---

<div
  id="ef-boot"
  class="__00-Loading_container__aBijT"
  data-ef-boot
  role="status"
  aria-label="页面加载中"
>
  <div class="__00-Loading_bg__mahvH" aria-hidden="true"></div>

  <div class="__00-Loading_logo__IaIBj">
    <img
      class="ef-boot-brandmark"
      src="/lc-logo-horizontal.svg"
      alt="LC"
      width="1200"
      height="500"
      decoding="async"
      style="display:block;width:100%;height:auto"
    />
  </div>

  <div class="__00-Loading_moreDeco__rmGYb" aria-hidden="true">
    <div class="__00-Loading_deco__EFg6B"></div>
    <div class="__00-Loading_divider__nnOZ0"></div>
    <div class="__00-Loading_slogan__54Pmd">OVER THE FRONTIER / INTO THE FRONT</div>
    <div class="__00-Loading_triangles__y5flj"></div>
  </div>

  <div class="__00-Loading_progress__649iN">
    <div class="__00-Loading_progressBar__eFmW1" data-ef-boot-bar></div>
    <div class="__00-Loading_progressText__EwQ1g" data-ef-boot-text>
      <div class="__00-Loading_core__K_Z5a">
        <span class="__00-Loading_value__Zf_CS" data-ef-boot-value>0</span><span
          class="__00-Loading_symbol__2HzCd">%</span
        >
      </div>
      <div class="__00-Loading_deco__EFg6B">Updating...</div>
    </div>
  </div>
</div>

<style>
  /* 官网 .Loading_container svg{display:block;width:100%;height:auto} —— 我们这里换成
     LC 字标（svg 或 png），几何规则一模一样。 */
  .__00-Loading_container__aBijT .ef-boot-brandmark {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById("ef-boot");
    if (!el) return;

    var bar = el.querySelector("[data-ef-boot-bar]");
    var text = el.querySelector("[data-ef-boot-text]");
    var value = el.querySelector("[data-ef-boot-value]");
    var bg = el.querySelector(".__00-Loading_bg__mahvH");
    var reduce =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.documentElement.style.overflow = "hidden";

    /* ---- 任务表：照官网那个 C 数组（每项是一个 Promise，完成即 M+1）----------- */
    var tasks = [];

    // 1) 字体
    if (document.fonts && document.fonts.ready) tasks.push(document.fonts.ready);

    /* 2) 官网那个数组装的是「逐张预加载页面图片」（226 chunk 里的 aJ：
           () => preload(require("...png").src) × 30 余张）。本站照同一套语义 ——
           数文档里已经出现的 <img>，一张一项，落在 12 张。**不等 window load**：
           那会把 AdSense / Pagefind 这些跟首屏无关的东西也算进去，站主看到的就是
           一次几秒钟的黑屏，与官网的「等图」不是一回事。 */

    // 2) swup 就位（本站站内跳转依赖它，首页那几个容器没挂上就会整站重载）
    tasks.push(
      new Promise(function (res) {
        if (window.swup) return res();
        var t = setInterval(function () {
          if (window.swup) { clearInterval(t); res(); }
        }, 80);
        setTimeout(function () { clearInterval(t); res(); }, 3000);
      })
    );

    // 3) 文档里已经出现的 <img>（官网是预加载图，本站是首屏配图 / 头像）
    var imgs = [].slice.call(document.images || []).slice(0, 12);
    imgs.forEach(function (img) {
      tasks.push(
        new Promise(function (res) {
          if (img.complete) return res();
          img.addEventListener("load", function () { res(); }, { once: true });
          img.addEventListener("error", function () { res(); }, { once: true });
        })
      );
    });

    // 4) 最短可见时长。官网靠游戏资源天然拖到 1.5s 以上；本站是静态站，不补这一档
    //    的话 0% → 100% 会在两帧里跳完，那四个相位就看不见了。
    //    从**文档起点**算 700ms（不是从这行脚本算）：HTML 到得晚时自动缩短等待，
    //    leaving 永远落在导航后 ~0.7s，黄条扫过 ≈1.2s、整屏黄 ≈1.7s 就都对得上。
    tasks.push(
      new Promise(function (res) {
        var left = 700 - performance.now();
        setTimeout(res, left > 0 ? left : 0);
      })
    );

    var total = tasks.length || 1;
    var done = 0;

    /* ---- 进度动画：官网 500ms tween + spring(stiffness 120, damping 20) ---------
       spring 的阻尼比 ζ = 20 / (2·√120) ≈ 0.91，约 0.5s 落定；这里用同一时间常数的
       指数逼近复现，帧率无关。数字读的是**动画中的位置**，与官网 onUpdate 一致。 ---- */
    var target = 0;
    var shown = 0;
    var last = 0;
    var TAU = 170; // ms，≈ 官网 spring 的落定时间常数
    var landscape = window.matchMedia("(orientation: landscape)").matches;

    function paint(p) {
      var v = p.toFixed(2);
      if (landscape) {
        bar.style.width = "100%";
        bar.style.height = v + "%";
        text.style.top = v + "%";
        text.style.left = "3.125rem";
      } else {
        bar.style.width = v + "%";
        bar.style.height = "100%";
        text.style.top = "unset";
        text.style.left = v + "%";
      }
      if (bg) bg.style.filter = "blur(" + (8 - (p / 100) * 8).toFixed(3) + "px)";
      if (value) value.textContent = String(parseInt(v, 10) || 0);
    }

    function tick(now) {
      if (!last) last = now;
      var dt = Math.min(now - last, 100);
      last = now;
      if (reduce) {
        shown = target;
      } else {
        shown = target + (shown - target) * Math.exp(-dt / TAU);
        if (Math.abs(shown - target) < 0.02) shown = target;
      }
      paint(shown);
      if (shown !== target || !leaving) raf = requestAnimationFrame(tick);
    }

    var raf = requestAnimationFrame(tick);
    paint(0);

    /* ---- 任务完成 → M+1（与官网同一套 finally 语义）------------------------- */
    var leaving = false;
    var failSafe = setTimeout(finishTasks, 15000);

    function bump() {
      done = Math.min(done + 1, total);
      target = (done / total) * 100;
      if (done >= total) finishTasks();
    }

    function finishTasks() {
      clearTimeout(failSafe);
      if (leaving) return;
      leaving = true;
      // 官网：onFinished → setLeaving(true)；1500ms 后 loaded；2400ms 后卸载
      el.classList.add("__00-Loading_leaving__IKIPd");
      document.documentElement.style.overflow = "";
      setTimeout(function () {
        if (el.parentNode) el.parentNode.removeChild(el);
        cancelAnimationFrame(raf);
      }, 2400);
    }

    /* 注意：tasks 里装的是 Promise 本体，不是函数 —— 必须 Promise.resolve(t)。
       之前写成 .then(t) 时 then 收到非函数会直接跳过，全部任务在微任务里瞬间
       完成，loading 会在解析 HTML 的那一帧就加上 leaving（等于没显示）。 */
    tasks.forEach(function (t) {
      Promise.resolve(t)
        .catch(function () {})
        .then(bump);
    });

    // 兜底：脚本要是被 swup 之外的路径重放，也不会把 html 的滚动条永久锁死
    window.addEventListener("pagehide", function () {
      document.documentElement.style.overflow = "";
    });
  })();
</script>
