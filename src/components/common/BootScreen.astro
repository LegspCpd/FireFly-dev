---
// 登入式加载动画 —— 对齐站主在官网看到的那一版（竖向）
//   左边缘一条细竖条（3px）从上往下灌黄；
//   百分比大字在左下、Loading 紧随其下；
//   字标居中偏右；底部状态小字 + 口号；
//   深色底恒不透明。不依赖断点，任何窗口都是这一套。
//
// 硬规定：不使用游戏官方素材与文案；只在首页；每会话一次；可跳过；减少动态效果时不渲染。
import { backgroundWallpaper } from "@/config";

const slogans = ((backgroundWallpaper as any)?.common?.homeText?.subtitle ?? []) as string[];
const slogan = Array.isArray(slogans) && slogans.length > 0 ? String(slogans[0]) : "In Reddened Chrysalis, I Once Rest";
---

<div id="ef-boot" data-ef-boot>
  <div class="ef-boot-rail" aria-hidden="true"><span></span></div>
  <div class="ef-boot-brand">
    <span class="ef-boot-brand-cn">LegspCpd</span>
    <span class="ef-boot-brand-en">BLOG</span>
  </div>
  <div class="ef-boot-meter">
    <span class="ef-boot-pct" id="ef-boot-pct">0%</span>
    <span class="ef-boot-loading">Loading</span>
  </div>
  <div class="ef-boot-foot">
    <p class="ef-boot-status"><span class="ef-boot-mark">▲</span> 站点资源正在加载，请稍候</p>
    {slogan && <p class="ef-boot-slogan">{slogan}</p>}
  </div>
</div>

<style>
  #ef-boot {
    position: fixed; inset: 0; z-index: 99999;
    background: #141414; color: #fff;
    transition: opacity 200ms var(--ef-ease-mech, ease-out);
  }
  /* 退出转场（照官网 .Loading_container.leaving 的确切参数）：
     先一整层黄色从左侧扫过整屏（0.6s cubic-bezier(1,0,.7,1)，延迟 0.5s），
     然后整块在延迟 1.4s 后用 1s 淡出。 */
  #ef-boot.is-leaving {
    transition: opacity 1s 1.4s;
    opacity: 0;
    pointer-events: none;
  }
  #ef-boot.is-leaving::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: #fffa00;
    transform-origin: left;
    transform: scaleX(0);
    animation: ef-boot-wipe 0.6s cubic-bezier(1, 0, 0.7, 1) 0.5s forwards;
  }
  @keyframes ef-boot-wipe {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  /* 左侧竖向进度条：3px 贴边，轨道暗淡，填充黄，从上往下灌 */
  .ef-boot-rail {
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: rgba(255, 255, 255, 0.14);
  }
  .ef-boot-rail > span {
    display: block; width: 100%; height: 0; background: #fffa00;
    animation: ef-boot-rail 2400ms var(--ef-ease-snap, ease-out) forwards;
  }
  @keyframes ef-boot-rail { from { height: 0; } to { height: 100%; } }
  /* 百分比：左下，Loading 紧随其下（官网就是这个位置关系） */
  .ef-boot-meter {
    position: absolute; left: 26px; bottom: 24%;
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
  }
  .ef-boot-pct {
    font-size: 4.375rem; line-height: 1; font-weight: 500;
    font-stretch: 112%; font-variant-numeric: tabular-nums;
  }
  .ef-boot-loading {
    font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.66);
  }
  /* 字标：居中偏右 */
  .ef-boot-brand { position: absolute; left: 64%; top: 32%; }
  .ef-boot-brand-cn { display: block; font-size: 2rem; font-weight: 800; font-stretch: 125%; letter-spacing: 0.02em; }
  .ef-boot-brand-en { display: block; margin-top: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.66); }
  /* 底部：状态 + 口号 */
  .ef-boot-foot { position: absolute; left: 0; right: 0; bottom: 9%; text-align: center; }
  .ef-boot-status { margin: 0 0 10px; font-size: 12px; color: rgba(255, 255, 255, 0.6); }
  .ef-boot-mark { color: #fffa00; }
  .ef-boot-slogan { margin: 0; font-size: 1.25rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  @media (max-width: 720px) {
    .ef-boot-pct { font-size: 2.8rem; }
    .ef-boot-brand { left: 58%; top: 30%; }
    .ef-boot-brand-cn { font-size: 1.4rem; }
    .ef-boot-slogan { font-size: 1rem; }
    .ef-boot-meter { left: 18px; bottom: 26%; }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById("ef-boot");
    if (!el) return;
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var seen = false;
    try { seen = sessionStorage.getItem("ef-boot") === "1"; } catch (e) {}
    if (reduce || seen) { el.remove(); return; }
    try { sessionStorage.setItem("ef-boot", "1"); } catch (e) {}
    document.documentElement.style.overflow = "hidden";
    var pct = document.getElementById("ef-boot-pct");
    var t0 = Date.now();
    var timer = setInterval(function () {
      var p = Math.min(100, Math.round(((Date.now() - t0) / 2400) * 100));
      if (pct) pct.textContent = p + "%";
      if (p >= 100) clearInterval(timer);
    }, 60);
    var done = false;
    function leave() {
      if (done) return;
      done = true;
      clearInterval(timer);
      el.classList.add("is-leaving");
      document.documentElement.style.overflow = "";
      setTimeout(function () { el.remove(); }, 3600);
    }
    setTimeout(leave, 3400);
    el.addEventListener("click", leave);
    window.addEventListener("keydown", leave, { once: true });
  })();
</script>