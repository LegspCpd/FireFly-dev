---
// 首页第 02 章起：按《终末地》官网的章节制排布（章节编号 + 标题 + 记录行 / ledger）
//   02 文章 · 03 分类与标签 · 04 友链 · 05 关于
//   全部使用套件的 ef-* 类（ef-records / ef-record / ef-tag / ef-ledger / ef-field），
//   这些类已全局引入，渲染出来即官网形态；No. 用真实序号（按时间排序的位置）。
interface Rec { no: string; date: string; name: string; url: string; words?: string }
interface Led { name: string; count: number; url: string }
interface Props {
	posts: Rec[];
	categories: Led[];
	tags: Led[];
	links: { name: string; url: string; desc?: string }[];
	stats: { key: string; value: string }[];
}
const { posts, categories, tags, links, stats } = Astro.props;
---

<!-- 02 文章 -->
<section class="ef-sec" id="ef-sec-02">
  <p class="ef-eyebrow">// 02 ARTICLES</p>
  <div class="ef-sec-head">
    <h2 class="ef-sec-title">文章</h2>
    <span class="ef-field">共 {posts.length} 篇</span>
  </div>
  <ol class="ef-records">
    {posts.map((p) => (
      <li>
        <a class="ef-record" href={p.url}>
          <span class="ef-tag">No.{p.no}</span>
          <time class="ef-field">{p.date}</time>
          <span class="ef-record-name">{p.name}</span>
          {p.words ? <span class="ef-field">{p.words} 字</span> : null}
        </a>
      </li>
    ))}
  </ol>
  <p class="ef-sec-more"><a href="/archive/">全部文章 →</a></p>
</section>

<!-- 03 分类与标签 -->
<section class="ef-sec" id="ef-sec-03">
  <p class="ef-eyebrow">// 03 TAXONOMY</p>
  <div class="ef-sec-head">
    <h2 class="ef-sec-title">分类与标签</h2>
    <span class="ef-field">{categories.length} 个分类 · {tags.length} 个标签</span>
  </div>
  <div class="ef-sec-cols">
    <div>
      <h3 class="ef-field ef-sub">分类</h3>
      <ul class="ef-ledger">
        {categories.map((c) => (
          <li><a href={c.url}>{c.name}</a><span class="ef-field">{c.count} 篇</span></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="ef-field ef-sub">标签</h3>
      <ul class="ef-ledger">
        {tags.map((t) => (
          <li><a href={t.url}>{t.name}</a><span class="ef-field">{t.count} 篇</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- 04 友链 -->
<section class="ef-sec" id="ef-sec-04">
  <p class="ef-eyebrow">// 04 LINKS</p>
  <div class="ef-sec-head">
    <h2 class="ef-sec-title">友链</h2>
    <span class="ef-field">共 {links.length} 位</span>
  </div>
  <ol class="ef-records">
    {links.map((l, i) => (
      <li>
        <a class="ef-record" href={l.url} rel="noopener">
          <span class="ef-tag">No.{String(i + 1).padStart(3, "0")}</span>
          <span class="ef-record-name">{l.name}</span>
          <span class="ef-field">{l.desc || "—"}</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="ef-sec-more"><a href="/friends/">友链页与申请 →</a></p>
</section>

<!-- 05 关于 -->
<section class="ef-sec" id="ef-sec-05">
  <p class="ef-eyebrow">// 05 ABOUT</p>
  <div class="ef-sec-head">
    <h2 class="ef-sec-title">关于</h2>
    <span class="ef-field">站点信息</span>
  </div>
  <ul class="ef-ledger ef-ledger-wide">
    {stats.map((s) => (
      <li><span>{s.key}</span><span class="ef-field">{s.value}</span></li>
    ))}
  </ul>
  <p class="ef-sec-more"><a href="/about/">关于本站 →</a></p>
</section>

<style>
  .ef-sec {
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--ef-rule);
  }
  .ef-sec-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 0.6rem; margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--ef-rule);
  }
  .ef-sec-title { margin: 0.15rem 0 0; font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 800; font-stretch: 118%; letter-spacing: -0.01em; color: var(--ef-ink); }
  .ef-sec-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2.5rem; }
  .ef-sub { margin: 0 0 0.4rem; font-weight: 700; color: var(--ef-ink); }
  .ef-record-name { font-weight: 600; color: var(--ef-ink); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ef-sec-more { margin: 0.9rem 0 0; font-size: 0.85rem; }
  .ef-sec-more a { color: var(--ef-ink-2); text-decoration: none; }
  .ef-sec-more a:hover { color: var(--ef-signal); }
  .ef-ledger-wide li { grid-template-columns: 8rem minmax(0, 1fr); }
  @media (max-width: 720px) { .ef-sec-cols { grid-template-columns: minmax(0, 1fr); gap: 1.5rem 0; } }
</style>