---
// 首页页头 —— 官网式的正式页头（替代博客主题的导航栏）
//   固定顶部 + 底部细线；左侧品牌（宽体大写拉丁 + 粗体中文，skill 的中英成对写法）；
//   中间导航（当前项用强调色标记）；右侧主题切换 + 主行动入口。
//   不使用主题导航栏里的搜索框/音乐/壁纸切换等博客组件。
---

<header class="ef-header">
  <div class="ef-header-inner">
    <a class="ef-header-brand no-styling" href="/">
      <span class="ef-header-brand-cn">LegspCpd</span>
      <span class="ef-header-brand-en">BLOG</span>
    </a>

    <nav class="ef-header-nav" aria-label="主导航">
      <a href="/" aria-current="page">首页</a>
      <a href="/archive/">文章</a>
      <a href="/categories/">分类</a>
      <a href="/tags/">标签</a>
      <a href="/friends/">友链</a>
      <a href="/about/">关于</a>
    </nav>

    <div class="ef-header-actions">
      <a class="ef-header-search no-styling" href="/search/" aria-label="搜索">搜索</a>
      <button type="button" class="ef-theme-toggle" aria-label="切换深浅色">
        <span data-ef-theme-label>深浅</span>
      </button>
      <a class="ef-btn primary ef-header-cta" href="/archive/">浏览全部文章</a>
    </div>
  </div>
</header>
<div class="ef-header-spacer" aria-hidden="true"></div>

<style>
  .ef-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 900;
    background: color-mix(in srgb, var(--ef-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--ef-rule);
  }
  .ef-header-inner {
    max-width: var(--page-width, 72rem); margin: 0 auto;
    display: flex; align-items: center; gap: 1rem;
    padding: 0.55rem clamp(0.75rem, 3vw, 1.5rem);
  }
  .ef-header-brand { display: inline-flex; align-items: baseline; gap: 0.4rem; text-decoration: none; }
  .ef-header-brand-cn { font-size: 1.05rem; font-weight: 800; font-stretch: 118%; color: var(--ef-ink); }
  .ef-header-brand-en { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.24em; color: var(--ef-ink-2); }
  .ef-header-nav { display: flex; align-items: center; gap: 0.15rem; margin-left: auto; flex-wrap: wrap; }
  .ef-header-nav a {
    position: relative; text-decoration: none;
    padding: 0.35rem 0.6rem; font-size: 0.86rem; font-weight: 600; color: var(--ef-ink-2);
    border-radius: 0;
  }
  .ef-header-nav a:hover { color: var(--ef-ink); }
  /* 当前位置：底部一条实心短条（skill：位置标记用 trace，浅墨 / 深黄） */
  .ef-header-nav a[aria-current="page"] { color: var(--ef-ink); font-weight: 700; }
  .ef-header-nav a[aria-current="page"]::after {
    content: ""; position: absolute; left: 0.6rem; right: 0.6rem; bottom: -0.15rem;
    height: 2px; background: var(--ef-trace, var(--ef-ink));
  }
  .ef-header-actions { display: flex; align-items: center; gap: 0.5rem; margin-left: 0.75rem; }
  .ef-theme-toggle {
    font: inherit; font-size: 0.82rem; color: var(--ef-ink-2);
    background: var(--ef-chip); border: 0; padding: 0.35rem 0.7rem; cursor: pointer;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }
  .ef-header-cta { font-size: 0.82rem; padding: 0.4rem 0.9rem; }
  .ef-header-spacer { height: 3.2rem; }
  .ef-header-search {
    font-size: 0.8rem; color: var(--ef-ink-2); text-decoration: none;
    padding: 0.35rem 0.6rem; border: 1px solid var(--ef-rule);
  }
  .ef-header-search:hover { color: var(--ef-ink); border-color: var(--ef-ink); }
  /* 窄屏：页头折成两行 —— 第一行品牌 + 操作，第二行可横向滚动的导航（保证手机端能导航） */
  @media (max-width: 900px) {
    .ef-header-inner { flex-wrap: wrap; row-gap: 0.35rem; }
    .ef-header-cta { display: none; }
    .ef-header-nav {
      order: 3; width: 100%; margin-left: 0;
      overflow-x: auto; flex-wrap: nowrap; gap: 0.1rem;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    .ef-header-nav::-webkit-scrollbar { display: none; }
    .ef-header-nav a { white-space: nowrap; padding: 0.3rem 0.5rem; }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.querySelector(".ef-theme-toggle");
    var label = document.querySelector("[data-ef-theme-label]");
    if (!btn) return;
    function sync() {
      var dark = document.documentElement.classList.contains("dark");
      if (label) label.textContent = dark ? "浅色" : "深色";
    }
    btn.addEventListener("click", function () {
      var root = document.documentElement;
      var next = root.classList.contains("dark") ? "light" : "dark";
      root.classList.toggle("dark", next === "dark");
      try { localStorage.setItem("theme", next); } catch (e) {}
      sync();
    });
    sync();
  })();
</script>