---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a
    href={url}
    aria-label={label}
    class:list={`
            flex
            items-center
            focus-ring-inset
            w-full
            h-10
            rounded-lg
            bg-none
            hover:bg-(--btn-plain-bg-hover)
            active:bg-(--btn-plain-bg-active)
            transition-all
            pl-2
            hover:pl-3
            
            text-neutral-700
            hover:text-(--primary)
            dark:text-neutral-300
            dark:hover:text-(--primary)
        `
    }
>
    <div class="flex w-full min-w-0 items-center justify-between relative mr-2">
        <div class="overflow-hidden text-left whitespace-nowrap text-ellipsis">
            <slot></slot>
        </div>
        {/* endfield-ui：计数用 chip 底 + 墨字（原来是 text-(--btn-content) 配
            dark:bg-(--primary)，--primary 改成墨色后暗色下变成浅底浅字，只剩白方块）。
            切角表示可点击。 */}
        { badge !== undefined && badge !== null && badge !== '' &&
            <div class="ef-cut transition px-2 h-7 ml-4 min-w-8 text-sm font-bold
                bg-(--ef-chip) text-(--ef-ink)
                flex items-center justify-center">
                { badge }
            </div>
        }
    </div>
</a>