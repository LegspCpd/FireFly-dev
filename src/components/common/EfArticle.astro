---
// 文章页 —— 按《终末地》官网骨架重写的表现层（结构取自 skill 的 templates/reading.html）
//   // 眉标 → 面包屑 → No. 标签 + 分类 + 标签 → 字段行 → 大标题 → 三色条 → 摘要 → 正文 →
//   记录行相关文章 → 右侧 margin（目录 / 统计）
//   类名用套件的 ef-*（已全局引入 public/endfield-ui/endfield.css）；
//   不使用套件里 .title/.name/.ids 这类通用名，避免和 Firefly 主题撞。

interface Props {
	title: string;
	no?: number | null;
	published?: Date | null;
	category?: string | null;
	tags?: string[] | null;
	words?: number | null;
	minutes?: number | null;
	lede?: string | null;
	breadcrumb?: { name: string; url: string }[];
}

const { title, no, published, category, tags, words, minutes, lede, breadcrumb = [] } = Astro.props;
const tagList = tags ?? [];
const dateText = published ? published.toISOString().slice(0, 10).replace(/-/g, ".") : "";
---

<div class="ef-sheet-wrap">
<div class="ef-article-layout">
<div class="ef-article-main">
  <p class="ef-eyebrow">// POST</p>

  {
    breadcrumb.length > 0 && (
      <p class="ef-crumb ef-field">
        {breadcrumb.map((b) => (
          <a href={b.url}>{b.name}</a>
        ))}
      </p>
    )
  }

  <p class="ef-ids">
    {no ? <span class="ef-tag">No.{String(no).padStart(3, "0")}</span> : null}
    {
      category && (
        <span class="ef-kv">
          <span>分类</span>
          <span>{category}</span>
        </span>
      )
    }
    {
      tagList.slice(0, 4).map((t) => (
        <span class="ef-state">{t}</span>
      ))
    }
  </p>

  <ul class="ef-facts ef-field">
    {dateText && <li><time datetime={published?.toISOString()}>{dateText}</time></li>}
    {words ? <li>{words.toLocaleString("en-US")} 字</li> : null}
    {minutes ? <li>约 {minutes} 分钟</li> : null}
  </ul>

  <h1 class="ef-article-title ef-read" data-pagefind-weight="10" data-pagefind-meta="title">{title}</h1>
  <div class="ef-tri" aria-hidden="true"><i></i><i></i><i></i></div>

  {lede && <p class="ef-lede ef-read">{lede}</p>}

  <div class="ef-prose">
    <slot />
  </div>

  <slot name="after" />
</div>

  <!-- 右侧 margin：目录 + 本页信息（官网右栏结构） -->
  <aside class="ef-article-margin" aria-label="本页目录">
    <div class="ef-margin-block">
      <p class="ef-field ef-margin-title">目录</p>
      <ul class="ef-margin-toc" id="ef-toc"></ul>
    </div>
    <div class="ef-margin-block">
      <p class="ef-field ef-margin-title">本页</p>
      <ul class="ef-ledger">
        {dateText && <li><span>日期</span><span class="ef-field">{dateText}</span></li>}
        {words ? <li><span>字数</span><span class="ef-field">{words.toLocaleString("en-US")}</span></li> : null}
        {minutes ? <li><span>时长</span><span class="ef-field">约 {minutes} 分钟</span></li> : null}
        {category && <li><span>分类</span><span class="ef-field">{category}</span></li>}
        {tagList.length > 0 && <li><span>标签</span><span class="ef-field">{tagList.length} 个</span></li>}
      </ul>
    </div>
  </aside>
</div>
</div>

<style>
  .ef-sheet-wrap {
    background: var(--ef-panel);
    padding: clamp(1.25rem, 4vw, 2.75rem) var(--ef-pad, 1.25rem) 2.5rem;
  }
  .ef-crumb { display: flex; flex-wrap: wrap; gap: 0 0.5rem; margin: 0.15rem 0 0.6rem; }
  .ef-crumb a { color: var(--ef-ink-2); text-decoration: none; }
  .ef-crumb a + a::before { content: "/"; margin-right: 0.5rem; color: var(--ef-ink-2); }
  .ef-ids { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.5rem; margin: 0 0 0.75rem; }
  .ef-article-title {
    margin: 0.2rem 0 0.9rem;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    font-weight: 800; font-stretch: 118%; line-height: 1.24; letter-spacing: -0.01em;
    color: var(--ef-ink);
  }
  #ef-article .ef-tri, .ef-sheet-wrap .ef-tri { max-width: 100%; margin-bottom: 1.1rem; }
  .ef-lede { margin: 0 0 1.6rem; font-size: 1.0625rem; line-height: 1.8; color: var(--ef-ink-2); }
  /* 两栏：正文 + 右侧 margin */
  /* 正文由主题的 #post-container 承载（不在本组件 slot 内），所以右栏用浮动目录，不套两栏网格 */
  .ef-article-layout { display: block; max-width: none; }
  .ef-article-main { min-width: 0; }
  .ef-article-margin {
    position: fixed; top: 5.5rem; right: max(1rem, calc((100vw - 60rem) / 2 - 15rem));
    width: 13rem; max-height: calc(100vh - 7rem); overflow: auto;
    display: flex; flex-direction: column; gap: 1.2rem; z-index: 5;
  }
  @media (max-width: 1280px) { .ef-article-margin { display: none; } }
  .ef-margin-title { margin: 0 0 0.45rem; padding-bottom: 0.35rem; border-bottom: 1px solid var(--ef-rule); }
  .ef-margin-toc { list-style: none; margin: 0; padding: 0; }
  .ef-margin-toc a {
    display: block; padding: 0.28rem 0 0.28rem 0.6rem;
    border-left: 2px solid transparent;
    color: var(--ef-ink-2); text-decoration: none;
    font-size: 0.82rem; line-height: 1.5;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .ef-margin-toc a:hover { color: var(--ef-ink); }
  .ef-margin-toc a.is-current { border-left-color: var(--ef-signal); color: var(--ef-ink); }
  .ef-margin-toc .is-3 { padding-left: 1.3rem; font-size: 0.78rem; }
  @media (max-width: 1279px) {
    .ef-article-margin { display: none; }
  }
</style>

<script is:inline>
  (function () {
    function build() {
      var toc = document.getElementById("ef-toc");
      var prose = document.querySelector("#post-container .custom-md") || document.querySelector(".custom-md") || document.querySelector(".ef-prose");
      if (!toc || !prose) return;
      var hs = prose.querySelectorAll("h2, h3");
      if (!hs.length) { var blk = toc.closest(".ef-margin-block"); if (blk) blk.style.display = "none"; return; }
      toc.innerHTML = "";
      var links = [];
      for (var i = 0; i < hs.length; i++) {
        var el = hs[i];
        var raw = (el.textContent || "").replace(/#\s*$/, "").trim();
        // 跳过正文里那个「目录」标题与空标题
        if (!raw || /^(目录|table of contents|toc)$/i.test(raw)) continue;
        if (!el.id) el.id = "ef-h-" + i;
        var li = document.createElement("li");
        var a = document.createElement("a");
        a.href = "#" + el.id;
        a.textContent = raw.slice(0, 40);
        if (el.tagName === "H3") a.className = "is-3";
        a.dataset.id = el.id;
        li.appendChild(a); toc.appendChild(li); links.push(a);
      }
      if (!("IntersectionObserver" in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          links.forEach(function (a) { a.classList.toggle("is-current", a.dataset.id === en.target.id); });
        });
      }, { rootMargin: "-12% 0px -70% 0px" });
      for (var j = 0; j < hs.length; j++) io.observe(hs[j]);
    }
    // 本脚本在文档中部执行，正文还没解析出来 → 等 DOM 就绪，并做有限重试
    function boot() {
      build();
      var tries = 0;
      var t = setInterval(function () {
        tries++;
        if (document.querySelectorAll("#ef-toc a").length > 0 || tries > 12) clearInterval(t);
        else build();
      }, 300);
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
    else boot();
    document.addEventListener("swup:page:view", function () { setTimeout(boot, 80); });
  })();
</script>