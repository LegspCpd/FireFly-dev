---
// 文章页 —— 按《终末地》官网骨架重写的表现层（结构取自 skill 的 templates/reading.html）
//   // 眉标 → 面包屑 → No. 标签 + 分类 + 标签 → 字段行 → 大标题 → 三色条 → 摘要 → 正文 →
//   记录行相关文章 → 右侧 margin（目录 / 统计）
//   类名用套件的 ef-*（已全局引入 public/endfield-ui/endfield.css）；
//   不使用套件里 .title/.name/.ids 这类通用名，避免和 Firefly 主题撞。

interface Props {
	title: string;
	/* 有正文目录时给右侧 margin 一栏（目录 + 返回顶部）留位置 */
	margin?: boolean;
	no?: number | null;
	published?: Date | null;
	category?: string | null;
	tags?: string[] | null;
	words?: number | null;
	minutes?: number | null;
	lede?: string | null;
	breadcrumb?: { name: string; url: string }[];
}

const { title, no, published, category, tags, words, minutes, lede, breadcrumb = [], margin = false } = Astro.props;
const tagList = tags ?? [];
const dateText = published ? published.toISOString().slice(0, 10).replace(/-/g, ".") : "";
---

<div class="ef-sheet-wrap">
<div class="ef-article-layout" data-margin={margin ? "" : undefined}>
<div class="ef-article-main">
  <p class="ef-eyebrow">// POST</p>

  {
    breadcrumb.length > 0 && (
      <p class="ef-crumb ef-field">
        {breadcrumb.map((b) => (
          <a href={b.url}>{b.name}</a>
        ))}
      </p>
    )
  }

  <p class="ef-ids" data-replay="ef-in-power" style="--i: 0">
    {no ? <span class="ef-tag">No.{String(no).padStart(3, "0")}</span> : null}
    {
      category && (
        <span class="ef-kv">
          <span>分类</span>
          <span>{category}</span>
        </span>
      )
    }
    {
      tagList.slice(0, 4).map((t) => (
        <span class="ef-state">{t}</span>
      ))
    }
  </p>

  <ul class="ef-facts ef-field" data-replay="ef-in-power" style="--i: 1">
    {dateText && <li><time datetime={published?.toISOString()}>{dateText}</time></li>}
    {words ? <li>{words.toLocaleString("en-US")} 字</li> : null}
    {minutes ? <li>约 {minutes} 分钟</li> : null}
  </ul>

  <h1 class="ef-article-title ef-read" data-replay="ef-in-power" style="--i: 2" data-pagefind-weight="10" data-pagefind-meta="title">{title}</h1>
  <div class="ef-tri" data-replay="ef-in-sweep" aria-hidden="true"><i></i><i></i><i></i></div>

  {lede && <p class="ef-lede ef-read" data-replay="ef-in-power" style="--i: 3">{lede}</p>}

  <div class="ef-prose">
    <slot />
  </div>

  <slot name="after" />
</div>

<!-- 右侧 margin：目录（sticky）+ 返回顶部。窄屏与没有目录时不占位。 -->
<div class="ef-article-margin"><slot name="margin" /></div>
</div>
</div>

<style>
  .ef-sheet-wrap {
    background: var(--ef-panel);
    padding: clamp(1.25rem, 4vw, 2.75rem) var(--ef-pad, 1.25rem) 2.5rem;
  }
  .ef-crumb { display: flex; flex-wrap: wrap; gap: 0 0.5rem; margin: 0.15rem 0 0.6rem; font-size: var(--ef-fs-nav); line-height: var(--ef-lh-ui); }
  .ef-crumb a { color: var(--ef-ink-2); text-decoration: none; }
  .ef-crumb a + a::before { content: "/"; margin-right: 0.5rem; color: var(--ef-ink-2); }
  .ef-ids { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.5rem; margin: 0 0 0.75rem; }
  /* 字段行照官网：日期/编号走 SansRegular 1.5rem；状态片（标签）保持小一号 */
  .ef-facts { font-family: var(--ef-font-regular); letter-spacing: normal; }
  .ef-ids .ef-state { font-size: var(--ef-fs-nav); }
  /* 字级/字重/行高/字距全部走 §51 的官网 token（官网 NoticeDetail_title：
     3rem / 4.375rem 行高 / SansBold；font-stretch 只对可变宽度字体有意义，
     Gilroy 与 Novecentosanswide 是静态字重，去掉） */
  .ef-article-title {
    margin: 0.2rem 0 0.9rem;
    font-family: var(--ef-font-bold);
    font-size: var(--ef-fs-title);
    font-weight: 400;
    line-height: var(--ef-lh-title);
    color: var(--ef-ink);
  }
  #ef-article .ef-tri, .ef-sheet-wrap .ef-tri { max-width: 100%; margin-bottom: 1.1rem; }
  :global(.ef-dedupe) { display: none !important; }
  /* 官网导语 = 1.875rem / line-height 1.5（GameplayAlbum description） */
  .ef-lede { margin: 0 0 1.6rem; font-size: var(--ef-fs-lede); line-height: var(--ef-lh-ui); color: var(--ef-ink-2); }
  /* 两栏：正文 + 右侧 margin（有目录时才开第二栏） */
  .ef-article-layout {
    display: grid;
    gap: calc(2.5 * var(--efu));
    grid-template-columns: minmax(0, 1fr);
  }
  .ef-article-layout[data-margin] {
    grid-template-columns: minmax(0, 1fr) calc(15 * var(--efu));
  }
  .ef-article-margin { display: none; }
  .ef-article-layout[data-margin] .ef-article-margin { display: block; }
  @media (max-width: 1180px) {
    .ef-article-layout[data-margin] { grid-template-columns: minmax(0, 1fr); }
    .ef-article-layout[data-margin] .ef-article-margin { display: none; }
  }
</style>

<script is:inline>
  // 正文首个小标题常与文章标题重复（主题把标题也写进了正文）→ 相同则隐藏
  (function () {
    function dedupe() {
      var h1 = document.querySelector(".ef-article-title");
      var md = document.querySelector("#post-container .custom-md") || document.querySelector(".custom-md");
      if (!h1 || !md) return;
      var title = (h1.textContent || "").replace(/\s+/g, "");
      var hs = md.querySelectorAll("h1, h2, h3");
      for (var i = 0; i < Math.min(hs.length, 2); i++) {
        var t = (hs[i].textContent || "").replace(/[#\s]/g, "");
        if (t && title && (t === title || title.indexOf(t) === 0 || t.indexOf(title) === 0)) {
          hs[i].classList.add("ef-dedupe");
        }
      }
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", dedupe); else dedupe();
    document.addEventListener("swup:page:view", function () { setTimeout(dedupe, 80); });
  })();
</script>
