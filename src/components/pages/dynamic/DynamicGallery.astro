---
import { Icon } from "astro-icon/components";
import EfIcon from "@components/common/EfIcon.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	sourceId: string;
}

const { sourceId } = Astro.props;
---

<dynamic-gallery
	class="page-gallery"
	data-source-id={sourceId}
	data-view-image={i18n(I18nKey.dynamicViewImage)}
	data-select-image={i18n(I18nKey.dynamicSelectImage)}
	hidden
>
	<div class="page-gallery-grid" data-gallery-grid></div>

	<div class="page-gallery-viewer" data-gallery-viewer hidden>
		<div class="page-gallery-toolbar">
			<button type="button" class="btn-plain page-gallery-action" data-gallery-collapse>
				<!-- 保留第三方：官网 122 个内联 svg 里没有 ✕ / 退出全屏形，取不到替代 -->
				<Icon name="material-symbols:close-fullscreen-rounded" />
				<span>{i18n(I18nKey.dynamicCollapseGallery)}</span>
			</button>
			<button
				type="button"
				class="btn-plain page-gallery-action"
				data-fancybox={`dynamic-${sourceId}`}
				data-gallery-lightbox
				data-type="image"
			>
				<EfIcon name="magnifier" />
				<span>{i18n(I18nKey.dynamicViewOriginal)}</span>
			</button>
			<span class="page-gallery-counter" data-gallery-counter aria-live="polite"></span>
		</div>

		<div class="page-gallery-stage">
			<button
				type="button"
				class="btn-plain page-gallery-nav page-gallery-prev"
				data-gallery-prev
				aria-label={i18n(I18nKey.dynamicPreviousImage)}
				title={i18n(I18nKey.dynamicPreviousImage)}
			>
				<EfIcon name="arrowSmall" style="transform: rotate(180deg)" />
			</button>
			<img class="page-gallery-main-image" data-gallery-main alt="" />
			<button
				type="button"
				class="btn-plain page-gallery-nav page-gallery-next"
				data-gallery-next
				aria-label={i18n(I18nKey.dynamicNextImage)}
				title={i18n(I18nKey.dynamicNextImage)}
			>
				<EfIcon name="arrowSmall" />
			</button>
		</div>

		<div class="page-gallery-thumbnails" data-gallery-thumbnails></div>
	</div>
</dynamic-gallery>
