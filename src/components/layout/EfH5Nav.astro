				</svg>
			</button>
		</div>

		<nav class="Header_navList__r2BGN" aria-label="站点导航">
			{
				navItems.map((item) => (
					<a
						class:list={["Header_menuItem__14H7f", { Header_active__jzCyf: on(item.href) }]}
						href={item.href}
						data-key={item.label}
						aria-current={on(item.href) ? "page" : undefined}
					>
						<svg
							class="Header_icon__3iDIG"
							viewBox={EF_ICONS[item.icon].viewBox}
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path
								fill-rule="evenodd"
								fill="currentColor"
								d={EF_ICONS[item.icon].paths[0]}
							/>
						</svg>
						<span class="Header_divider__tUYjO" aria-hidden="true"></span>
						<span class="Header_text__52fEh">{item.label}</span>
						<svg
							class="Header_arrow__LqT52"
							viewBox={arrow.viewBox}
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path fill-rule="evenodd" fill="currentColor" d={arrow.paths[0]} />
						</svg>
					</a>
				))
			}
		</nav>

		<div class="Header_mediaList__gE3ct">
			{
				mediaItems.map((item) => (
					<a
						class="Header_mediaItem__mUuKL"
						href={item.href}
						aria-label={item.label}
						target={item.ext ? "_blank" : undefined}
						rel={item.ext ? "noopener noreferrer" : undefined}
					>
						<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path fill-rule="evenodd" fill="currentColor" d={item.d} />
						</svg>
					</a>
				))
			}
		</div>

		<div class="HallowText_hollowText__OJN57 Header_hallowText__ZR39f">LC</div>
	</div>
</div>

<script is:inline>
	(function () {
		var nav = document.getElementById("ef-h5nav");
		if (!nav) return;
		var menu = nav.querySelector("[data-ef-h5-menu]");
		var toggle = nav.querySelector("[data-ef-h5-toggle]");
		var logo = nav.querySelector("[data-ef-h5-logo]");

		function setOpen(open) {
			menu.classList.toggle("Header_active__jzCyf", open);
			logo.classList.toggle("Header_active__jzCyf", open);
			nav.classList.toggle("ef-h5-open", open);
			toggle.setAttribute("aria-expanded", open ? "true" : "false");
			toggle.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
		}

		toggle.addEventListener("click", function () {
			setOpen(!menu.classList.contains("Header_active__jzCyf"));
		});

		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape") setOpen(false);
		});

		// 站内跳转走 swup：容器只换 #swup-container，顶栏与菜单不会重建 —— 点击即收起
		menu.addEventListener("click", function (e) {
			var a = e.target && e.target.closest && e.target.closest("a");
			if (a) setOpen(false);
		});

		/* 声音：与左下角音乐播放器的静音状态联动（MusicManager 暴露 window.__fireflyMusic）。
		   官网按住 mute 时图标换「静音喇叭」并转 #ccc。 */
		function syncMuted(muted) {
			nav.setAttribute("data-muted", muted ? "true" : "false");
			var btns = nav.querySelectorAll("[data-ef-h5-mute]");
			for (var i = 0; i < btns.length; i++) {
				btns[i].classList.toggle("Header_active__jzCyf", !!muted);
				btns[i].setAttribute("aria-pressed", muted ? "true" : "false");
			}
		}
		function toggleMute() {
			var m = window.__fireflyMusic;
			if (m && m.toggleMute) {
				m.toggleMute();
				syncMuted(nav.getAttribute("data-muted") !== "true");
			}
		}
		var mutes = nav.querySelectorAll("[data-ef-h5-mute]");
		for (var i = 0; i < mutes.length; i++) {
			mutes[i].addEventListener("click", function (e) {
				e.stopPropagation();
				toggleMute();
			});
		}
		if (window.__fireflyMusic && window.__fireflyMusic.isMuted) syncMuted(false);

		/* 顶栏与菜单都在 swup 容器之外，切页不重建：手动同步「当前页」高亮。 */
		function syncCurrent() {
			var path = location.pathname.replace(/\/+$/, "") || "/";
			var isHome = path === "/";
			var links = nav.querySelectorAll(".Header_menuItem__14H7f");
			for (var k = 0; k < links.length; k++) {
				var href = (links[k].getAttribute("href") || "").replace(/\/+$/, "") || "/";
				var hit = href === "/" ? isHome : path === href || path.indexOf(href + "/") === 0;
				links[k].classList.toggle("Header_active__jzCyf", hit);
				if (hit) links[k].setAttribute("aria-current", "page");
				else links[k].removeAttribute("aria-current");
			}
		}
		syncCurrent();
		document.addEventListener("swup:page:view", function () {
			setOpen(false);
			setTimeout(syncCurrent, 0);
		});
	})();
</script>
