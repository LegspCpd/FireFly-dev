const soundOn = EF_ICONS.h5SoundOn;
const soundOff = EF_ICONS.h5SoundOff;
const close = EF_ICONS.h5Close;
const hamburger = EF_ICONS.hamburger;
const search = EF_ICONS.magnifier;
const arrow = EF_ICONS.arrowLarge;
---

<div
	class="Header_h5HeaderContainer__ctquk"
	id="ef-h5nav"
	data-ef-h5nav
	data-muted="false"
>
	<a class="Header_logo__s3lE_" href="/" aria-label="LC 首页" data-ef-h5-logo>
		<img
			class="ef-h5-brandmark"
			src="/icon-192.png"
			alt="LC"
			width="192"
			height="192"
			decoding="async"
		/>
	</a>

	<div class="Header_buttonGroup___Z1Nk">
		<button
			type="button"
			class="Header_iconButton__KWPpn"
			data-ef-h5-mute
			aria-pressed="false"
			aria-label="声音开关"
		>
			<svg
				class="Header_icon__3iDIG"
				data-ef-sound-on
				viewBox={soundOn.viewBox}
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path fill-rule="evenodd" fill="currentColor" d={soundOn.paths[0]} />
			</svg>
			<svg
				class="Header_icon__3iDIG"
				data-ef-sound-off
				viewBox={soundOff.viewBox}
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path fill-rule="evenodd" fill="currentColor" d={soundOff.paths[0]} />
			</svg>
		</button>

		<a class="Header_preserveButton__StJCF" href="/search/" aria-label="站内搜索">
			<svg
				class="Header_tri__KNP87"
				viewBox={search.viewBox}
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path fill-rule="evenodd" fill="currentColor" d={search.paths[0]} />
			</svg>
			<span class="Header_divider__tUYjO" aria-hidden="true"></span>
			<span class="Header_text__52fEh">搜索</span>
		</a>
	</div>

	<button
		type="button"
		class="Header_menuIcon__X_Cn9"
		data-ef-h5-toggle
		aria-expanded="false"
		aria-controls="ef-h5-menu"
		aria-label="打开菜单"
	>
		<svg
			class="Header_icon__3iDIG"
			data-ef-h5-icon-open
			viewBox={hamburger.viewBox}
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<path fill-rule="evenodd" fill="currentColor" d={hamburger.paths[0]} />
		</svg>
		<svg
			class="Header_icon__3iDIG"
			data-ef-h5-icon-close
			viewBox={close.viewBox}
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<path fill-rule="evenodd" fill="currentColor" d={close.paths[0]} />
		</svg>
	</button>

	<div class="Header_h5Menu__Tl_yj" id="ef-h5-menu" data-ef-h5-menu>
		<div class="Header_menuButtons__IRjCZ">
			<a class="Header_button__b0gdu" href={topButtons[0].href}>
				<span class="Header_text__52fEh">{topButtons[0].label}</span>
				<span class="Header_iconWrapper__BvBAU">
					<svg
						class="Header_icon__3iDIG"
						viewBox={EF_ICONS[topButtons[0].icon].viewBox}
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path
							fill-rule="evenodd"
							fill="currentColor"
							d={EF_ICONS[topButtons[0].icon].paths[0]}
						/>
					</svg>
				</span>
			</a>
			<span class="Header_divider__tUYjO" aria-hidden="true"></span>
			<a class="Header_button__b0gdu" href={topButtons[1].href}>
				<span class="Header_text__52fEh">{topButtons[1].label}</span>
				<span class="Header_iconWrapper__BvBAU">
					<svg
						class="Header_icon__3iDIG"
						viewBox={EF_ICONS[topButtons[1].icon].viewBox}
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path
							fill-rule="evenodd"
							fill="currentColor"
							d={EF_ICONS[topButtons[1].icon].paths[0]}
						/>
					</svg>
				</span>
			</a>
			<button
				type="button"
				class="Header_mute__M03P_"
				data-ef-h5-mute
				aria-pressed="false"
