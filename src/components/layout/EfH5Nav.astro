---
/**
 * 官网 H5 顶栏 + 全屏菜单（竖屏专用）—— 逐字复用。
 *
 * 来源：
 *   结构  F:/web/endfield-official/index.html 里 Header_h5HeaderContainer__ctquk 整块
 *         （.ef-work/h5-header.html，含全部内联 svg）
 *          + 该 bundle（.ef-work/offjs/plain/226-7caa24cd135256b7.js）里 h5Menu 的 JSX
 *   样式  F:/web/endfield-official/css/46158da72caa0121.css 里全部 Header_h5… 与
 *         Header_menu… 规则 → src/styles/endfield-shell.css §11（rem 换成 calc(N * var(--efu))）
 *   断点  官网：@media(orientation:landscape){ .h5HeaderContainer, .h5Menu { display:none } }
 *         本站：只在「≤860px 且竖屏」接管，横屏仍旧走竖排栏（竖排栏是已验收的桌面版式）
 *
 * 条目映射（官方 navList 8 个槽位的**图标顺序一位不动**，只换文案与落点）：
 *   1 home 40×40        首页   /             ← 官网「首页」
 *   2 operator 44×49    系列   /series/      ← 官网「干员情报」，桌面栏同一枚
 *   3 lore 42×42        文章   /archive/     ← 官网「世界观资料」，桌面栏同一枚
 *   4 information 43×46 标签   /tags/        ← 官网「影像资料」，桌面栏同一枚
 *   5 calendar 42×40    分类   /categories/  ← 官网「版本日历」，桌面栏同一枚
 *   6 gameplay 41×48    相册   /gallery/     ← 官网「玩法介绍」文档页形
 *   7 aic 57×47         项目   /projects/    ← 官网「集成工业知识」齿轮形
 *   8 notice 44×49      关于   /about/       ← 官网「公告」，桌面栏同一枚
 *
 * 顶行两颗按钮（官网是「登录」+「鹰角支付中心」）：
 *   留言 /guestbook/  ← 官网「登录」位，圆内换成官网收起态人形 navBust（留言板＝人）
 *   友链 /friends/    ← 官网「鹰角支付中心」位，圆内是同一枚 27×30 券形 navCube（链接＝互认凭证）
 * 顶栏黑块（官网「前往游戏」）：搜索 /search/，圆内换成官网 magnifier（原图就是放大镜）
 *
 * 底部社交行：官网是 8 枚第三方品牌标（微博/微信/B站/TapTap/抖音/小红书/QQ/QQ群）。
 *   本站没有这些账号，所以**换成站主真有的 8 个落点**，品牌标一律用对应品牌的通用
 *   24×24 path（不是终末地图形 —— 拿游戏图形冒充品牌标才是错的）：
 *   RSS / GitHub / X / Discord / Bilibili / 邮箱 / 友链 / 关于。
 *   几何（height 3.375u、#777、space-between、左右 padding 3.5u）与官网逐值相同。
 */
import { EF_ICONS, type EfIconKey } from "@/constants/efIcons";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = path === "/";
const on = (p: string) =>
	p === "/" ? isHome : path === p || path.startsWith(`${p}/`);

/**
 * 官网 H5 菜单 navList 的 8 个槽位 —— 图标顺序**一位不改**，照官网 index.html 抠出来的
 * data-key 序列走（已用 viewBox 逐个核对）：
 *   home(40×40) → operator(44×49) → lore(42×42) → information(43×46)
 *   → calendar(42×40) → gameplay(41×48) → aic(57×47) → notice(44×49)
 * 落点挑成「同一个目的地，桌面竖排栏与 H5 菜单用同一枚图标」：
 *   home→首页 / operator→系列 / lore→文章 / information→标签 / calendar→分类
 *   gameplay(41×48)→相册 / aic(57×47)→项目 / notice→关于
 * （官网自己的 PC 栏与 H5 菜单本来就不是同一套顺序，见 §11 注释。） */
const navItems: { icon: EfIconKey; href: string; label: string }[] = [
	{ icon: "navHome", href: "/", label: "首页" },
	{ icon: "navOperator", href: "/series/", label: "系列" },
	{ icon: "navLore", href: "/archive/", label: "文章" },
	{ icon: "navInformation", href: "/tags/", label: "标签" },
	{ icon: "navCalendar", href: "/categories/", label: "分类" },
	{ icon: "pageDoc", href: "/gallery/", label: "相册" },
	{ icon: "cogPlay", href: "/projects/", label: "项目" },
	{ icon: "navNotice", href: "/about/", label: "关于" },
];

/** 顶行两颗圆标按钮（官网：登录 / 鹰角支付中心）。 */
const topButtons: { icon: EfIconKey; href: string; label: string }[] = [
	{ icon: "navBust", href: "/guestbook/", label: "留言" },
	{ icon: "navCube", href: "/friends/", label: "友链" },
];

/** 底部社交行：8 个真落点 + 对应品牌的 24×24 path。 */
