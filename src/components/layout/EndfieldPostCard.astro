---
import { getTagUrl } from "@/utils/url-utils";

interface Props {
	url: string;
	title: string;
	published?: Date | string;
	description?: string;
	tags?: string[];
	category?: string;
}

const { url, title, published, description, tags = [], category } = Astro.props;
const d = published ? new Date(published) : null;
const dateStr = d
	? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`
	: "";
---

<article class="ef-post">
	<a class="ef-post-link" href={url}>
		<p class="ef-post-date ef-field">{dateStr}</p>
		<h3 class="ef-post-title">{title}</h3>
		{description && <p class="ef-post-desc">{description}</p>}
		{(category || tags.length > 0) && (
			<ul class="ef-post-tags">
				{category && <li class="ef-chip">{category}</li>}
				{tags.slice(0, 3).map((t) => (
					<li class="ef-chip"><a href={getTagUrl(t)}>{t}</a></li>
				))}
			</ul>
		)}
	</a>
</article>
