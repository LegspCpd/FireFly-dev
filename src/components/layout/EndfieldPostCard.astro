---
import { getTagUrl } from "@/utils/url-utils";

interface Props {
	url: string;
	title: string;
	published?: Date | string;
	description?: string;
	tags?: string[];
	category?: string;
}

const { url, title, published, description, tags = [], category } = Astro.props;
const d = published ? new Date(published) : null;
const pad = (n: number) => String(n).padStart(2, "0");
const dateStr = d
	? d.getFullYear() + "." + pad(d.getMonth() + 1) + "." + pad(d.getDate())
	: "";
---

<!-- data-post-* 只给归档页的客户端筛选（/archive/?tag= / ?category= / ?uncategorized=）用：
     卡片上只显示前 3 个标签，判定必须拿完整标签列表，所以原始数据挂在 data-* 上。
     纯数据属性，不参与任何样式（首页 / 文章页同样渲染这几个属性，无副作用）。 -->
<article
	class="ef-card"
	data-post-tags={JSON.stringify(tags.map((t) => t.trim()))}
	data-post-category={category ?? ""}
>
	<p class="ef-card-meta">
		{dateStr && <span class="ef-card-date">{dateStr}</span>}
		{category && <span class="ef-card-cat">{category}</span>}
	</p>

	<h3 class="ef-card-title">
		<a class="ef-card-link" href={url}>{title}</a>
	</h3>

	{description && <p class="ef-card-desc">{description}</p>}

	{
		tags.length > 0 && (
			<ul class="ef-card-tags">
				{tags.slice(0, 3).map((t) => (
					<li>
						<a href={getTagUrl(t)}>#{t}</a>
					</li>
				))}
			</ul>
		)
	}
</article>
