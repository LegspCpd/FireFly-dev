---
import type { CollectionEntry } from "astro:content";
import { siteConfig } from "@/config";
import { commentConfig, efCommentConfig } from "@/config/commentConfig";
import Key from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { resolveCommentApiBase } from "@/utils/comment-api";
import { removeFileExtension } from "@/utils/url-utils";
import EfIcon from "@components/common/EfIcon.astro";
import Artalk from "./Artalk.astro";
import Disqus from "./Disqus.astro";
import EfComments from "./EfComments.svelte";
import Giscus from "./Giscus.astro";
import Twikoo from "./Twikoo.astro";
import Waline from "./Waline.astro";

interface Props {
	post?: CollectionEntry<"posts"> | CollectionEntry<"spec">;
	customPath?: string;
	title?: string;
}

const { post, customPath, title: customTitle } = Astro.props as Props;

// 根据页面类型确定路径
const slugFromPath = (customPath || "/").replace(/^\/+|\/+$/g, "") || "index";
const slug = post ? removeFileExtension(post.id) : slugFromPath;
const path = customPath
	? customPath
	: post
		? post.collection === "posts"
			? `/posts/${slug}`
			: `/${slug}`
		: `/${slug}`;
const url = `${Astro.site?.href}${path}`;
const postTitle = post && "title" in post.data ? post.data.title : undefined;

/**
 * 评论后端选择：
 *   efCommentConfig.enabled = true  → 自建评论组件（平台无关的外部 API，见 docs/comment-api.md）
 *   efCommentConfig.enabled = false → 回落到 commentConfig.type 的第三方评论系统
 * 自建组件的地址来自 COMMENT_API_BASE / PUBLIC_COMMENT_API_BASE 环境变量
 * （构建期解析好再传给岛），没配就进入演示态 —— 不白屏、不报错刷屏。
 */
const efEnabled = efCommentConfig.enabled === true;
const efApiBase = efEnabled ? resolveCommentApiBase(efCommentConfig.apiBase) : "";
/** 线程键：给外部 API 区分文章 / 留言板；pathPrefix 用于一个 API 服务多个站点时分区。 */
const efThreadPath = `${efCommentConfig.pathPrefix || ""}${path}`;

// 强制commentService类型为string，避免类型不兼容警告
let commentService: string = efEnabled
	? "enfield"
	: commentConfig?.type || "none";
---

{
  commentService !== "none" && (
    <div id="post-comments" class="card-base p-8 mb-6 relative overflow-x-clip overflow-y-visible">
      <!-- 装饰性背景（单独裁剪层，卡片本体放开纵向 overflow 以免裁掉评论区浮层） -->
      <div class="absolute inset-0 overflow-hidden rounded-(--radius-large) pointer-events-none">
        <div class="absolute top-0 right-0 w-32 h-32 opacity-5">
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <circle cx="50" cy="50" r="40" fill="currentColor" class="text-(--primary)" />
            <circle cx="50" cy="50" r="25" fill="none" stroke="currentColor" stroke-width="2" class="text-(--primary)" />
            <circle cx="50" cy="50" r="10" fill="currentColor" class="text-(--primary)" />
          </svg>
        </div>
      </div>
      <!-- 评论区标题 -->
      <div class="relative z-10 mb-6">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-1 h-6 bg-linear-to-b from-(--primary) to-transparent rounded-full"></div>
          <h3 class="text-xl font-bold text-(--btn-content)">{i18n(Key.commentSection)}</h3>
        </div>
        <p class="text-sm text-(--content-meta) ml-4">{i18n(Key.commentSubtitle)}</p>
      </div>
      <!-- 评论内容区域 -->
      <div class="relative z-10 pl-2 pr-2">
        {commentService === "enfield" && (
          <EfComments
            client:visible
            path={efThreadPath}
            apiBase={efApiBase}
            locale={siteConfig.lang}
            maxLength={efCommentConfig.maxLength}
          />
        )}
        {commentService === "twikoo" && <Twikoo path={path} />}
        {commentService === "waline" && <Waline path={path} />}
        {commentService === "giscus" && <Giscus />}
        {commentService === "disqus" && <Disqus identifier={slug} url={url} title={customTitle || postTitle || slug} />}
          {commentService === "artalk" && <Artalk path={path} />}
        {commentService === "none" && (
          <div class="text-center py-8 text-(--content-meta)">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-(--btn-regular-bg) flex items-center justify-center">
              {/* 官网无「评论」形，取 navNotice（喇叭 / 公告形） */}
              <EfIcon name="navNotice" style="font-size: 2rem; color: var(--primary)" />
            </div>
            <p>{i18n(Key.commentNotConfigured)}</p>
          </div>
        )}
      </div>
    </div>
  )
}
