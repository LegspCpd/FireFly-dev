---
import type { GetStaticPaths } from "astro";
import HeroCanvas from "@components/common/HeroCanvas.astro";
import EndfieldPostGrid from "@components/layout/EndfieldPostGrid.astro";
import EndfieldLayout from "@layouts/EndfieldLayout.astro";
import { siteConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: siteConfig.pagination.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isHome = page.currentPage === 1;
---

<EndfieldLayout title={siteConfig.title} description={siteConfig.subtitle}>
	{
		isHome ? (
			<HeroCanvas />
		) : (
			<div class="ef-wrap">
				<section class="ef-sec">
					<div class="ef-sec-head">
						<p class="ef-eyebrow" data-replay="ef-in-power">// ARCHIVE</p>
						<h1 class="ef-sec-title" data-replay="ef-in-power" style="--i: 1">第 {page.currentPage} 页</h1>
						<p class="ef-sec-count ef-field">{page.data.length} 篇文章</p>
					</div>
					<EndfieldPostGrid posts={page.data} columns={3} />
				</section>
			</div>
		)
	}
	{
		page.total > 1 && (
			<nav class="ef-wrap ef-pager">
				{page.url.prev ? <a class="ef-btn small" href={page.url.prev}>上一页</a> : null}
				<span class="ef-field">{page.currentPage} / {page.total}</span>
				{page.url.next ? <a class="ef-btn small" href={page.url.next}>下一页</a> : null}
			</nav>
		)
	}
</EndfieldLayout>
