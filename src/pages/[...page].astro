---
import type { GetStaticPaths } from "astro";
import HeroCanvas from "@components/common/HeroCanvas.astro";
import EndfieldPostGrid from "@components/layout/EndfieldPostGrid.astro";
import EndfieldLayout from "@layouts/EndfieldLayout.astro";
import { siteConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: siteConfig.pagination.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isHome = page.currentPage === 1;
---

<EndfieldLayout title={siteConfig.title} description={siteConfig.subtitle}>
	{
		isHome ? (
			<>
				<HeroCanvas />
				{/* 区块标题 = 官网 sectionDivider 的黄带，必须整幅贯通内容区
				    （官网实测 1440×900：x 67.5 / w 1372.5 = 整条内容宽），
				    所以它挂在 .ef-sec 下，不再套 .ef-wrap；只有下面的文章网格套版心。
				    官网该带没有内联图标，标题里的 EfIcon 一并去掉。 */}
				<section class="ef-sec">
					<div class="ef-sec-head">
						<div class="ef-sec-head-text">
							<p class="ef-eyebrow">// LATEST</p>
							<h2 class="ef-sec-title">最新文章</h2>
						</div>
						<p class="ef-sec-count">{page.data.length} 篇文章</p>
					</div>
					<div class="ef-wrap">
						<EndfieldPostGrid posts={page.data.slice(0, 6)} columns={3} />
					</div>
				</section>
			</>
		) : (
			<section class="ef-sec">
				<div class="ef-sec-head">
					<div class="ef-sec-head-text">
						<p class="ef-eyebrow">// ARCHIVE</p>
						<h1 class="ef-sec-title">第 {page.currentPage} 页</h1>
					</div>
					<p class="ef-sec-count">{page.data.length} 篇文章</p>
				</div>
				<div class="ef-wrap">
					<EndfieldPostGrid posts={page.data} columns={3} />
				</div>
			</section>
		)
	}
	{/* 分页 = 官网 .Pagination_pagination：左箭头圆钮 + 页码 + 右箭头圆钮。
	    箭头 path 逐字取自官网 index.html 里 .Pagination_arrow 的 SVG（viewBox 0 0 18 27）。
	    文字版「上一页 / 下一页」换成官网的箭头，可读名称留在 aria-label 上。 */}
	{
		page.total > 1 && (
			<nav class="ef-wrap ef-pager" aria-label="分页">
				{page.url.prev ? (
					<a class="ef-pager-btn" href={page.url.prev} aria-label="上一页">
						<span class="ef-pager-border" />
						<svg class="ef-pager-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 27" aria-hidden="true">
							<path fill-rule="evenodd" fill="currentColor" d="M14.142,0.127 L17.753,3.737 L7.963,13.527 L17.753,23.318 L14.142,26.928 L0.743,13.527 L14.142,0.127 Z" />
						</svg>
					</a>
				) : (
					<span class="ef-pager-btn ef-pager-disabled" aria-hidden="true">
						<span class="ef-pager-border" />
						<svg class="ef-pager-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 27">
							<path fill-rule="evenodd" fill="currentColor" d="M14.142,0.127 L17.753,3.737 L7.963,13.527 L17.753,23.318 L14.142,26.928 L0.743,13.527 L14.142,0.127 Z" />
						</svg>
					</span>
				)}
				<span class="ef-pager-num">
					<span>{page.currentPage}</span>
					<span class="ef-pager-divider">/</span>
					<span>{page.total}</span>
				</span>
				{page.url.next ? (
					<a class="ef-pager-btn" href={page.url.next} aria-label="下一页">
						<span class="ef-pager-border" />
						<svg class="ef-pager-arrow ef-pager-right" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 27" aria-hidden="true">
							<path fill-rule="evenodd" fill="currentColor" d="M14.142,0.127 L17.753,3.737 L7.963,13.527 L17.753,23.318 L14.142,26.928 L0.743,13.527 L14.142,0.127 Z" />
						</svg>
					</a>
				) : (
					<span class="ef-pager-btn ef-pager-disabled" aria-hidden="true">
						<span class="ef-pager-border" />
						<svg class="ef-pager-arrow ef-pager-right" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 27">
							<path fill-rule="evenodd" fill="currentColor" d="M14.142,0.127 L17.753,3.737 L7.963,13.527 L17.753,23.318 L14.142,26.928 L0.743,13.527 L14.142,0.127 Z" />
						</svg>
					</span>
				)}
			</nav>
		)
	}
</EndfieldLayout>
