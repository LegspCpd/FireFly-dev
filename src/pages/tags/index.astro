---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
// 页名图标来源：标签：官网无「标签」，取 navInformation（竖排栏 /tags/ 同 key）。
import EfSectionTitle from "@components/common/EfSectionTitle.astro";
import EfSubpageHeader from "@components/common/EfSubpageHeader.astro";
import EndfieldLayout from "@layouts/EndfieldLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

// 官网没有「标签」页：页头用 .SubpageHeader_subpageHeader，两个小节标题用
// .SectionTitle_sectionTitle（灰块滑出 + Gilroy-Medium 英文 + SansBold 中文）。
// 标签云与柱图保持现状（套件 ef-chip / ef-bars），官网没有对应物，不改造型。
const tags = await getTagList();

// Top 10 标签排行
const topTags = [...tags].sort((a, b) => b.count - a.count).slice(0, 10);
const countLabel = (n: number) => `${n} ${i18n(n === 1 ? I18nKey.postCount : I18nKey.postsCount)}`;
---

<EndfieldLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
	<EfSubpageHeader title={i18n(I18nKey.tags)} titleEn="Tags" icon="navInformation" />

	<div class="ef-wrap">
		<div class="ef-tag-body">
			<p class="ef-field ef-page-sub" data-replay="ef-in-power" style="--i: 0">
				{tags.length} {i18n(I18nKey.tagsCount)} · {countLabel(
					tags.reduce((sum, t) => sum + t.count, 0),
				)}
			</p>

			{tags.length > 0 ? (
				<>
					<section class="ef-tag-block">
						<EfSectionTitle en="All Tags" cn={i18n(I18nKey.allTags)} />
						<ul class="ef-chip-row">
							{tags.map((t) => (
								<li>
									<a class="ef-chip" href={getTagUrl(t.name)}>
										{t.name.trim()}
										<span class="n">{t.count}</span>
									</a>
								</li>
							))}
						</ul>
					</section>

					{topTags.length > 0 && (
						<section class="ef-tag-block">
							<EfSectionTitle en="Top 10" cn="热门排行" />
							<ul class="ef-ledger">
								<li>
									<ol class="ef-bars" aria-label="Top 10">
										{topTags.map((t) => (
											<li
												style={"--v: " + (t.count / (topTags[0]?.count || 1)).toFixed(3)}
												class={t.count === topTags[0]?.count ? "is-over" : undefined}
											>
												<span>{t.name.trim()}</span>
											</li>
										))}
									</ol>
								</li>
								{topTags.map((t, idx) => (
									<li>
										<a data-replay="ef-in-come" style={"--i: " + String(idx % 8)} href={getTagUrl(t.name)}>{t.name.trim()}</a>
										<span class="ef-field">{countLabel(t.count)}</span>
									</li>
								))}
							</ul>
						</section>
					)}
				</>
			) : (
				<p class="ef-empty ef-field">{i18n(I18nKey.noData)}</p>
			)}
		</div>
	</div>
</EndfieldLayout>

<style>
	/* 与分类页同一基准：标题板到内容的距离取官网 .__10-NoticeList_items__ 的
	   margin-top:2.625rem；两个小节之间按区块间距 4.5u 分开。 */
	.ef-tag-body {
		padding-block: calc(2.625 * var(--efu)) calc(6 * var(--efu));
	}
	.ef-tag-block {
		margin-bottom: calc(4.5 * var(--efu));
	}
	.ef-tag-block :global(.ef-chip-row),
	.ef-tag-block :global(.ef-ledger) {
		margin-top: calc(1.5 * var(--efu));
	}
	/* 套件 .ef-bars 是 grid-auto-columns:1fr 的柱图，必须由容器给出确定宽度：
	   它给 .ef-ledger > li（flex 行）当子项时没有宽度，1fr 列解析为 0，
	   10 根柱子全塌成 0 宽、10 个标签（绝对定位 nowrap）全挤在同一 x 上互相压字
	   （实测 1440 下 37 组文字矩形相交、390 下 39 组）。
	   这里只把宽度交还给行宽（100% = 版心 792 / 355.34），没有另定任何数值；
	   柱高仍由 --v、列宽仍由 1fr、标签字号仍由套件原值控制。 */
	.ef-tag-block :global(.ef-bars) {
		width: 100%;
	}
	/* 窄屏仍放不下：390 上 10 列 = 每列 31.9，最长标签 Cloudflare 51.06，
	   单行 nowrap 必然相邻相交（实测 2 组）；折行则标签高 42.44、比柱图预留的
	   8rem 多出 31px，会压到下面 .ef-ledger 的第一行（实测 gap -31）。
	   官网没有柱图这个对应物，不给它另定字号 / 列宽 / 断点，窄屏索性不画标签 ——
	   同一份 Top 10（名字 + 篇数）就在紧下面的账本里，信息不丢。 */
	@media (max-width: 860px) {
		.ef-tag-block :global(.ef-bars > li > span) {
			display: none;
		}
	}
</style>
