---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = await getTagList();

// Top 10 标签排行
const topTags = [...tags].sort((a, b) => b.count - a.count).slice(0, 10);
const countLabel = (n: number) => `${n} ${i18n(n === 1 ? I18nKey.postCount : I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
    <div class="card-base p-8 md:p-10 mb-4">
        <!-- 眉标 + 页名 + 计数（官网骨架） -->
        <p class="ef-eyebrow">// TAGS</p>
        <h1 class="ef-page-name">{i18n(I18nKey.tags)}</h1>
        <p class="ef-field ef-page-sub">
            {i18n(I18nKey.allTags)} · {tags.length} {i18n(I18nKey.tagsCount)}
        </p>

        {tags.length > 0 ? (
            <div>
                <!-- 标签云：套件 ef-chip（带切角，计数用 .n） -->
                <ul class="ef-chip-row">
                    {tags.map((t) => (
                        <li>
                            <a class="ef-chip" href={getTagUrl(t.name)}>
                                {t.name.trim()}
                                <span class="n">{t.count}</span>
                            </a>
                        </li>
                    ))}
                </ul>

                <!-- Top 10：套件 ef-ledger（原来是自造的进度条） -->
                {topTags.length > 0 && (
                    <div>
                        <h2 class="ef-field ef-sub-head">Top 10</h2>
                        <ul class="ef-ledger">
                            {topTags.map((t, idx) => (
                                <li>
                                    <a class="ef-in-come" style={"--i: " + String(idx % 8)} href={getTagUrl(t.name)}>{t.name.trim()}</a>
                                    <span class="ef-field">{countLabel(t.count)}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>
        ) : (
            <p class="ef-empty ef-field">{i18n(I18nKey.noData)}</p>
        )}
    </div>
</MainGridLayout>
