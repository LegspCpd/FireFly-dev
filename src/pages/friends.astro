---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/friends.css";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:group" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>
      </div>

      <!-- 搜索框 -->
      {
        items.length > 0 && (
          <friend-filter class="mb-6">
            <div class="relative mb-3">
              <Icon
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                data-apply-open
                class="ml-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-sm font-semibold bg-(--primary) text-white hover:opacity-90 transition-opacity cursor-pointer"
              >
                <Icon name="material-symbols:add-link" class="text-base" />
                申请友链
              </button>
              <button
                data-tag="all"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                data-active
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button
                  data-tag={tag}
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                >
                  {tag}
                </button>
              ))}
            </div>
          </friend-filter>
        )
      }

      <div class="friends-grid my-4">
        {
          items.length === 0 && (
            <div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
              <Icon name="material-symbols:group-off-outline" class="text-4xl mb-3" />
              <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
            </div>
          )
        }
        {
          items.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              data-tags={item.tags?.join(",")}
              class="friend-card group flex items-center gap-3 p-2.5 rounded-xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg relative overflow-hidden"
            >
              {/* 背景装饰 - 仅悬停显示 */}
              <div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none" />

              {/* 外部链接图标 - 固定在卡片右上角 */}
              <Icon
                name="material-symbols:arrow-outward-rounded"
                class="absolute top-3 right-3 text-(--primary) text-lg opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
              />

              {/* 头像 */}
              <div class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">
                <img
                  src={item.avatar || "/favicon/favicon-light-192.png"}
                  alt={item.name}
                  class="w-full h-full object-cover"
                />
              </div>

              {/* 内容 */}
              <div class="grow min-w-0 flex flex-col justify-center gap-0.5">
                <div class="font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors truncate pr-4">
                  {item.name}
                </div>

                <div
                  class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-1"
                  title={item.description}
                >
                  {item.description}
                </div>

                {/* 标签 */}
                <div class="flex flex-wrap gap-1 mt-1">
                  {item.tags && item.tags.length > 0
                    ? item.tags
                        .slice(0, 3)
                        .map((tag) => (
                          <span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 transition-colors duration-300">
                            {tag}
                          </span>
                        ))
                    : null}
                </div>
              </div>
            </a>
          ))
        }
      </div>

      {/* 搜索无结果提示 */}
      <div class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
        <Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>
    </div>
  </div>

  {friendsPageConfig.showCustomContent !== false && (
    <div class="mt-4 card-base z-10 px-9 py-6 relative w-full">
      <Markdown class="">
        <Content />
      </Markdown>
    </div>
  )}

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment post={friendsPost} customPath="/friends/" />
    </div>
  )}

  <script slot="head" is:inline>
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        selectedTag = "all";

        constructor() {
          super();
        }

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", () => this.applyFilters());
          }
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const target = e.target;
          const button = target.closest("button");
          if (!button) return;

          this.selectedTag = button.dataset.tag;
          const filters = this.querySelectorAll("button");

          filters.forEach((f) => {
            f.removeAttribute("data-active");
          });
          button.setAttribute("data-active", "");

          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const cards = container.querySelectorAll(".friend-card");

          let hasVisible = false;

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            const name = (cardEl.querySelector(".font-bold")?.textContent || "").toLowerCase();
            const desc = (cardEl.querySelector(".line-clamp-1")?.textContent || "").toLowerCase();

            const tagMatch =
              this.selectedTag === "all" ||
              (this.selectedTag && tags.includes(this.selectedTag));
            const searchMatch =
              !query ||
              name.includes(query) ||
              desc.includes(query) ||
              tags.some((t) => t.toLowerCase().includes(query));

            if (tagMatch && searchMatch) {
              cardEl.style.display = "";
              cardEl.classList.add("animate-fade-in-up");
              hasVisible = true;
            } else {
              cardEl.style.display = "none";
              cardEl.classList.remove("animate-fade-in-up");
            }
          });

          const emptyEl = container.querySelector(".friends-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", hasVisible);
            emptyEl.classList.toggle("flex", !hasVisible);
          }
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }
  </script>

  <script slot="head" is:inline>
	// 友链页增强：统一处理「复制」按钮，并让指向本站的链接跟随访客当前使用的域名。
	//
	// 为什么必须在浏览器里做：本站是静态站点，构建期拿不到访客用的是哪个域名
	// （www / blog / 裸域在构建时完全一样）。浏览器自己知道当前域名，所以放在这里。
	//
	// 安全边界：只有当前域名属于「正式域名白名单」（data-site-hosts）时才改写；
	// 若访客走的是平台镜像域名（例如 *.pages.dev），保持原样，
	// 避免把镜像域名写进「请复制本站信息」这类内容里。
	if (!window.__fireflyFriendsEnhance) {
		window.__fireflyFriendsEnhance = true;

		const hostRegexCache = new Map();
		const hostRegex = (host) => {
			if (!hostRegexCache.has(host)) {
				hostRegexCache.set(
					host,
					new RegExp(
						"(//|^)" + host.replace(/\./g, "\\.") + "(?=[/:?#]|$)",
						"g",
					),
				);
			}
			return hostRegexCache.get(host);
		};

		// 只替换真正处在「主机名」位置的片段，保留路径、查询串与写法风格
		const swapHost = (value, hosts, to) => {
			if (!value) return value;
			let out = value;
			for (const host of hosts) out = out.replace(hostRegex(host), "$1" + to);
			return out;
		};

		// 记住每个元素的**原始**内容，保证反复执行也幂等
		// （Swup 导航会重复触发；若在已改写的内容上再改一次，可能累积出错误结果）
		const originals = new WeakMap();
		const originalOf = (el) => {
			let rec = originals.get(el);
			if (!rec) {
				rec = {
					copy: el.getAttribute("data-copy"),
					href: el.getAttribute("href"),
					text: el.textContent,
				};
				originals.set(el, rec);
			}
			return rec;
		};

		const applyHostLinks = () => {
			const block = document.querySelector("[data-friends-block]");
			if (!block) return;
			const hosts = (block.getAttribute("data-site-hosts") || "")
				.split(/\s+/)
				.filter(Boolean);
			if (hosts.length === 0) return;
			// 当前不在正式域名下（例如平台镜像域名）→ 什么都不改
			if (!hosts.includes(location.hostname)) return;
			const to = location.host;

			// ① 标记为「本站链接」的展示文本
			block.querySelectorAll("[data-site-url]").forEach((el) => {
				el.textContent = swapHost(originalOf(el).text, hosts, to);
			});
			// ② 复制按钮要复制的内容（站点链接那一行的复制值也在这里）
			block.querySelectorAll("[data-copy]").forEach((el) => {
				const src = originalOf(el).copy;
				if (src !== null) el.setAttribute("data-copy", swapHost(src, hosts, to));
			});
			// ③ 指向本站的链接
			block.querySelectorAll("a[href]").forEach((el) => {
				const src = originalOf(el).href;
				if (src) el.setAttribute("href", swapHost(src, hosts, to));
			});
			// ④ 同一块内容里出现的其它本站域名文本
			block.querySelectorAll("p, span, code, li").forEach((el) => {
				if (el.children.length > 0) return;
				el.textContent = swapHost(originalOf(el).text, hosts, to);
			});
		};

		// 复制按钮统一处理：内容会在运行时被上面的逻辑改写，所以点击时现读 data-copy
		document.addEventListener("click", (event) => {
			const target = event.target;
			const btn =
				target && target.closest
					? target.closest("[data-friends-block] [data-copy]")
					: null;
			if (!btn) return;
			const text = btn.getAttribute("data-copy") || "";
			const svgs = btn.querySelectorAll("svg");
			const flash = () => {
				if (svgs.length < 2) return;
				svgs[0].classList.add("hidden");
				svgs[1].classList.remove("hidden");
				setTimeout(() => {
					svgs[0].classList.remove("hidden");
					svgs[1].classList.add("hidden");
				}, 1500);
			};
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(text).then(flash, () => {});
			}
		});

		applyHostLinks();
		document.addEventListener("DOMContentLoaded", applyHostLinks);
		document.addEventListener("swup:contentReplaced", applyHostLinks);
		document.addEventListener("swup:page:view", applyHostLinks);
	}
	</script>


  <!-- 一键申请友链：弹窗 + 实时检查（提交到 api.vercel-lc.cc.cd 的 Worker） -->
  <div id="friend-apply" data-api="https://api.vercel-lc.cc.cd" hidden>
    <div class="fixed inset-0 z-[70] bg-black/50 backdrop-blur-sm" data-apply-close></div>
    <div class="fixed inset-0 z-[71] flex items-start justify-center overflow-y-auto p-4 sm:p-6">
      <div class="w-full max-w-lg rounded-2xl border border-(--line-divider) bg-(--card-bg) shadow-xl my-4" role="dialog" aria-modal="true" aria-labelledby="fa-title">
        <div class="flex items-center justify-between px-5 py-4 border-b border-(--line-divider)">
          <h3 id="fa-title" class="text-base font-bold">申请友链</h3>
          <button type="button" data-apply-close class="w-7 h-7 flex items-center justify-center rounded-md hover:bg-black/5 dark:hover:bg-white/10 cursor-pointer" aria-label="关闭">
            <Icon name="material-symbols:close" class="text-lg" />
          </button>
        </div>

        <div class="px-5 py-4 space-y-3.5">
          <label class="block">
            <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">站点名 *</span>
            <input data-fa="name" type="text" maxlength="60" placeholder="例如：某人的小站" class="mt-1 w-full px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent text-sm outline-none focus:border-(--primary)" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">站点链接 *</span>
            <input data-fa="url" type="url" placeholder="https://example.com/" class="mt-1 w-full px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent text-sm outline-none focus:border-(--primary)" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">头像链接（可选）</span>
            <input data-fa="avatar" type="url" placeholder="https://example.com/avatar.png" class="mt-1 w-full px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent text-sm outline-none focus:border-(--primary)" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">友链页链接（可选，便于机器人检查回链）</span>
            <input data-fa="backlink" type="url" placeholder="https://example.com/friends/" class="mt-1 w-full px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent text-sm outline-none focus:border-(--primary)" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">简介（最多 100 字）</span>
            <textarea data-fa="description" maxlength="100" rows="2" placeholder="一句话介绍你的站点" class="mt-1 w-full px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent text-sm outline-none focus:border-(--primary) resize-none"></textarea>
            <span class="text-[0.7rem] text-neutral-400" data-fa="count">0 / 100</span>
          </label>
          <label class="flex items-start gap-2 text-xs text-neutral-600 dark:text-neutral-300">
            <input data-fa="agreed" type="checkbox" class="mt-0.5" />
            <span>我已在<strong>我的友链页面</strong>添加了本站链接（<span class="font-mono" data-site-url></span>）</span>
          </label>

          <ul class="text-xs space-y-1 rounded-lg bg-black/5 dark:bg-white/5 px-3 py-2" data-fa="checks"></ul>

          <div class="text-xs rounded-lg px-3 py-2 hidden" data-fa="result"></div>
        </div>

        <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-(--line-divider)">
          <button type="button" data-apply-close class="px-4 py-2 rounded-lg text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 cursor-pointer">取消</button>
          <button type="button" data-fa="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold bg-(--primary) text-white hover:opacity-90 transition-opacity cursor-pointer">
            提交申请
          </button>
        </div>
      </div>
    </div>
  </div>

  <script slot="head" is:inline>
    // 一键申请友链：弹窗、实时预检、提交到 Worker（Worker 用令牌建 PR）
    // 约束：本段不得使用模板字符串（构建期会被压缩），全部用字符串拼接
    (function () {
      if (window.__fireflyFriendApply) return;
      window.__fireflyFriendApply = true;

      var MAX_DESC = 100;
      var state = { name: false, url: false, avatar: null, backlink: null, site: null, avatarUrl: null };

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      function isHttpUrl(v) {
        if (typeof v !== "string" || !v) return false;
        try {
          var u = new URL(v);
          return u.protocol === "http:" || u.protocol === "https:";
        } catch (e) {
          return false;
        }
      }

      /** 站点可达性：no-cors 请求拿到 opaque 响应即视为通，网络错误视为不通 */
      function probeReachable(url, cb) {
        var done = false;
        var timer = setTimeout(function () {
          if (done) return;
          done = true;
          cb(false, "超时（8 秒无响应）");
        }, 8000);
        fetch(url, { mode: "no-cors", method: "GET", cache: "no-store", redirect: "follow" })
          .then(function () {
            if (done) return;
            done = true;
            clearTimeout(timer);
            cb(true, "可访问");
          })
          .catch(function () {
            if (done) return;
            done = true;
            clearTimeout(timer);
            cb(false, "打不开（网络错误）");
          });
      }

      /** 头像可达性：用 Image 预加载 */
      function probeImage(url, cb) {
        var done = false;
        var img = new Image();
        var timer = setTimeout(function () {
          if (done) return;
          done = true;
          cb(false, "超时（8 秒未加载）");
        }, 8000);
        img.onload = function () {
          if (done) return;
          done = true;
          clearTimeout(timer);
          cb(true, "可加载");
        };
        img.onerror = function () {
          if (done) return;
          done = true;
          clearTimeout(timer);
          cb(false, "加载失败");
        };
        img.src = url;
      }

      function render(root) {
        var rows = [];
        var desc = root.querySelector('[data-fa="description"]');
        var name = root.querySelector('[data-fa="name"]');
        var url = root.querySelector('[data-fa="url"]');
        var avatar = root.querySelector('[data-fa="avatar"]');
        var backlink = root.querySelector('[data-fa="backlink"]');
        var agreed = root.querySelector('[data-fa="agreed"]');

        rows.push(row("站点名", name.value.trim() ? true : null, name.value.trim() ? "已填" : "必填"));
        rows.push(row("简介字数", desc.value.length <= MAX_DESC, desc.value.length + " / " + MAX_DESC));
        rows.push(row("站点链接格式", isHttpUrl(url.value) ? true : url.value ? false : null, url.value ? (isHttpUrl(url.value) ? "格式正确" : "需要 http(s) 地址") : "必填"));
        if (url.value && isHttpUrl(url.value)) rows.push(row("站点可达性", state.site, state.site === null ? "检查中…" : state.siteText));
        if (avatar.value) rows.push(row("头像可达性", state.avatar, state.avatar === null ? "检查中…" : state.avatarText));
        if (backlink.value) rows.push(row("友链页格式", isHttpUrl(backlink.value) ? true : false, isHttpUrl(backlink.value) ? "格式正确" : "需要 http(s) 地址"));
        rows.push(row("已添加本站链接", agreed.checked ? true : null, agreed.checked ? "已确认" : "请勾选"));
        rows.push(row("反向链接检查", null, "提交后由机器人检查"));
        root.querySelector('[data-fa="checks"]').innerHTML = rows.join("");
        root.querySelector('[data-fa="count"]').textContent = desc.value.length + " / " + MAX_DESC;
      }

      function row(label, ok, text) {
        var mark = ok === true ? "✅" : ok === false ? "❌" : ok === null ? "•" : "•";
        var color = ok === true ? "text-green-500" : ok === false ? "text-red-500" : "text-neutral-400";
        return '<li class="flex items-center justify-between gap-2"><span>' + esc(label) + '</span><span class="' + color + '">' + mark + " " + esc(text) + "</span></li>";
      }

      function open(root) {
        root.hidden = false;
        document.documentElement.style.overflow = "hidden";
        var host = root.querySelector("[data-site-url]");
        if (host) host.textContent = location.host === "localhost:4321" ? "https://blog.legspcpd.top" : location.origin;
        render(root);
      }

      function close(root) {
        root.hidden = true;
        document.documentElement.style.overflow = "";
      }

      function bind(root) {
        if (root.dataset.bound === "1") return;
        root.dataset.bound = "1";
        var fields = root.querySelectorAll("[data-fa]");
        var debounce = null;
        for (var i = 0; i < fields.length; i++) {
          fields[i].addEventListener("input", function () {
            render(root);
            clearTimeout(debounce);
            debounce = setTimeout(function () {
              var url = root.querySelector('[data-fa="url"]').value;
              var avatar = root.querySelector('[data-fa="avatar"]').value;
              if (isHttpUrl(url)) {
                state.site = null;
                render(root);
                probeReachable(url, function (ok, text) {
                  state.site = ok;
                  state.siteText = text;
                  render(root);
                });
              }
              if (avatar && isHttpUrl(avatar)) {
                state.avatar = null;
                render(root);
                probeImage(avatar, function (ok, text) {
                  state.avatar = ok;
                  state.avatarText = text;
                  render(root);
                });
              }
            }, 700);
          });
        }
        root.querySelector('[data-fa="submit"]').addEventListener("click", function () {
          submit(root);
        });
      }

      function submit(root) {
        var btn = root.querySelector('[data-fa="submit"]');
        var box = root.querySelector('[data-fa="result"]');
        var payload = {
          name: root.querySelector('[data-fa="name"]').value.trim(),
          url: root.querySelector('[data-fa="url"]').value.trim(),
          avatar: root.querySelector('[data-fa="avatar"]').value.trim(),
          description: root.querySelector('[data-fa="description"]').value.trim(),
          backlink: root.querySelector('[data-fa="backlink"]').value.trim(),
          agreed: root.querySelector('[data-fa="agreed"]').checked,
        };
        var local = [];
        if (!payload.name) local.push("站点名必填");
        if (!isHttpUrl(payload.url)) local.push("站点链接需要 http(s) 地址");
        if (payload.description.length > MAX_DESC) local.push("简介超过 " + MAX_DESC + " 字");
        if (!payload.agreed) local.push("请先勾选已添加本站链接");
        box.classList.remove("hidden");
        if (local.length) {
          box.className = "text-xs rounded-lg px-3 py-2 bg-red-500/10 text-red-500";
          box.textContent = local.join("；");
          return;
        }
        btn.disabled = true;
        btn.textContent = "提交中…";
        box.className = "text-xs rounded-lg px-3 py-2 bg-black/5 dark:bg-white/5 text-neutral-500";
        box.textContent = "正在提交到友链仓库…";
        fetch(root.getAttribute("data-api") + "/apply", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        })
          .then(function (r) {
            return r.json().then(function (j) {
              return { status: r.status, body: j };
            });
          })
          .then(function (res) {
            btn.disabled = false;
            btn.textContent = "提交申请";
            if (res.status === 200 && res.body && res.body.ok) {
              box.className = "text-xs rounded-lg px-3 py-2 bg-green-500/10 text-green-600";
              box.innerHTML = "已提交 PR：" + '<a class="underline" target="_blank" rel="noopener noreferrer" href="' + esc(res.body.pr) + '">' + esc(res.body.pr) + "</a>" + "<br>机器人会自动检查并打标签，合并后这里就会显示你的站点。";
              return;
            }
            box.className = "text-xs rounded-lg px-3 py-2 bg-red-500/10 text-red-500";
            box.textContent = (res.body && (res.body.error || res.body.detail)) || "提交失败，请稍后再试";
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = "提交申请";
            box.className = "text-xs rounded-lg px-3 py-2 bg-red-500/10 text-red-500";
            box.textContent = "网络错误，提交失败（若在国内网络，请检查是否能访问 api.vercel-lc.cc.cd）";
          });
      }

      function setup() {
        var root = document.getElementById("friend-apply");
        if (!root) return;
        bind(root);
        var opens = document.querySelectorAll("[data-apply-open]");
        for (var i = 0; i < opens.length; i++) {
          opens[i].addEventListener("click", function (e) {
            e.preventDefault();
            open(root);
          });
        }
        var closes = root.querySelectorAll("[data-apply-close]");
        for (var j = 0; j < closes.length; j++) {
          closes[j].addEventListener("click", function () {
            close(root);
          });
        }
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !root.hidden) close(root);
        });
      }

      setup();
      document.addEventListener("DOMContentLoaded", setup);
      document.addEventListener("swup:contentReplaced", setup);
      document.addEventListener("swup:page:view", setup);
    })();
  </script>

</MainGridLayout>