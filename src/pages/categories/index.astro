---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList } from "@/utils/content-utils";

const categories = await getCategoryList();
const totalPosts = categories.reduce((sum, cat) => sum + cat.count, 0);
const countLabel = (n: number) => `${n} ${i18n(n === 1 ? I18nKey.postCount : I18nKey.postsCount)}`;
const maxCount = categories.reduce((m, c) => Math.max(m, c.count), 1);
---

<MainGridLayout title={i18n(I18nKey.categories)}>
    <div class="card-base p-8 md:p-10 mb-4">
        <!-- 眉标 + 页名 + 计数（官网骨架） -->
        <p class="ef-eyebrow">// CATEGORIES</p>
        <h1 class="ef-page-name">{i18n(I18nKey.categories)}</h1>
        <p class="ef-field ef-page-sub">
            {i18n(I18nKey.allCategories)} · {countLabel(totalPosts)}
        </p>

        <!-- 柱图：套件 ef-bars（每分类篇数，按最大值归一化；最高的一格标记 is-over） -->
        {categories.length > 0 && (
            <>
                <h2 class="ef-field ef-sub-head">分布</h2>
                <ol class="ef-bars" aria-label={i18n(I18nKey.categories)}>
                    {categories.map((category) => (
                        <li
                            style={"--v: " + (category.count / maxCount).toFixed(3)}
                            class={category.count === maxCount ? "is-over" : undefined}
                        >
                            <span>{category.name}</span>
                        </li>
                    ))}
                </ol>
            </>
        )}

        <!-- 账目表：套件 ef-ledger（ul > li，两端对齐 + 细线） -->
        {categories.length > 0 ? (
            <ul class="ef-ledger ef-page-list">
                {categories.map((category, idx) => (
                    <li>
                        <a class="ef-in-come" style={"--i: " + String(idx % 8)} href={category.url}>{category.name}</a>
                        <span class="ef-field">{countLabel(category.count)}</span>
                    </li>
                ))}
            </ul>
        ) : (
            <p class="ef-empty ef-field">{i18n(I18nKey.noData)}</p>
        )}
    </div>
</MainGridLayout>
