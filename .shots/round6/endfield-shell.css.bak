/* ==========================================================================
   endfield-shell.css — 终末地官网版式外壳
   --------------------------------------------------------------------------
   来源：https://endfield.hypergryph.com/ 导出的 Next.js 压缩 CSS
         （F:/web/endfield-official/css/*.css）与首页 DOM（index.html）。
   本节带 Header_ 前缀的类名与规则是从官网逐个抠出来照抄的，只做两处机械改动：

     1) 官网 html{font-size:min(.625vw,1.111111vh)} —— 官网的 1rem 是「视口单位」，
        1920×1080 下 1rem = 12px。这里把每个 rem 换成 calc(N * var(--efu))，
        1920×1080 下与官网像素尺寸完全相同，其它尺寸按官网同比例缩放。

     2) 官网用 React 内联 transform 给每个导航项排位置（首项 12.875rem、步长 5rem、
        项高 4.5rem）。这里改成文档流 + gap: .5rem，几何结果完全相同。

   不做的事：不加 !important，不在旧类名上叠补丁。旧外壳的 .ef-rail / .ef-header
   规则已整体删除（对应的 DOM 已不存在）。
   ========================================================================== */

/* ---------- 0. 官网字体 -------------------------------------------------
   官网 @font-face 的实际字体族名是 SansMedium / SansBold / Gilroy-* /
   Novecentosanswide-*。这里把本地已有的 woff2 用官网的名字注册一遍，
   这样下面照抄的 font-family 声明可以原样保留。
   中文没有对应的官方字体文件，落到系统 CJK 字体（与官网一致的做法）。 */

@font-face {
  font-family: SansMedium;
  src: url("/endfield-ui/official/font/Gilroy-Medium.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: SansBold;
  src: url("/endfield-ui/official/font/Gilroy-ExtraBold.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: Novecentosanswide-Medium;
  src: url("/endfield-ui/official/font/Novecentosanswide-Medium.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: Novecentosanswide-DemiBold;
  src: url("/endfield-ui/official/font/Novecentosanswide-DemiBold.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: Novecentosanswide-Bold;
  src: url("/endfield-ui/official/font/Novecentosanswide-Bold.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* ---------- 1. 外壳与色板 -------------------------------------------------
   官网实测色板：#f2f2f2 纸张 / #ffffff 白面 / #191919 墨 / #fffa00 信号黄（只做点缀）
                   #e5e5e5 浅边 / #999 #d9d9d9 #666 灰阶
   站主要求全站走浅色基调 —— 这里只有一套 token，不再分「首页暗底 / 内页纸底」；
   唯一保留暗色的是加载屏（BootScreen 的 #141414，与官网上屏一致）。 */

.ef-shell {
  /* 官网单位：1rem = min(.625vw, 1.111111vh)，钳到 9~12px 防止极端视口 */
  --efu: clamp(9px, min(0.625vw, 1.111111vh), 12px);

  --ef-black: #191919;
  --ef-yellow: #fffa00;
  --ef-steel: #35373c;
  --ef-paper-2: #f2f2f2;
  --ef-line-2: #e5e5e5;
  --ef-mint: #00ffa2;
  --ef-magenta: #ff1aac;
  --ef-grey: #999;
  --ef-grey-2: #d9d9d9;
  --ef-grey-3: #666;

  /* 与站点其余部分共用的旧 token，在壳内一律映射到官网色板 */
  --ef-signal: var(--ef-yellow);
  --ef-rail-w: calc(7.5 * var(--efu));
  --ef-rail-w-open: calc(22.5 * var(--efu));

  /* 纸底 + 墨字：全站同一套，没有第二套暗色 */
  --ef-ink: #191919;
  --ef-ink-2: #666;
  --ef-paper: #f2f2f2;
  --ef-panel: #ffffff;
  --ef-rule: #e5e5e5;
  --ef-chip: #e5e5e5;
  --ef-page-bg: #f2f2f2;
  --ef-card-bg: #ffffff;
  --deep-text: #191919;
  --title-active: #191919;
  --content-meta: #666;
  --line-divider: #e5e5e5;
  --line-color: #e5e5e5;
  --page-bg: #f2f2f2;
  --card-bg: #ffffff;
  --float-panel-bg: #ffffff;
  --btn-content: #191919;

  min-height: 100dvh;
  background: var(--ef-paper);
  color: var(--ef-ink);
  /* 主题里若还存着 dark，把原生控件（滚动条、表单、默认色）也扳回亮色 */
  color-scheme: light;
  font-family:
    SansMedium, "EF Gilroy", system-ui, -apple-system, "PingFang SC",
    "Microsoft YaHei", "Noto Sans SC", sans-serif;
  font-size: clamp(15px, calc(1.45 * var(--efu)), 19px);
  line-height: 1.75;
  -webkit-font-smoothing: antialiased;
}

/* 官网没有背景纹理，去掉模板的等高线层与壁纸层 */
body.ef-contours::before,
body.ef-contours::after {
  display: none;
}
/* 站主要求：先不显示任何图片（竖排栏图标等一律走内联 SVG）。
   要恢复内容里的图片（友链头像、正文配图），删掉这一条即可。 */
.ef-shell img {
  display: none;
}
/* 主题那条顶部渐变高光（Layout 渲染，180px 固定黑/白渐变，z-index 20）是 .ef-shell
   的兄弟节点，压不住它，所以这里直接按类名关掉。只有本站的壳页面会加载这份样式表。 */
.top-gradient-highlight {
  display: none;
}
/* 页面底色：主题在暗色下给 body 的暗纸色不再露出（加载屏才是唯一的暗色） */
html {
  background: #f2f2f2;
  overflow-x: hidden;
}
body.ef-contours {
  background: #f2f2f2;
}

/* ---------- 2. 版心 ------------------------------------------------------ */

/* 官网结构：.SectionViewer{display:flex} + [左侧 7.5rem 竖排栏][内容 flex:1]。
   这里竖排栏固定，内容永远让出 7.5rem，展开时栏浮在内容之上（官网同款）。 */
.ef-shell #swup-container {
  margin-left: var(--ef-rail-w);
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  background: var(--ef-paper);
}

/* 主题在 endfield.css 里给 [aria-current="page"] 刷了信号黄底，竖排栏里不要它：
   官网的当前项是「灰块 + 左黑条」，不是黄块。 */
.ef-shell .Header_pcHeaderContainer__Sy_8l a[aria-current="page"] {
  background: transparent;
  color: inherit;
  font-weight: inherit;
}
.ef-shell .ef-rail-bottom a[aria-current="page"] {
  background: transparent;
}

.ef-shell-main {
  flex: 1 1 auto;
  width: 100%;
  min-height: 60vh;
  padding-bottom: calc(6 * var(--efu));
}

.ef-wrap {
  width: 100%;
  max-width: calc(96 * var(--efu));
  margin-inline: auto;
  padding-inline: calc(4 * var(--efu));
}

/* ---------- 3. 竖排栏（官网 Header 模块原样搬用） ------------------------
   官网原文：.Header_pcHeaderContainer__Sy_8l{position:relative;height:100vh;
   width:7.5rem;z-index:50;color:#191919;background-color:#fff}
   → 按需求改成 fixed + 顶天立地（top/bottom/left 贴边、100dvh）。 */

.Header_pcHeaderContainer__Sy_8l {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  height: 100dvh;
  width: var(--ef-rail-w);
  z-index: 50;
  color: #191919;
  background-color: #fff;
  overflow: hidden;
  transition: width 0.3s cubic-bezier(0.2, 0, 0, 1);
}
/* 官网行为：默认收起只见图标，悬停（或键盘聚焦）展开出文字，移开缩回 */
.Header_pcHeaderContainer__Sy_8l:hover,
.Header_pcHeaderContainer__Sy_8l:focus-within {
  width: var(--ef-rail-w-open);
}

.Header_innerContainer__cW_Dv {
  position: relative;
  height: 100%;
}

/* 字标：官网 logo 位（top:1.25rem、宽 6.75rem、水平居中）。这里用站名字标，
   形状与位置照官方 logo 槽位，不引入任何图片。 */
.Header_logo__s3lE_ {
  position: absolute;
  top: calc(1.75 * var(--efu));
  left: 50%;
  transform: translate3d(-50%, 0, 0);
  width: calc(6.75 * var(--efu));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: calc(0.35 * var(--efu));
  color: #191919;
  text-decoration: none;
  white-space: nowrap;
}
.Header_logo__s3lE_ > svg {
  display: block;
  width: 100%;
  height: auto;
}
.ef-rail-wordmark {
  font-family: Novecentosanswide-Bold, SansBold, sans-serif;
  font-size: calc(1.04 * var(--efu));
  line-height: 1;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}
.ef-rail-wordmark-en {
  font-family: SansMedium, sans-serif;
  font-size: calc(0.72 * var(--efu));
  line-height: 1;
  letter-spacing: 0.32em;
  color: #999;
}
/* 字标下面一条官网那种黄块（收起时是唯一的高饱和点） */
.Header_logo__s3lE_::after {
  content: "";
  display: block;
  width: calc(2.5 * var(--efu));
  height: calc(0.25 * var(--efu));
  background: #fffa00;
}

/* 导航列表：官网首项 top 12.875rem、项高 4.5rem、步长 5rem（= 4.5 + 0.5） */
.Header_navList__r2BGN {
  position: absolute;
  top: calc(12.875 * var(--efu));
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: calc(0.5 * var(--efu));
}

.Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB {
  position: relative;
  width: 100%;
  height: calc(4.5 * var(--efu));
  display: flex;
  align-items: center;
  cursor: pointer;
  color: inherit;
  text-decoration: none;
}
/* 官网 hover 底：left 1.5rem、宽 19.5rem、#e5e5e5、圆角 4px。
   官网只在「非当前项」上显示它（:not(.Header_active)），当前项走下面的 overlay。 */
.Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB::before {
  content: "";
  position: absolute;
  left: calc(1.5 * var(--efu));
  width: calc(19.5 * var(--efu));
  height: 100%;
  background-color: #e5e5e5;
  opacity: 0;
  border-radius: calc(0.25 * var(--efu));
  transition: opacity 0.2s;
  pointer-events: none;
}
.Header_pcHeaderContainer__Sy_8l
  .Header_navItem__c_fLB:not(.Header_active__jzCyf):hover::before {
  opacity: 1;
}
/* 当前页：官网 .Header_overlay__33Sha ——
   left 0、宽 100% + 13.5rem（= 21rem）、高 5rem、box-sizing:border-box、
   左边 .75rem 实心黑边、底色 #e6e6e6；比 4.5rem 的导航项上下各多出 .25rem。
   官网用一个独立的兄弟 div 承载它，这里用同一个导航项的 ::after，几何一致。 */
.Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB.Header_active__jzCyf::after {
  content: "";
  position: absolute;
  left: 0;
  top: calc(-0.25 * var(--efu));
  /* 这块是背景条，必须落在图标与文字之下，否则整行只剩一条灰条（图标文字全被盖住）。 */
  z-index: -1;
  box-sizing: border-box;
  /* 收起态只占栏宽；展开（悬停）时才铺到官网的 21u。 */
  width: 100%;
  height: calc(5 * var(--efu));
  border-left: calc(0.75 * var(--efu)) solid #191919;
  background-color: #e6e6e6;
  pointer-events: none;
}

/* 图标：官网 left 3.75rem、垂直居中。官网默认 #d9d9d9 → hover #858585 → 当前 #191919；
   站主要求白底栏里图标与文字都用 #191919，所以这里只有一种颜色，hover/当前靠灰块区分。 */
.Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB .Header_icon__3iDIG {
  position: absolute;
  left: calc(3.75 * var(--efu));
  top: 50%;
  transform: translate3d(-50%, -50%, 0);
  height: auto;
  color: #191919;
  transition: color 0.2s;
  white-space: nowrap;
  display: block;
}
/* 每项图标宽度照官网 data-key 的尺寸表 */
.Header_pcHeaderContainer__Sy_8l [data-key="home"] .Header_icon__3iDIG {
  width: calc(2.5 * var(--efu));
}
.Header_pcHeaderContainer__Sy_8l [data-key="operator"] .Header_icon__3iDIG {
  width: calc(2.75 * var(--efu));
}
.Header_pcHeaderContainer__Sy_8l [data-key="lore"] .Header_icon__3iDIG {
  width: calc(2.625 * var(--efu));
}
.Header_pcHeaderContainer__Sy_8l [data-key="information"] .Header_icon__3iDIG {
  width: calc(2.6875 * var(--efu));
}
.Header_pcHeaderContainer__Sy_8l [data-key="calendar"] .Header_icon__3iDIG {
  width: calc(2.625 * var(--efu));
}
.Header_pcHeaderContainer__Sy_8l [data-key="gameplay"] .Header_icon__3iDIG,
.Header_pcHeaderContainer__Sy_8l [data-key="aicGameplay"] .Header_icon__3iDIG {
  width: calc(2.5625 * var(--efu));
}
.Header_pcHeaderContainer__Sy_8l [data-key="notice"] .Header_icon__3iDIG {
  width: calc(2.75 * var(--efu));
}

/* 文字：官网 left 6.9375rem、宽 13.25rem、SansMedium 1.125rem、收起时 opacity 0 */
.Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB .Header_textWrapper__o9aHt {
  position: absolute;
  width: calc(13.25 * var(--efu));
  left: calc(6.9375 * var(--efu));
  top: 50%;
  pointer-events: none;
  font-family: SansMedium, "EF Gilroy", system-ui, sans-serif;
  font-size: calc(1.125 * var(--efu));
  line-height: 1.25;
  opacity: 0;
  transform: translate3d(-1rem, -50%, 0);
  transition: opacity 0.2s, transform 0.3s;
  color: #191919;
  white-space: nowrap;
}
.Header_pcHeaderContainer__Sy_8l:hover
  .Header_navItem__c_fLB
  .Header_textWrapper__o9aHt,
.Header_pcHeaderContainer__Sy_8l:focus-within
  .Header_navItem__c_fLB
  .Header_textWrapper__o9aHt {
  opacity: 1;
  transform: translate3d(0, -50%, 0);
}

/* 分组细线（官网 divider：#d9d9d9 细线，收起时不可见） */
.Header_pcHeaderContainer__Sy_8l .Header_divider__tUYjO {
  position: relative;
  width: calc(2.5 * var(--efu));
  height: 1px;
  margin-inline: auto;
  background-color: #d9d9d9;
  transition: opacity 0.2s;
  opacity: 0;
}
.Header_pcHeaderContainer__Sy_8l:hover .Header_divider__tUYjO {
  opacity: 1;
}

/* ---------- 4. 竖排栏底部（官网 buttonFrame + buttonPreserveBg 原样照抄） ---------
  展开后从上到下：
    1) 浅灰大圆角胶囊：留言 / 订阅（官网 Header_buttonFrameBg + Header_buttonFrameContainer）
    2) 黑色竖条方块：白三角 + 细分隔线 + 竖排白字「全部文章」（官网 Header_buttonPreserveBg）
    3) 一排小圆角方块的社交图标（官网 Header_iconButton__KWPpn 的方块几何）
    4) 最底部一行很小的品牌标记

  尺寸全部照官网：
    · 胶囊 3.75rem 宽 / 圆角 1.875rem / 底色 #f2f2f2；
      官网按行数给高度：Header_ele2（两行）= 7.8125rem、Header_ele3（三行）= 11.5625rem，
      公式 = 行数 × 3.75rem + 0.3125rem；本站两行，取 7.8125rem；
      行高 3rem、首行距顶 .5rem、行间距 .75rem（官网内联 translateY 0.5 / 4.25rem）；
      图标 height 1.75rem、width auto、压 x=1.875rem（收起态胶囊正中）、垂直压行中线；
      行间细线 1px × 1.25rem、#ccc，同样压 x=1.875rem；
      文字 1.125rem / line-height 1，压 y=1.5rem；
    · 黑块 4.5rem × 9.75rem、圆角 4px、#191919；
    · 官网 showPreserveButton 变体里胶囊与黑块的间距是 2.4375rem（21.75 - 19.3125）。

  只按用户要求改了胶囊的横向尺寸（官网那套是整栏 hover 展开、按钮文字压在展开后
  19.5rem 胶囊的中线上；本站展宽只到 10.25u）：
    · 收起 4.5u —— 与黑块同宽、同左缘，图标仍压在胶囊正中（2.25u）；
    · 展开 10.25u —— 文字左缘落在 6.9375u，与导航项文字同一条竖线，滑入距离照官网留 2rem。 */

.ef-rail-bottom {
  position: absolute;
  left: calc(1.5 * var(--efu));
  bottom: calc(2.25 * var(--efu));
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* 胶囊：官网把背景单独挂在 .Header_buttonFrameBg 上（它的按钮是绝对定位的兄弟节点）；
  这边按钮走文档流，背景与尺寸合到容器这一层，几何一致。 */
.Header_buttonFrameContainer__Uvshp {
  position: relative;
  display: flex;
  flex-direction: column;
  padding-top: calc(0.5 * var(--efu));
  gap: calc(0.75 * var(--efu));
  width: calc(4.5 * var(--efu));
  height: calc(7.8125 * var(--efu));
  margin-bottom: calc(2.4375 * var(--efu));
  border-radius: calc(1.875 * var(--efu));
  background-color: #f2f2f2;
  overflow: hidden;
  transition: width 0.3s cubic-bezier(0.2, 0, 0, 1);
}
.Header_pcHeaderContainer__Sy_8l:hover .Header_buttonFrameContainer__Uvshp,
.Header_pcHeaderContainer__Sy_8l:focus-within .Header_buttonFrameContainer__Uvshp {
  width: calc(10.25 * var(--efu));
}

/* 行：官网 .Header_button 高 3rem，行内元素一律绝对定位 */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonFrameContainer__Uvshp
  .Header_button__b0gdu {
  position: relative;
  flex: 0 0 auto;
  display: block;
  height: calc(3 * var(--efu));
  color: inherit;
  text-decoration: none;
}
/* 行间细线：官网 .Header_divider 1px × 1.25rem、#ccc，压在图标中线上，
   左缘 = 1.875 - 0.625 = 1.25rem；官网用独立 div + 内联 translateY，
   这里挂在后一行的 ::before 上（离行顶 -.375rem = 半格行间距），几何一致。 */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonFrameContainer__Uvshp
  .Header_button__b0gdu
  + .Header_button__b0gdu::before {
  content: "";
  position: absolute;
  top: calc(-0.375 * var(--efu));
  left: calc(1.25 * var(--efu));
  width: calc(1.25 * var(--efu));
  height: 1px;
  background-color: #ccc;
}

/* 图标：官网 height:1.75rem / width:auto / left:1.875rem / top:1.5rem /
   translate3d(-50%,-50%,0)。left 取 2.25u —— 收起态 4.5u 胶囊的正中
   （官网的 1.875rem 同样是 3.75rem 胶囊的正中），展开时不会跟着胶囊中线漂移。 */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonFrameContainer__Uvshp
  .Header_button__b0gdu
  .Header_icon__3iDIG {
  position: absolute;
  left: calc(2.25 * var(--efu));
  top: calc(1.5 * var(--efu));
  transform: translate3d(-50%, -50%, 0);
  display: block;
  width: auto;
  height: calc(1.75 * var(--efu));
  color: #191919;
  transition: color 0.2s;
}
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonFrameContainer__Uvshp
  .Header_button__b0gdu:hover
  .Header_icon__3iDIG {
  color: #424242;
}

/* 文字：官网 left 10.1875rem / top 1.5rem / 1.125rem / line-height 1，
   隐藏态 translate3d(calc(-50% - 2rem),-50%,0) → 展开 translate3d(-50%,-50%,0)。
   这里改成左缘锚定 6.9375u（与导航文字同一条竖线），滑入方向与距离照官网。 */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonFrameContainer__Uvshp
  .Header_button__b0gdu
  .Header_textWrapper__o9aHt {
  position: absolute;
  left: calc(6.9375 * var(--efu));
  top: calc(1.5 * var(--efu));
  white-space: nowrap;
  pointer-events: none;
  font-family: SansMedium, system-ui, sans-serif;
  font-size: calc(1.125 * var(--efu));
  line-height: 1;
  color: #191919;
  opacity: 0;
  transform: translate3d(calc(-2 * var(--efu)), -50%, 0);
  transition: opacity 0.2s, transform 0.3s;
}
.Header_pcHeaderContainer__Sy_8l:hover
  .Header_buttonFrameContainer__Uvshp
  .Header_button__b0gdu
  .Header_textWrapper__o9aHt,
.Header_pcHeaderContainer__Sy_8l:focus-within
  .Header_buttonFrameContainer__Uvshp
  .Header_button__b0gdu
  .Header_textWrapper__o9aHt {
  opacity: 1;
  transform: translate3d(0, -50%, 0);
}

/* 官网 .Header_buttonPreserveBg：黑底 4.5rem × 9.75rem、圆角 4px */
.Header_pcHeaderContainer__Sy_8l .Header_buttonPreserveBg__rEZGT {
  position: relative;
  display: block;
  width: calc(4.5 * var(--efu));
  height: calc(9.75 * var(--efu));
  border-radius: calc(0.25 * var(--efu));
  overflow: hidden;
  cursor: pointer;
  background-color: #191919;
  text-decoration: none;
  /* .ef-rail-bottom 不设 gap，块与块的间距由各块自己给（官网那套是绝对定位） */
  margin-bottom: calc(1.75 * var(--efu));
}
/* 官网 hover：整块被 #fffa00 盖住（.Header_bg opacity 0 → 1） */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT
  .Header_bg___kVDv {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #fffa00;
  transition: opacity 0.2s;
  opacity: 0;
}
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT:hover
  .Header_bg___kVDv {
  opacity: 1;
}
/* 白色三角 logo：压在方块中线上 */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT
  .Header_tri__KNP87 {
  position: absolute;
  top: calc(1.25 * var(--efu));
  left: calc(2.25 * var(--efu));
  width: calc(1.9375 * var(--efu));
  height: calc(1.75 * var(--efu));
  color: #fff;
  transition: color 0.3s;
  transform: translate3d(-50%, 0, 0);
}
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT:hover
  .Header_tri__KNP87 {
  color: #191919;
}
/* 一条细分隔线（官网是 2px；用户要求细，收成 1px） */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT
  .Header_divider__tUYjO {
  position: absolute;
  top: calc(4.125 * var(--efu));
  left: calc(2.25 * var(--efu));
  width: calc(3 * var(--efu));
  height: 1px;
  margin: 0;
  background-color: rgba(255, 255, 255, 0.3);
  transition: background-color 0.3s;
  transform: translate3d(-50%, 0, 0);
  pointer-events: none;
  opacity: 1;
}
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT:hover
  .Header_divider__tUYjO {
  background-color: #191919;
}
/* 竖排白字「全部文章」：官网竖排变体用 writing-mode:vertical-rl */
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT
  .Header_text__52fEh {
  position: absolute;
  top: calc(4.375 * var(--efu));
  left: calc(2.25 * var(--efu));
  /* 4 个字一列：高度按 4 × (1 + 字距) 留足，否则会被挤成两列 */
  height: calc(5.25 * var(--efu));
  transform: translate3d(-50%, 0, 0);
  writing-mode: vertical-rl;
  text-orientation: mixed;
  font-family: SansMedium, system-ui, sans-serif;
  font-size: calc(1.125 * var(--efu));
  line-height: 1;
  letter-spacing: 0.04em;
  text-align: center;
  color: #fff;
  transition: color 0.3s;
}
.Header_pcHeaderContainer__Sy_8l
  .Header_buttonPreserveBg__rEZGT:hover
  .Header_text__52fEh {
  color: #191919;
}

/* 一排小圆角方块的社交图标。
   方块几何照官网 .Header_iconButton__KWPpn（正方形 + .25rem 圆角 + #f2f2f2 底），
   字形照官网 .Header_mediaItem__mUuKL / .Header_icon__3iDIG：单色实心、颜色走 color、
   path 用 fill="currentColor"、不加 stroke。
   本站竖排栏收起只有 7.5u 宽，所以这一排改成 4 个 1.5u 方块铺满栏面（左右各留 .375u）；
   这排比上面的胶囊/黑块（4.5u）宽，往左回拉 1.125u，让整排仍以栏轴 3.75u 居中。 */
.ef-rail-social {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(6.75 * var(--efu));
  margin-left: calc(-1.125 * var(--efu));
  margin-bottom: calc(1.25 * var(--efu));
}
.ef-rail-social .Header_iconButton__KWPpn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(1.5 * var(--efu));
  height: calc(1.5 * var(--efu));
  border-radius: calc(0.25 * var(--efu));
  background-color: #f2f2f2;
  text-decoration: none;
  transition: background-color 0.2s;
}
.ef-rail-social .Header_iconButton__KWPpn:hover {
  background-color: #e5e5e5;
}
.ef-rail-social .Header_iconButton__KWPpn .Header_icon__3iDIG {
  display: block;
  width: auto;
  height: calc(1 * var(--efu));
  color: #7c7c7c;
  transition: color 0.2s;
}
.ef-rail-social .Header_iconButton__KWPpn:hover .Header_icon__3iDIG {
  color: #424242;
}

/* 最底部一行很小的品牌标记（官网那行是 Arknights: Endfield 的小 logo + 版本号）。
   宽度锁到 4.5u 并居中，让它和黑块压在同一条中线上。 */
.ef-rail-mark {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: calc(0.125 * var(--efu));
  width: calc(4.5 * var(--efu));
  margin: 0;
  text-align: center;
}
.ef-rail-mark-brand {
  font-family: Novecentosanswide-Bold, SansBold, sans-serif;
  font-size: calc(0.625 * var(--efu));
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #191919;
}
.ef-rail-mark-ver {
  font-family: SansMedium, system-ui, sans-serif;
  font-size: calc(0.5 * var(--efu));
  line-height: 1;
  letter-spacing: 0.06em;
  color: #999;
  white-space: nowrap;
}

/* ---------- 5. 内容页排版（官网 SectionTitle 量级） --------------------- */

.ef-sec {
  padding-block: calc(4.5 * var(--efu));
  border-top: 1px solid var(--ef-rule);
}
.ef-sec:first-child {
  border-top: 0;
  padding-top: calc(3.5 * var(--efu));
}

.ef-sec-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: calc(0.75 * var(--efu)) calc(1.5 * var(--efu));
  padding-bottom: calc(1.25 * var(--efu));
  margin-bottom: calc(2.5 * var(--efu));
  border-bottom: 1px solid var(--ef-rule);
}
.ef-sec-title,
.ef-page-name {
  margin: 0;
  font-family: SansBold, Novecentosanswide-Bold, system-ui, sans-serif;
  font-size: calc(3.4 * var(--efu));
  line-height: 1;
  letter-spacing: -0.01em;
  color: var(--ef-ink);
}
.ef-sec-count {
  margin-inline-start: auto;
  font-family: SansMedium, system-ui, sans-serif;
  font-size: calc(1.25 * var(--efu));
  color: var(--ef-ink-2);
  font-variant-numeric: tabular-nums;
}

/* 眉标：官网英文标签一律 Gilroy 大写、字距 .14em */
.ef-eyebrow {
  margin: 0;
  font-family: SansMedium, "EF Gilroy", system-ui, sans-serif;
  font-size: calc(1.1 * var(--efu));
  font-weight: 400;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ef-ink-2);
  line-height: 1.2;
}

/* ---------- 6. 卡片（官网 #f2f2f2 面 + 4px 圆角 + 黄块） ---------------- */

.ef-grid {
  display: grid;
  gap: calc(1.25 * var(--efu));
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.ef-grid-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
@media (max-width: 1100px) {
  .ef-grid,
  .ef-grid-3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 720px) {
  .ef-grid,
  .ef-grid-2,
  .ef-grid-3 {
    grid-template-columns: 1fr;
  }
}

.ef-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: calc(0.85 * var(--efu));
  padding: calc(2 * var(--efu));
  background: var(--ef-panel);
  border: 1px solid var(--ef-rule);
  border-radius: calc(0.25 * var(--efu));
  overflow: hidden;
  transition: border-color 0.2s, background-color 0.2s;
}
.ef-card:hover {
  border-color: var(--ef-ink);
}
/* 官网 hover 强调：左侧竖条黄块（.Header_bg 同款做法） */
.ef-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: calc(0.375 * var(--efu));
  background: var(--ef-signal);
  transform: scaleY(0);
  transform-origin: top;
  transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1);
}
.ef-card:hover::before {
  transform: scaleY(1);
}
/* 标题是唯一的链接，::after 把可点区域铺满整张卡（标签链接再压在它上面） */
.ef-card-link {
  color: inherit;
  text-decoration: none;
}
.ef-card-link::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
}
.ef-card-tags,
.ef-card-arrow {
  position: relative;
  z-index: 2;
}
.ef-card-meta {
  display: flex;
  align-items: center;
  gap: calc(1 * var(--efu));
  margin: 0;
  font-family: SansMedium, "EF Gilroy", system-ui, sans-serif;
  font-size: calc(1.05 * var(--efu));
  letter-spacing: 0.08em;
  color: var(--ef-ink-2);
  font-variant-numeric: tabular-nums;
}
.ef-card-cat {
  padding: calc(0.15 * var(--efu)) calc(0.6 * var(--efu));
  background: var(--ef-ink);
  color: var(--ef-panel);
  border-radius: 2px;
  letter-spacing: 0.04em;
}
.ef-card-title {
  margin: 0;
  font-family: SansBold, Novecentosanswide-Bold, system-ui, sans-serif;
  font-size: calc(1.65 * var(--efu));
  line-height: 1.35;
  color: var(--ef-ink);
  transition: color 0.2s;
}
.ef-card-desc {
  margin: 0;
  color: var(--ef-ink-2);
  font-size: calc(1.3 * var(--efu));
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ef-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: calc(0.4 * var(--efu));
  margin: auto 0 0;
  padding: calc(0.5 * var(--efu)) 0 0;
  list-style: none;
}
.ef-card-tags li {
  padding: 0;
}
.ef-card-tags a {
  color: var(--ef-ink-2);
  text-decoration: none;
  font-size: calc(1.05 * var(--efu));
}
.ef-card-tags a:hover {
  color: var(--ef-ink);
}
/* 右下角箭头：官网卡片的指示符 */
.ef-card-arrow {
  align-self: flex-end;
  margin-top: calc(0.5 * var(--efu));
  font-family: SansMedium, sans-serif;
  font-size: calc(1.5 * var(--efu));
  line-height: 1;
  color: var(--ef-ink-2);
  transition: transform 0.25s, color 0.2s;
}
.ef-card:hover .ef-card-arrow {
  transform: translate3d(calc(0.4 * var(--efu)), 0, 0);
  color: var(--ef-ink);
}

/* ---------- 7. 分页与页脚 ------------------------------------------------- */

.ef-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(1.5 * var(--efu));
  padding-block: calc(3 * var(--efu));
}
.ef-pager a,
.ef-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: calc(3.5 * var(--efu));
  padding: 0 calc(1.75 * var(--efu));
  border: 0;
  border-radius: calc(0.25 * var(--efu));
  background: var(--ef-ink);
  color: var(--ef-panel);
  font-family: SansMedium, system-ui, sans-serif;
  font-size: calc(1.2 * var(--efu));
  letter-spacing: 0.04em;
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.2s, color 0.2s;
}
.ef-pager a:hover,
.ef-btn:hover {
  background: var(--ef-signal);
  color: #191919;
}

.ef-foot {
  border-top: 1px solid var(--ef-rule);
  margin-top: auto;
  padding-block: calc(3 * var(--efu));
}
.ef-foot-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: calc(0.75 * var(--efu)) calc(2 * var(--efu));
  font-size: calc(1.15 * var(--efu));
  color: var(--ef-ink-2);
}
.ef-foot-mark {
  margin: 0;
  font-family: Novecentosanswide-Bold, SansBold, sans-serif;
  font-size: calc(1.35 * var(--efu));
  letter-spacing: 0.06em;
  color: var(--ef-ink);
  text-transform: uppercase;
}
.ef-foot-mark span {
  margin-inline-start: calc(0.5 * var(--efu));
  color: var(--ef-signal);
}
.ef-foot-links {
  display: flex;
  flex-wrap: wrap;
  gap: calc(1.5 * var(--efu));
  margin: 0;
  padding: 0;
  list-style: none;
}
.ef-foot-links a {
  color: var(--ef-ink-2);
  text-decoration: none;
}
.ef-foot-links a:hover {
  color: var(--ef-ink);
}
.ef-foot-meta {
  margin: 0;
  margin-inline-start: auto;
  font-variant-numeric: tabular-nums;
}

/* ---------- 8. 窄屏 ------------------------------------------------------
   官网在移动端换成 H5 顶栏；这里保留同一条竖排栏，收到图标列（不展开），
   内容让出固定宽度，永远不会横向溢出。 */

@media (max-width: 860px) {
  .ef-shell {
    --ef-rail-w: 3.5rem;
    --efu: 9px;
  }
  .Header_pcHeaderContainer__Sy_8l {
    width: 3.5rem;
  }
  .Header_pcHeaderContainer__Sy_8l:hover,
  .Header_pcHeaderContainer__Sy_8l:focus-within {
    width: 3.5rem;
  }
  .Header_logo__s3lE_ {
    top: 0.9rem;
    width: 2.9rem;
  }
  .ef-rail-wordmark {
    font-size: 0.62rem;
  }
  .ef-rail-wordmark-en {
    display: none;
  }
  .Header_navList__r2BGN {
    top: 4.6rem;
    gap: 0.25rem;
  }
  .Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB {
    height: 3rem;
  }
  .Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB::before {
    left: 0.35rem;
    width: 2.8rem;
  }
  /* 当前项那条 overlay：窄屏栏宽只有 3.5rem，不能再用 21rem 的展开宽度 */
  .Header_pcHeaderContainer__Sy_8l
    .Header_navItem__c_fLB.Header_active__jzCyf::after {
    width: 100%;
    height: calc(100% + 0.5rem);
  }
  .Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB .Header_icon__3iDIG,
  .Header_pcHeaderContainer__Sy_8l [data-key] .Header_icon__3iDIG {
    left: 50%;
    width: 1.5rem;
  }
  .Header_textWrapper__o9aHt,
  .ef-rail-bottom .Header_divider__tUYjO {
    display: none;
  }
  .Header_pcHeaderContainer__Sy_8l .Header_buttonFrameContainer__Uvshp {
    padding-top: 0.375rem;
    gap: 0.5rem;
    width: 2.75rem;
    height: 6.5rem;
    margin-bottom: 1rem;
    border-radius: 1.375rem;
  }
  .Header_pcHeaderContainer__Sy_8l
    .Header_buttonFrameContainer__Uvshp
    .Header_button__b0gdu {
    height: 2.75rem;
  }
  .Header_pcHeaderContainer__Sy_8l
    .Header_buttonFrameContainer__Uvshp
    .Header_button__b0gdu
    + .Header_button__b0gdu::before {
    top: -0.25rem;
    left: 0.75rem;
    width: 1.25rem;
  }
  .Header_pcHeaderContainer__Sy_8l
    .Header_buttonFrameContainer__Uvshp
    .Header_button__b0gdu
    .Header_icon__3iDIG {
    left: 1.375rem;
    top: 1.375rem;
    width: auto;
    height: 1.5rem;
  }
  .Header_pcHeaderContainer__Sy_8l .Header_buttonPreserveBg__rEZGT {
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.75rem;
    border-radius: 0.25rem;
  }
  .Header_pcHeaderContainer__Sy_8l
    .Header_buttonPreserveBg__rEZGT
    .Header_text__52fEh,
  .Header_pcHeaderContainer__Sy_8l
    .Header_buttonPreserveBg__rEZGT
    .Header_divider__tUYjO {
    display: none;
  }
  .Header_pcHeaderContainer__Sy_8l
    .Header_buttonPreserveBg__rEZGT
    .Header_tri__KNP87 {
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    width: 1.4rem;
    height: auto;
  }
  .ef-rail-bottom {
    left: 0.375rem;
    bottom: 1.1rem;
  }
  /* 窄屏栏宽 3.5rem：社交方块改 2 × 2，品牌标记跟着黑块收窄 */
  .ef-rail-social {
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.2rem;
    width: 1.6rem;
    margin-left: 0;
    margin-bottom: 0.6rem;
  }
  .ef-rail-social .Header_iconButton__KWPpn {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 0.125rem;
  }
  .ef-rail-social .Header_iconButton__KWPpn .Header_icon__3iDIG {
    height: 0.45rem;
  }
  .ef-rail-mark {
    width: 2.75rem;
  }
  .ef-rail-mark-brand {
    font-size: 0.5rem;
    letter-spacing: 0.06em;
  }
  .ef-rail-mark-ver {
    font-size: 0.42rem;
    letter-spacing: 0.02em;
  }
  .ef-wrap {
    padding-inline: 1.1rem;
  }
  .ef-sec-title,
  .ef-page-name {
    font-size: 2rem;
  }
}

/* ---------- 9. 模板遗留件的浅色统一 ------------------------------------- */

/* 内页里模板遗留的卡片（.card-base）：统一成官网白面 + 4px 圆角，
   普通权重即可，不需要 !important。 */
.ef-shell .card-base {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  box-shadow: none;
  color: #191919;
}
.ef-shell .card-base h1,
.ef-shell .card-base h2,
.ef-shell .card-base h3,
.ef-shell .card-base a {
  color: #191919;
}

/* 正文链接：官网是黑字 + 黄下划线 */
.ef-shell .custom-md a {
  color: #191919;
  text-decoration-color: var(--ef-signal);
  text-decoration-thickness: 2px;
}

/* 悬停展开时，当前项背景条才铺到官网的 21u；收起态保持栏宽，避免灰条伸出栏外。 */
.Header_pcHeaderContainer__Sy_8l:hover .Header_navItem__c_fLB.Header_active__jzCyf::after,
.Header_pcHeaderContainer__Sy_8l:focus-within .Header_navItem__c_fLB.Header_active__jzCyf::after {
  width: calc(21 * var(--efu));
}
/* 图标与文字确保在背景条之上（背景条 z-index:-1） */
.Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB > * { position: relative; z-index: 1; }
.Header_pcHeaderContainer__Sy_8l .Header_navItem__c_fLB::before { z-index: 1; }
